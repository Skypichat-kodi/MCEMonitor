<Window x:Class="SystemMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="SystemMonitor"
        Height="900"
        Width="1300"
        MinHeight="600"
        MinWidth="900">

    <Window.Resources>

        <!-- Couleurs Windows 11 Dark -->
        <SolidColorBrush x:Key="Win11Background" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Win11Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Win11Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Win11Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#553A8DFF"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5E5"/>
        </Style>

        <!-- Style des cartes -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Style des barres de progression -->
        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"
                                           RadiusX="6"
                                           RadiusY="6"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Barre titre -->
            <RowDefinition Height="Auto"/>   <!-- Serveur Web -->
            <RowDefinition Height="Auto"/>   <!-- Boutons -->
            <RowDefinition Height="Auto"/>   <!-- Cartes CPU + RAM -->
            <RowDefinition Height="Auto"/>   <!-- Titre GPU -->
            <RowDefinition Height="2*"/>     <!-- Tableau GPU -->
            <RowDefinition Height="Auto"/>   <!-- Titre Réseau -->
            <RowDefinition Height="*"/>      <!-- Tableau Réseau -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <Rectangle Fill="#1E1E1E" Grid.RowSpan="9"/>

        <!-- BARRE TITRE -->
        <TextBlock Grid.Row="0"
                   Text="SystemMonitor"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#4CC2FF"
                   Margin="15,12,0,8"/>

        <!-- SERVEUR WEB -->
        <GroupBox Grid.Row="1"
                  Margin="15,0,15,10"
                  Padding="10"
                  Header="{loc:Tr 'Serveur Web'}"
                  Background="{StaticResource PanelBackground}"
                  BorderBrush="{StaticResource Win11Border}"
                  Foreground="{StaticResource Win11Text}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr 'Activer le serveur Web'}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ToggleButton x:Name="ToggleWeb"
                                      Width="40" Height="20"
                                      Checked="ToggleWeb_Checked"
                                      Unchecked="ToggleWeb_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="40" Height="20">
                                                    <Border x:Name="SwitchBackground"
                                                            CornerRadius="10" Background="#3C3C3C"/>
                                                    <Ellipse x:Name="SwitchThumb"
                                                             Width="16" Height="16"
                                                             Margin="2" Fill="#E5E5E5"
                                                             HorizontalAlignment="Left"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="SwitchBackground" Property="Background" Value="#4CC2FF"/>
                                                        <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr 'Port :'}" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebPort" Width="200"
                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr 'Login :'}" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebLogin" Width="200"
                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="177"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{loc:Tr 'Mot de passe :'}" Grid.Column="0" VerticalAlignment="Center"/>

                        <PasswordBox x:Name="txtWebPassword" Grid.Column="1" Width="177"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Visible"/>

                        <TextBox x:Name="txtWebPasswordVisible" Grid.Column="1" Width="177"
                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Collapsed"/>

                        <Button x:Name="btnShowWebPassword" Grid.Column="2"
                                Width="22" Height="22" Margin="6,0,0,0" Padding="0"
                                Click="btnShowWebPassword_Click"
                                Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock x:Name="imgWebEye" Text="👁" FontSize="12"/>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="{loc:Tr 'Appliquer'}"
                            Width="150" Height="28" Margin="0,0,0,8"
                            Padding="0" VerticalContentAlignment="Center"
                            Click="btnApplyWeb_Click"/>

                    <Button Content="{loc:Tr 'Ouvrir dans le navigateur'}"
                            Width="220" Height="28"
                            Padding="0" VerticalContentAlignment="Center"
                            Click="btnOpenWeb_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- BOUTONS -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15,0,15,10">
            <Button Width="140" Margin="0,0,10,0" Click="Refresh_Click">
                <TextBlock Text="{loc:Tr 'Rafraîchir'}"/>
            </Button>
            <Button Width="140" Margin="0,0,10,0" Click="OpenLogs_Click">
                <TextBlock Text="{loc:Tr 'Dossier Logs'}"/>
            </Button>
        </StackPanel>

        <!-- CARTES CPU + RAM -->
        <Grid Grid.Row="3" Margin="15,0,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CARTE CPU -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Processeur'}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#4CC2FF"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtCpuName"
                               FontSize="12"
                               Foreground="#ccc"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <!-- Utilisation CPU -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Utilisation'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtCpuUsage" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="0 %"/>
                    </Grid>
                    <ProgressBar x:Name="barCpuUsage" Style="{StaticResource ProgressBarStyle}" Value="0" Maximum="100" Margin="0,0,0,12"/>

                    <!-- Température -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Température'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtCpuTemp" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="N/A"/>
                    </Grid>

                    <!-- Fréquence -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Fréquence'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtCpuFreq" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="N/A"/>
                    </Grid>

                    <!-- Fréquence max -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Fréquence max'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtCpuMaxFreq" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="N/A"/>
                    </Grid>

                    <!-- Cœurs -->
                    <TextBlock Text="{loc:Tr 'Cœurs'}"
                               FontSize="12"
                               Foreground="#888"
                               Margin="0,8,0,6"/>
                    <ItemsControl x:Name="coresList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- CARTE RAM -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Tr 'Mémoire'}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#4CC2FF"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="" FontSize="12" Foreground="#ccc" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Utilisation'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtRamUsage" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="0 %"/>
                    </Grid>
                    <ProgressBar x:Name="barRamUsage" Style="{StaticResource ProgressBarStyle}" Value="0" Maximum="100" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Utilisée'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtRamUsed" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="0 Go"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Libre'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtRamFree" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="0 Go"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Tr 'Totale'}" Foreground="#aaa" FontSize="13"/>
                        <TextBlock x:Name="txtRamTotal" Grid.Column="1" FontWeight="Bold" FontSize="14" Text="0 Go"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TITRE GPU -->
        <TextBlock Grid.Row="4"
                   Text="{loc:Tr 'Cartes graphiques'}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#4CC2FF"
                   Margin="15,10,0,5"/>

        <!-- TABLEAU GPU -->
        <DataGrid x:Name="GpusGrid"
                  Grid.Row="5"
                  Margin="15,0,15,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr 'Modèle'}" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="{loc:Tr 'Utilisation'}" Binding="{Binding UsageText}" Width="*"/>
                <DataGridTextColumn Header="{loc:Tr 'Temp.'}" Binding="{Binding TempText}" Width="*"/>
                <DataGridTextColumn Header="{loc:Tr 'VRAM'}" Binding="{Binding VramText}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- TITRE RÉSEAU -->
        <TextBlock Grid.Row="6"
                   Text="{loc:Tr 'Réseau'}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#4CC2FF"
                   Margin="15,10,0,5"/>

        <!-- TABLEAU RÉSEAU -->
        <DataGrid x:Name="NetworksGrid"
                  Grid.Row="7"
                  Margin="15,0,15,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Tr 'Interface'}" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="{loc:Tr 'Descendant'}" Binding="{Binding DownloadText}" Width="*"/>
                <DataGridTextColumn Header="{loc:Tr 'Montant'}" Binding="{Binding UploadText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- STATUS BAR -->
        <Border Grid.Row="8"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="15,6">
            <TextBlock x:Name="StatusText"
                       Text="..."
                       FontSize="12"
                       Foreground="#B4B4B4"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>