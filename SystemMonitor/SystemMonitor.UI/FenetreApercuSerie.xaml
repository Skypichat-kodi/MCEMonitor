<Window x:Class="SystemMonitor.UI.FenetreApercuSerie"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Détail de la surcharge'}"
        Width="588"
        Height="368"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="#E5E5E5"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!--
      Aperçu de la courbe enregistrée avec une entrée d'historique.

      Le graphique principal est glissant : au moment où le processus entre dans
      l'historique, sa courbe n'y est déjà plus. Le service recopie donc les points
      dans l'entrée, et cette fenêtre les redessine à la demande.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Fond"            Color="#FF1B1B1B" />
        <SolidColorBrush x:Key="Surface"         Color="#FF252526" />
        <SolidColorBrush x:Key="Bordure"         Color="#FF3C3C3C" />
        <SolidColorBrush x:Key="Texte"           Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="TexteSecondaire" Color="#FFB4B4B4" />
        <SolidColorBrush x:Key="Accent"          Color="#FF4CC2FF" />

        <Style x:Key="Bouton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="#FF2E2E31" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock x:Name="TexteTitre"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               TextTrimming="CharacterEllipsis"
                               Text="" />

                    <Button Content="✕"
                            Style="{StaticResource Bouton}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{StaticResource TexteSecondaire}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Résumé -->
            <TextBlock Grid.Row="1"
                       x:Name="TexteResume"
                       Margin="20,12,20,8"
                       FontSize="12"
                       Foreground="{StaticResource TexteSecondaire}"
                       Text="" />

            <!-- Courbe -->
            <Border Grid.Row="2"
                    Margin="20,0,20,10"
                    Background="#1A1A1A"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Canvas x:Name="ZoneCourbe"
                        ClipToBounds="True"
                        SizeChanged="ZoneCourbe_SizeChanged">
                    <Line X1="0" Y1="0" X2="0" Y2="0" Stroke="#2D2D30" StrokeThickness="1" Tag="Grid50" />
                    <Polyline x:Name="Courbe"
                              Stroke="{StaticResource Accent}"
                              StrokeThickness="2"
                              Fill="Transparent" />
                </Canvas>
            </Border>

            <!-- Pied -->
            <Border Grid.Row="3"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Button Content="{loc:Tr 'Fermer'}"
                        Style="{StaticResource Bouton}"
                        Width="110" Height="30"
                        HorizontalAlignment="Right"
                        Margin="18,10,18,10"
                        Click="SurFermer" />
            </Border>
        </Grid>
    </Border>
</Window>
