<Window x:Class="MediaMonitor.UI.InfoPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Informations sur le fichier'}"
        Width="540"
        SizeToContent="Height"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}"
        ResizeMode="NoResize"
        WindowStyle="None">

    <!-- Barre de titre personnalisée : ce dialogue n'a pas d'en-tête, on en ajoute
         un (titre + Fermer). ResizeMode reste NoResize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Même style de bouton implicite que les MainWindow. Sans lui, les boutons
             utilisaient le rendu WPF par défaut (gris système). -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="3"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceSurvol}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource SelectionFond}"/>
                                <Setter Property="Foreground" Value="{StaticResource SelectionTexte}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ombre -->
        <DropShadowEffect x:Key="DropShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.6"/>

        <!-- Animation d'apparition de la vignette -->
        <Storyboard x:Key="ThumbAppearAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25"
                             FillBehavior="HoldEnd"/>

            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1.0"
                             Duration="0:0:0.25"/>

            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1.0"
                             Duration="0:0:0.25"/>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Le titre est lié à Window.Title : une seule source de vérité. -->
        <Grid Grid.Row="0" Background="Transparent" Margin="10,6,8,0"
              MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="12" Foreground="{StaticResource TexteSecondaire}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="1" Content="✕" Width="28" Height="24" Padding="0"
                    Click="TitleBarClose_Click" ToolTip="{loc:Tr 'Fermer'}"/>
        </Grid>

    <Grid Grid.Row="1">
        <Grid.Background>
            <ImageBrush ImageSource="Resources/Images/popup-background.png"
                        Stretch="Fill"
                        Opacity="{StaticResource FondImageOpacite}"/>
        </Grid.Background>

        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titre + icône -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Icône -->
                <Border Width="40" Height="40"
                        Background="{StaticResource Accent}"
                        CornerRadius="8"
                        Margin="0,0,12,0"
                        Opacity="0.9">
                    <Image x:Name="IconType"
                           Width="24" Height="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Zone de défilement -->
                <Grid x:Name="TitleScrollContainer"
                      Width="400" Height="30"
                      ClipToBounds="True">

                    <TextBlock x:Name="TitleText"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleScrollTransform" X="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                </Grid>

            </StackPanel>

            <!-- Miniature vidéo / audio -->
            <Grid Grid.Row="2"
                  HorizontalAlignment="Left"
                  Margin="0,10,0,10">

                <Border x:Name="AlbumArtBorder"
                        Width="260" Height="146"
                        Background="{StaticResource SurfaceEntete}"
                        CornerRadius="10"
                        ClipToBounds="True"
                        BorderBrush="{StaticResource Accent}"
                        BorderThickness="2"
                        SnapsToDevicePixels="True"
                        Effect="{DynamicResource DropShadow}"
                        Opacity="0">

                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Image x:Name="AlbumArtImage"
                               Stretch="UniformToFill"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Loaded="AlbumArtImage_Loaded"/>

                        <!-- Overlay Play -->
                        <Border x:Name="VideoOverlay"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="60" Height="60"
                                Background="#80000000"
                                CornerRadius="30">
                            <TextBlock Text="▶"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </Border>
                    </Grid>

                </Border>
            </Grid>

            <!-- Infos -->
            <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,10,0,0">

                <TextBlock x:Name="PathLabel" Text="{loc:Tr 'Chemin :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="PathText" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <TextBlock x:Name="TypeLabel" Text="{loc:Tr 'Type :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="TypeText" Margin="0,0,0,10"/>

                <TextBlock x:Name="SizeLabel" Text="{loc:Tr 'Taille :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="SizeText" Margin="0,0,0,10"/>

                <TextBlock x:Name="DurationLabel" Text="{loc:Tr 'Durée :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="DurationText" Margin="0,0,0,10"/>

                <!-- Bloc vidéo -->
                <TextBlock x:Name="SeriesLabel" Text="{loc:Tr 'Série :'}" FontWeight="Bold" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="SeriesText" Margin="0,0,0,10" Visibility="Collapsed"/>

                <TextBlock x:Name="SeasonEpisodeLabel" Text="{loc:Tr 'Saison / Épisode :'}" FontWeight="Bold" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="SeasonEpisodeText" Margin="0,0,0,10" Visibility="Collapsed"/>

                <TextBlock x:Name="EpisodeLabel" Text="{loc:Tr 'Titre :'}" FontWeight="Bold" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="EpisodeText" Margin="0,0,0,10" Visibility="Collapsed"/>

                <TextBlock x:Name="VideoCodecLabel" Text="{loc:Tr 'Codec vidéo :'}" FontWeight="Bold" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="VideoCodecText" Margin="0,0,0,10" Visibility="Collapsed"/>

                <TextBlock x:Name="AudioCodecLabel" Text="{loc:Tr 'Codec audio :'}" FontWeight="Bold" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                <TextBlock x:Name="AudioCodecText" Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Bloc audio -->
                <TextBlock x:Name="Id3TitleLabel" Text="{loc:Tr 'Titre :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Title" Margin="0,0,0,10"/>

                <TextBlock x:Name="Id3ArtistLabel" Text="{loc:Tr 'Artiste :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Artist" Margin="0,0,0,10"/>

                <TextBlock x:Name="Id3AlbumLabel" Text="{loc:Tr 'Album :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Album" Margin="0,0,0,10"/>

                <TextBlock x:Name="Id3YearLabel" Text="{loc:Tr 'Année :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Year" Margin="0,0,0,10"/>

                <TextBlock x:Name="Id3TrackLabel" Text="{loc:Tr 'Piste :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Track" Margin="0,0,0,10"/>

                <TextBlock x:Name="Id3GenreLabel" Text="{loc:Tr 'Genre :'}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock x:Name="Id3Genre" Margin="0,0,0,10"/>

            </StackPanel>
        </Grid>

    </Grid>
    </Grid>
</Window>

