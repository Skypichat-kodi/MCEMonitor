<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair de MediaMonitor.UI, dans l'esprit de Windows 11.
         Mêmes clés que Sombre.xaml. Les couleurs de catégories de médias n'y
         figurent pas : elles restent identiques dans les deux thèmes. -->
    <SolidColorBrush x:Key="Fond"            Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Surface"         Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="EnteteTableau" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="SurfaceEntete"   Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SurfaceSurvol"   Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="SurfaceActive"   Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Bordure"         Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="Texte"           Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TexteSecondaire" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="TexteTernaire"   Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="BoutonVioletFond" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BoutonVioletBordure" Color="#FF5231A0" />
    <SolidColorBrush x:Key="BoutonVioletTexte" Color="#FF4B2A7A" />
    <SolidColorBrush x:Key="BoutonRougeFond" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BoutonRougeBordure" Color="#FFB25A4F" />
    <SolidColorBrush x:Key="BoutonRougeTexte" Color="#FF9E3D33" />
    <SolidColorBrush x:Key="FondInfo" Color="#FFE4E4E4" />
    <SolidColorBrush x:Key="Accent"          Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="AccentBascule"   Color="#FF7EB6E8" />
    <SolidColorBrush x:Key="PanelBackground" Color="#333A8DFF" />

    <!-- Survol des boutons d action et trait des tableaux -->
    <SolidColorBrush x:Key="BoutonVioletSurvol" Color="#FFF0EAFB" />
    <SolidColorBrush x:Key="BoutonRougeSurvol" Color="#FFF3DBD7" />
    <SolidColorBrush x:Key="TraitTableau" Color="#FFEFEFEF" />
</ResourceDictionary>
