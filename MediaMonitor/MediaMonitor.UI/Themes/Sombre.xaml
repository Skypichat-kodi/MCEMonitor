<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Thème sombre de MediaMonitor.UI.
         Les valeurs reprennent exactement celles qui étaient codées en dur dans
         MainWindow.xaml : le rendu est identique à l'ancienne version.

         Les couleurs de catégories de médias (jaune, rouge, violet, vert…) ne
         figurent pas ici : ce sont des repères d'identification, ils restent
         identiques dans les deux thèmes. -->
    <SolidColorBrush x:Key="Fond"            Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Surface"         Color="#FF252526" />
    <SolidColorBrush x:Key="EnteteTableau" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="SurfaceEntete"   Color="#FF2D2D30" />
    <SolidColorBrush x:Key="SurfaceSurvol"   Color="#FF3A3A3D" />
    <SolidColorBrush x:Key="SurfaceActive"   Color="#FF4A4A4D" />
    <SolidColorBrush x:Key="Bordure"         Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="Texte"           Color="#FFE5E5E5" />
    <SolidColorBrush x:Key="TexteSecondaire" Color="#FFB4B4B4" />
    <SolidColorBrush x:Key="TexteTernaire"   Color="#FF5A5A5E" />
    <SolidColorBrush x:Key="BoutonVioletFond" Color="#FF7B4FE0" />
    <SolidColorBrush x:Key="BoutonVioletBordure" Color="#FF5231A0" />
    <SolidColorBrush x:Key="BoutonVioletTexte" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BoutonRougeFond" Color="#FFCC3300" />
    <SolidColorBrush x:Key="BoutonRougeBordure" Color="#FF8B1A00" />
    <SolidColorBrush x:Key="BoutonRougeTexte" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FondInfo" Color="#FF333333" />
    <SolidColorBrush x:Key="Accent"          Color="#FF4CC2FF" />

    <!-- Survol du bouton commun : blanc casse plutot que bleu. -->
    <SolidColorBrush x:Key="SurvolBoutonBordure" Color="#FF909090" />
    <SolidColorBrush x:Key="AccentBascule"   Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="PanelBackground" Color="#553A8DFF" />

    <!-- Survol des boutons d action et trait des tableaux -->
    <SolidColorBrush x:Key="BoutonVioletSurvol" Color="#FF8B5FF0" />
    <SolidColorBrush x:Key="BoutonRougeSurvol" Color="#FFE64D1A" />
    <SolidColorBrush x:Key="TraitTableau" Color="#FF3C3C3C" />

    <!-- Selection des lignes et des listes : en sombre, l accent clair sur
         fond sombre reste lisible, on garde la teinte d origine. -->
    <SolidColorBrush x:Key="SelectionFond" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="SelectionTexte" Color="#FF000000" />

    <!-- Opacite de l image de fond des popups. -->
    <sys:Double x:Key="FondImageOpacite">0.3</sys:Double>
</ResourceDictionary>
