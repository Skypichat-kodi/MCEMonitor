<Window x:Class="MediaMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaMonitor"
        Height="750"
        Width="1200">

    <!-- 🔥 RESSOURCES EN PREMIER (obligatoire) -->
    <Window.Resources>

        <!-- Couleurs Windows 11 Dark -->
        <SolidColorBrush x:Key="Win11Background" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Win11Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Win11Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Win11Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="WebPanelBackground" Color="#553A8DFF"/>


        <!-- Style des en-têtes de colonnes -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Style des cellules -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style des lignes -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollBars sombres -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#3C3C3C"/>
        </Style>

        <!-- Style des boutons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style DataGrid Windows 11 Dark -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5E5"/>
        </Style>
        
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Carré noir -->
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Background="Black"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"/>

                            <!-- Coche blanche -->
                            <Path x:Name="CheckMark"
                                  Grid.Column="0"
                                  Data="M 3 8 L 7 12 L 13 4"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"/>

                            <!-- Texte -->
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Margin="6,0,0,0"/>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <!-- Cochée -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>       

    </Window.Resources>

    <Grid Background="{StaticResource Win11Background}">
<Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>   <!-- 0 : Boutons -->
    <RowDefinition Height="Auto"/>   <!-- 1 : Serveur Web -->
    <RowDefinition Height="Auto"/>   <!-- 2 : Serveur TV -->
    <RowDefinition Height="2*"/>     <!-- 3 : Tableau en cours -->
    <RowDefinition Height="Auto"/>   <!-- 4 : Dernière image -->
    <RowDefinition Height="3*"/>     <!-- 5 : Historique -->
</Grid.RowDefinitions>

        <!-- BOUTONS -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Width="150" Margin="5" Click="SendReportNow_Click">
                <TextBlock Text="Envoyer rapport"/>
            </Button>

            <!-- SWITCH LOG -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15 5 5 5">
                <TextBlock Text="Log" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <ToggleButton x:Name="ToggleLog"
                              Width="40"
                              Height="20"
                              Checked="ToggleLog_Checked"
                              Unchecked="ToggleLog_Unchecked">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Width="40" Height="20">
                                            <Border x:Name="SwitchBackground"
                                                    CornerRadius="10"
                                                    Background="#3C3C3C"/>
                                            <Ellipse x:Name="SwitchThumb"
                                                     Width="16" Height="16"
                                                     Margin="2"
                                                     Fill="#E5E5E5"
                                                     HorizontalAlignment="Left"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SwitchBackground"
                                                        Property="Background"
                                                        Value="#4CC2FF"/>
                                                <Setter TargetName="SwitchThumb"
                                                        Property="HorizontalAlignment"
                                                        Value="Right"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
            <!-- 🔥 SWITCH EMAIL -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25 5 5 5">
                <TextBlock Text="Envoi du rapport automatique"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ToggleButton x:Name="ToggleEmail"
                              Width="40"
                              Height="20"
                              IsChecked="True"
                              Checked="ToggleEmail_Checked"
                              Unchecked="ToggleEmail_Unchecked">

                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Width="40" Height="20">
                                            <Border x:Name="SwitchBackground"
                                                    CornerRadius="10"
                                                    Background="#3C3C3C"/>
                                            <Ellipse x:Name="SwitchThumb"
                                                     Width="16" Height="16"
                                                     Margin="2"
                                                     Fill="#E5E5E5"
                                                     HorizontalAlignment="Left"/>
                                        </Grid>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SwitchBackground"
                                                        Property="Background"
                                                        Value="#4CC2FF"/>
                                                <Setter TargetName="SwitchThumb"
                                                        Property="HorizontalAlignment"
                                                        Value="Right"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>

                </ToggleButton>
            </StackPanel>
        </StackPanel>

        <!-- 🔥 SERVEUR WEB -->
        <GroupBox Header="Serveur Web"
                  Grid.Row="1"
                  Margin="10"
                  Padding="10"
                  Background="{StaticResource WebPanelBackground}"
                  BorderBrush="{StaticResource Win11Border}"
                  Foreground="{StaticResource Win11Text}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Zone 1 : Configuration -->
                    <ColumnDefinition Width="*"/>      <!-- Zone 2 : Espace réservé -->
                    <ColumnDefinition Width="Auto"/>   <!-- Zone 3 : Ouvrir -->
                </Grid.ColumnDefinitions>

                <!-- ZONE 1 : CONFIGURATION (à gauche) -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Switch -->
                        <RowDefinition Height="Auto"/>  <!-- Port -->
                        <RowDefinition Height="Auto"/>  <!-- Login -->
                        <RowDefinition Height="Auto"/>  <!-- Mot de passe -->
                        <RowDefinition Height="*"/>     <!-- Espace flexible -->
                        <RowDefinition Height="Auto"/>  <!-- Bouton Appliquer -->
                    </Grid.RowDefinitions>

                    <!-- Switch ON/OFF -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Activer le serveur Web"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ToggleButton x:Name="ToggleWeb"
                                      Width="40"
                                      Height="20"
                                      Checked="ToggleWeb_Checked"
                                      Unchecked="ToggleWeb_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="40" Height="20">
                                                    <Border x:Name="SwitchBackground"
                                                            CornerRadius="10"
                                                            Background="#3C3C3C"/>
                                                    <Ellipse x:Name="SwitchThumb"
                                                             Width="16" Height="16"
                                                             Margin="2"
                                                             Fill="#E5E5E5"
                                                             HorizontalAlignment="Left"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="SwitchBackground"
                                                                Property="Background"
                                                                Value="#4CC2FF"/>
                                                        <Setter TargetName="SwitchThumb"
                                                                Property="HorizontalAlignment"
                                                                Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Port :" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebPort"
                                 Width="200"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <!-- Login -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Login :" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebLogin"
                                 Width="200"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <!-- Mot de passe -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="177"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Mot de passe :" 
                                   Grid.Column="0"
                                   VerticalAlignment="Center"/>

                        <PasswordBox x:Name="txtWebPassword"
                                     Grid.Column="1"
                                     Width="177"
                                     Background="#1E1E1E"
                                     Foreground="#E5E5E5"
                                     BorderBrush="#3C3C3C"
                                     Visibility="Visible"/>

                        <TextBox x:Name="txtWebPasswordVisible"
                                 Grid.Column="1"
                                 Width="177"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"
                                 Visibility="Collapsed"/>

                        <Button x:Name="btnShowPassword"
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                Margin="6,0,0,0"
                                Padding="0"
                                Click="btnShowPassword_Click"
                                Background="#2D2D30"
                                BorderBrush="#3C3C3C"
                                BorderThickness="1"
                                Cursor="Hand">
                            <TextBlock Text="👁" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- Bouton Appliquer aligné sous les zones de texte -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>   <!-- même largeur que les labels -->
                            <ColumnDefinition Width="Auto"/>  <!-- bouton aligné avec les TextBox -->
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Appliquer"
                                Width="150"
                                Height="24"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Click="btnApplyWebAll_Click"/>
                    </Grid>
                </Grid>

                <!-- ZONE 2 : Sauvegarde de l'historique -->
                <Grid Grid.Column="1"
                      Margin="20,0"
                      VerticalAlignment="Center">

                    <!-- Trait vertical gauche -->
                    <Rectangle Width="1"
                               Fill="White"
                               HorizontalAlignment="Left"/>

                    <!-- Trait vertical droite -->
                    <Rectangle Width="1"
                               Fill="White"
                               HorizontalAlignment="Right"/>

                    <!-- Contenu Zone 2 -->
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20,0">

                        <TextBlock Text="Garder une sauvegarde :"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#F0F0F0"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- CheckBox alignées à gauche -->
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20">

                            <CheckBox x:Name="chkNone"
                                      Content="Aucune"
                                      Foreground="#E5E5E5"
                                      Margin="0,4"
                                      Checked="BackupOption_Checked"/>

                            <CheckBox x:Name="chk1w"
                                      Content="1 semaine"
                                      Foreground="#E5E5E5"
                                      Margin="0,4"
                                      Checked="BackupOption_Checked"/>

                            <CheckBox x:Name="chk2w"
                                      Content="2 semaines"
                                      Foreground="#E5E5E5"
                                      Margin="0,4"
                                      Checked="BackupOption_Checked"/>

                            <CheckBox x:Name="chk1m"
                                      Content="1 mois"
                                      Foreground="#E5E5E5"
                                      Margin="0,4"
                                      Checked="BackupOption_Checked"/>

                        </StackPanel>

                        <!-- Bouton aligné horizontalement avec les autres zones -->
                        <Button Content="Ouvrir la sauvegarde"
                                Width="180"
                                Height="24"
                                Padding="0,-1,0,0"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Left"
                                Click="btnOpenBackup_Click"/>
                    </StackPanel>
                </Grid>


                <!-- ZONE 3 : BOUTON OUVRIR (à droite, en bas) -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                    <Button Content="Ouvrir dans le navigateur"
                            Width="220"
                            Height="24"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Click="btnOpenWeb_Click"/>
                </StackPanel>

            </Grid>
        </GroupBox>
<!-- 🔥 SERVEUR TV -->
<GroupBox Header="Serveur TV"
          Grid.Row="2"
          Margin="10"
          Padding="10"
          Background="{StaticResource WebPanelBackground}"
          BorderBrush="{StaticResource Win11Border}"
          Foreground="{StaticResource Win11Text}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- URL -->
            <RowDefinition Height="Auto"/>  <!-- Login -->
            <RowDefinition Height="Auto"/>  <!-- Password -->
            <RowDefinition Height="Auto"/>  <!-- Appliquer -->
        </Grid.RowDefinitions>

        <!-- URL -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Adresse :" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="txtDvbUrl"
                     Width="400"
                     Background="#1E1E1E"
                     Foreground="#E5E5E5"
                     BorderBrush="#3C3C3C"/>
        </StackPanel>

        <!-- Login -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Login :" Width="120" VerticalAlignment="Center"/>
            <TextBox x:Name="txtDvbUser"
                     Width="200"
                     Background="#1E1E1E"
                     Foreground="#E5E5E5"
                     BorderBrush="#3C3C3C"/>
        </StackPanel>

        <!-- Password -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="177"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Mot de passe :" 
                       Grid.Column="0"
                       VerticalAlignment="Center"/>

            <PasswordBox x:Name="txtDvbPass"
                         Grid.Column="1"
                         Width="177"
                         Background="#1E1E1E"
                         Foreground="#E5E5E5"
                         BorderBrush="#3C3C3C"
                         Visibility="Visible"/>

            <TextBox x:Name="txtDvbPassVisible"
                     Grid.Column="1"
                     Width="177"
                     Background="#1E1E1E"
                     Foreground="#E5E5E5"
                     BorderBrush="#3C3C3C"
                     Visibility="Collapsed"/>

            <Button x:Name="btnShowDvbPass"
                    Grid.Column="2"
                    Width="18"
                    Height="18"
                    Margin="6,0,0,0"
                    Padding="0"
                    Click="btnShowDvbPass_Click"
                    Background="#2D2D30"
                    BorderBrush="#3C3C3C"
                    BorderThickness="1"
                    Cursor="Hand">
                <TextBlock Text="👁" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Bouton Appliquer -->
        <Button Grid.Row="3"
                Content="Appliquer"
                Width="150"
                Height="24"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalContentAlignment="Center"
                Click="btnApplyDvb_Click"/>
    </Grid>
</GroupBox>

        <!-- TABLEAU EN COURS -->
        <DataGrid x:Name="FilesGrid"
                  Grid.Row="3"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="22" Height="22"
                                   Source="{Binding IconPath}"
                                   VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Client IP" Binding="{Binding ClientName}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="100">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="#E5E5E5"/>
                            <Setter Property="BorderBrush" Value="#3C3C3C"/>
                            <Setter Property="BorderThickness" Value="0 0 1 1"/>

                            <Style.Triggers>

                                <!-- Série -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Serie">
                                    <Setter Property="Background" Value="#FF2A3A4A"/>
                                </DataTrigger>

                                <!-- Vidéo -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                    <Setter Property="Background" Value="#FF3A2A2A"/>
                                </DataTrigger>

                                <!-- Musique -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Audio">
                                    <Setter Property="Background" Value="#FF2A4A2A"/>
                                </DataTrigger>

                                <!-- Image -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Image">
                                    <Setter Property="Background" Value="#FF4A4A2A"/>
                                </DataTrigger>

                                <!-- Sélection -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#4CC2FF"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*"/>
                <DataGridTextColumn Header="Saison" Binding="{Binding Saison}" Width="60"/>
                <DataGridTextColumn Header="Episode" Binding="{Binding Episode}" Width="60"/>
                <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="3*"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- DERNIERE IMAGE -->
        <TextBlock x:Name="LastImageText"
                   Grid.Row="4"
                   Margin="10"
                   FontSize="16"
                   Text="Dernière image ouverte : aucune"/>

        <!-- TABLEAU HISTORIQUE -->
        <DataGrid x:Name="HistoryGrid"
                  Grid.Row="5"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="22" Height="22"
                                   Source="{Binding IconPath}"
                                   VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Heure"
                    Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                    Width="150"/>
                <DataGridTextColumn Header="Client IP" Binding="{Binding ClientName}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MediaType}" Width="100">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="#E5E5E5"/>
                            <Setter Property="BorderBrush" Value="#3C3C3C"/>
                            <Setter Property="BorderThickness" Value="0 0 1 1"/>

                            <Style.Triggers>

                                <!-- Série -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Serie">
                                    <Setter Property="Background" Value="#FF2A3A4A"/>
                                </DataTrigger>

                                <!-- Vidéo -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Video">
                                    <Setter Property="Background" Value="#FF3A2A2A"/>
                                </DataTrigger>

                                <!-- Musique -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Audio">
                                    <Setter Property="Background" Value="#FF2A4A2A"/>
                                </DataTrigger>

                                <!-- Image -->
                                <DataTrigger Binding="{Binding MediaType}" Value="Image">
                                    <Setter Property="Background" Value="#FF4A4A2A"/>
                                </DataTrigger>

                                <!-- Sélection -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#4CC2FF"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="2*"/>
                <DataGridTextColumn Header="Saison" Binding="{Binding Saison}" Width="60"/>
                <DataGridTextColumn Header="Episode" Binding="{Binding Episode}" Width="60"/>
                <DataGridTextColumn Header="Fichier" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" Width="3*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>

