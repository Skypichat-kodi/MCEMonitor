<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MediaMonitor.Tray</AssemblyName>
    <RootNamespace>MediaMonitor.Tray</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>MediaMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- On retire l'inclusion implicite -->
  <ItemGroup>
    <None Remove="MediaMonitor.ico" />
  </ItemGroup>

  <!-- On l'embarque -->
  <ItemGroup>
    <EmbeddedResource Include="MediaMonitor.ico" LogicalName="MediaMonitor.ico" />
  </ItemGroup>

</Project>