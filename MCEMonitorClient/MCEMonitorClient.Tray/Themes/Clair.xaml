<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair du Tray, aligné sur les cinq interfaces : mêmes teintes que
         MCEMonitor.UI pour le fond, les surfaces, les bordures et l'accent. -->
    <SolidColorBrush x:Key="Fond"            Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Surface"         Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceSurvol"   Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Bordure"         Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="Texte"           Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TexteSecondaire" Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="Accent"          Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="Succes"          Color="#FF107C10" />
</ResourceDictionary>
