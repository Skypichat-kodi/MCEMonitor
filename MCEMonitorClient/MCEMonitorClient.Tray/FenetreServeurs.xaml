<Window x:Class="MCEMonitorClient.Tray.FenetreServeurs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Serveurs surveillés'}"
        Width="748"
        Height="448"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#E5E5E5"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- Fenetre fixe : sans WindowStyle et sans redimensionnement, Windows
         n'ajoute aucun cadre. La transparence permet les coins arrondis et
         l'ombre ; la marge de 14 px laisse la place a cette ombre. -->

    <!--
      Popup d'état des serveurs, ouvert depuis le Tray (double-clic sur
      l'icône) et depuis la configuration (bouton « État des serveurs »).

      Cette fenêtre vit dans le projet Tray, qui reste un exécutable WinForms
      pour le NotifyIcon. Les ressources ci-dessous reprennent la palette des
      interfaces MCEMonitor : elles ne peuvent pas être héritées de l'App.xaml
      du client de configuration, qui est une autre application.
    -->

        <Window.Resources>
        <!-- Ressources reprises telles quelles du client de configuration :
             palette, boutons, champs, listes, barres de defilement. La fenetre
             du Tray s affiche ainsi exactement comme les autres, sans dependre
             d un autre projet. -->


        <!-- ============================================================
             Palette sombre, proche de Windows 11, accent bleu profond.
             Reprise du client Windows MelTime, pour que les deux logiciels
             ne jurent pas l'un a cote de l'autre.
             ============================================================ -->
        <Color x:Key="CouleurFond">#FF1B1B1B</Color>
        <Color x:Key="CouleurSurface">#FF262626</Color>
        <Color x:Key="CouleurSurfaceSurvol">#FF303030</Color>
        <Color x:Key="CouleurSurfaceActive">#FF3A3A3A</Color>
        <Color x:Key="CouleurBordure">#FF3D3D3D</Color>
        <Color x:Key="CouleurTexte">#FFF2F2F2</Color>
        <Color x:Key="CouleurTexteSecondaire">#FFA0A0A0</Color>
        <Color x:Key="CouleurAccent">#FF0078D4</Color>
        <Color x:Key="CouleurAccentSurvol">#FF1B8AE0</Color>
        <Color x:Key="CouleurAccentPresse">#FF0067B8</Color>
        <Color x:Key="CouleurSucces">#FF3FB950</Color>
        <Color x:Key="CouleurSuccesSurvol">#FF4ECD60</Color>
        <Color x:Key="CouleurSuccesPresse">#FF35A045</Color>
        <Color x:Key="CouleurErreur">#FFFF5B5B</Color>
        <Color x:Key="CouleurErreurSurvol">#FFFF7A7A</Color>
        <Color x:Key="CouleurErreurPresse">#FFE04545</Color>

        <SolidColorBrush x:Key="Fond" Color="{StaticResource CouleurFond}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource CouleurSurface}" />
        <SolidColorBrush x:Key="SurfaceSurvol" Color="{StaticResource CouleurSurfaceSurvol}" />
        <SolidColorBrush x:Key="SurfaceActive" Color="{StaticResource CouleurSurfaceActive}" />
        <SolidColorBrush x:Key="Bordure" Color="{StaticResource CouleurBordure}" />
        <SolidColorBrush x:Key="Texte" Color="{StaticResource CouleurTexte}" />
        <SolidColorBrush x:Key="TexteSecondaire" Color="{StaticResource CouleurTexteSecondaire}" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource CouleurAccent}" />
        <SolidColorBrush x:Key="AccentSurvol" Color="{StaticResource CouleurAccentSurvol}" />
        <SolidColorBrush x:Key="AccentPresse" Color="{StaticResource CouleurAccentPresse}" />
        <SolidColorBrush x:Key="Succes" Color="{StaticResource CouleurSucces}" />
        <SolidColorBrush x:Key="SuccesSurvol" Color="{StaticResource CouleurSuccesSurvol}" />
        <SolidColorBrush x:Key="SuccesPresse" Color="{StaticResource CouleurSuccesPresse}" />
        <SolidColorBrush x:Key="Erreur" Color="{StaticResource CouleurErreur}" />
        <SolidColorBrush x:Key="ErreurSurvol" Color="{StaticResource CouleurErreurSurvol}" />
        <SolidColorBrush x:Key="ErreurPresse" Color="{StaticResource CouleurErreurPresse}" />

        <!-- ============================================================
             Textes

             Pas de style implicite TextBlock : il s'appliquerait aussi aux
             TextBlock generes a l'interieur des boutons et des listes.
             ============================================================ -->
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="Aide" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Margin" Value="0,6,0,16" />
        </Style>

        <Style x:Key="TitreSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- ============================================================
             Champ de saisie
             ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Zone de journal (texte brut, monospace)

             Le style TextBox general centre verticalement son contenu :
             convenable pour une ligne de saisie, pas pour un journal
             multiligne. D'ou ce modele dedie.
             ============================================================ -->
        <!-- Champs des paramètres de modules (RomMonitor, SystemMonitor, NetMonitor) :
             cellule plus basse et marges resserrées pour que ces onglets tiennent
             dans la fenêtre, sans toucher aux champs de la saisie courante. -->
        <Style x:Key="ChampParametre" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ZoneLog" TargetType="TextBox">
            <Setter Property="Background" Value="#FF141414" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Case a cocher
             ============================================================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Case"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Coche"
                                      Data="M 3 8 L 6.5 11.5 L 13 4"
                                      Stroke="{StaticResource Accent}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource AccentSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Boutons
             ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="3"/>
            <!-- Rembourrage vertical nul : tous les boutons du client ont une hauteur
                 fixe. Avec le 14,7 de la palette MCEMonitor, le texte n'avait plus la
                 place dans 30 px et se retrouvait décalé vers le bas. -->
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Fond sur toute la surface arrondie, contour par-dessus :
                             sinon le fond s arrete au rayon interieur et laisse un
                             liseré dans les quatre angles. -->
                        <Grid>
                            <Border x:Name="Cadre"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"/>
                            <Border x:Name="Trait"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                                <Setter TargetName="Trait" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Trait" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal : bleu -->
        <Style x:Key="BoutonAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource AccentSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource AccentSurvol}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource AccentPresse}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action positive : vert, pour demarrer le service -->
        <Style x:Key="BoutonSucces" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Succes}" />
            <Setter Property="BorderBrush" Value="{StaticResource Succes}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SuccesSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SuccesSurvol}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SuccesPresse}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action destructive : rouge, pour arreter le service -->
        <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Erreur}" />
            <Setter Property="BorderBrush" Value="{StaticResource Erreur}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource ErreurSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource ErreurSurvol}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource ErreurPresse}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire : contour discret -->
        <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <!-- Fond opaque : depuis l'ajout de l'image de fond, un bouton transparent
                 laisse voir l'image au travers. -->
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
        </Style>

        <!-- Bouton discret, sans cadre visible -->
        <Style x:Key="BoutonFantome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        </Style>

        <!-- ============================================================
             Section depliable (reglages avances)
             Le chevron pivote et le contenu apparait sous le titre.
             ============================================================ -->
        <Style x:Key="BoutonDepliable" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource AccentSurvol}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Path x:Name="Chevron"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{StaticResource AccentSurvol}"
                                  StrokeThickness="1.6"
                                  VerticalAlignment="Center"
                                  Margin="0,0,9,0"
                                  RenderTransformOrigin="0.5,0.5" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Liste deroulante
             ============================================================ -->
        <Style x:Key="ZoneListe" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Path x:Name="Fleche"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{StaticResource TexteSecondaire}"
                                  StrokeThickness="1.4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                                <Setter TargetName="Fleche" Property="Stroke" Value="{StaticResource Texte}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Fleche" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Cadre" Background="Transparent" CornerRadius="4" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Zone"
                                          Style="{StaticResource ZoneListe}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Bordure}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Barre de defilement fine, discrete sur fond sombre
             ============================================================ -->
        <Style x:Key="PouceDefilement" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pouce"
                                Background="{StaticResource Accent}"
                                Opacity="0.55"
                                CornerRadius="3"
                                Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pouce" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pouce" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PouceDefilement}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             Listes
             ============================================================ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer Padding="4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Cadre"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Onglets

             Le modèle par défaut dessine un cadre clair autour du contenu,
             incomptabile avec une palette sombre. On le remplace par une
             rangée d'onglets en haut et un contenu posé directement sur le fond.
             ============================================================ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="0,0,0,0" />
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0,14,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Cadre"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="12,8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Texte}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource Texte}" />
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styles propres a la grille des serveurs, absents de la palette. -->
        <Style x:Key="Cellule" TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource Texte}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center" Margin="8,0" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

        <Style x:Key="Entete" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                    <Setter Property="Foreground" Value="{StaticResource Texte}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>

        <Style x:Key="Ligne" TargetType="DataGridRow">
                    <Setter Property="Background" Value="{StaticResource Fond}" />
                    <Setter Property="Foreground" Value="{StaticResource Texte}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="{StaticResource Surface}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource SurfaceSurvol}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

        <Style x:Key="TexteCellule" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- en-tête -->
                <RowDefinition Height="Auto" />   <!-- astuce -->
                <RowDefinition Height="*" />      <!-- grille -->
                <RowDefinition Height="Auto" />   <!-- pied -->
            </Grid.RowDefinitions>

            <!-- ================= En-tête ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock Text="{loc:Tr 'Serveurs surveillés'}"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />

                    <Button Content="✕"
                           
                            Width="32" Height="28" Padding="0" FontSize="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{StaticResource TexteSecondaire}"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- ================= Astuce ================= -->
            <TextBlock Grid.Row="1"
                       Text="{loc:Tr 'HintDoubleClickOpen'}"
                       Margin="20,10,20,8"
                       FontSize="12"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TexteSecondaire}" />

            <!-- ================= Grille ================= -->
            <DataGrid Grid.Row="2"
                      x:Name="GrilleServeurs"
                      Margin="20,0,20,10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      AlternationCount="2"
                      RowHeight="28"
                      Background="{StaticResource Fond}"
                      BorderBrush="{StaticResource Bordure}"
                      BorderThickness="1"
                      GridLinesVisibility="None"
                      ColumnHeaderStyle="{StaticResource Entete}"
                      CellStyle="{StaticResource Cellule}"
                      RowStyle="{StaticResource Ligne}"
                      MouseDoubleClick="SurDoubleClic">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr 'Serveur'}"
                                        Binding="{Binding ServerName}"
                                        Width="*"
                                        ElementStyle="{StaticResource TexteCellule}" />
                    <DataGridTextColumn Header="{loc:Tr 'Type'}"
                                        Binding="{Binding ServiceType}"
                                        Width="130"
                                        ElementStyle="{StaticResource TexteCellule}" />
                    <DataGridTemplateColumn Header="{loc:Tr 'État'}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding CouleurEtat}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="8,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ================= Pied ================= -->
            <Border Grid.Row="3"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="BoutonActualiser"
                            Content="{loc:Tr 'Actualiser'}"
                            Style="{StaticResource BoutonAccent}"
                            Width="150" Height="30"
                            Click="SurActualiser" />

                    <TextBlock Grid.Column="1"
                               x:Name="TexteStatut"
                               VerticalAlignment="Center"
                               Margin="16,0,16,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TexteSecondaire}"
                               Text="" />

                    <Button Grid.Column="2"
                            Content="{loc:Tr 'Fermer'}"
                           
                            Width="120" Height="30"
                            Click="SurFermer" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
