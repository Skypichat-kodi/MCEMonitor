<Window x:Class="MCEMonitorClient.Tray.FenetreServeurs"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Serveurs surveillés'}"
        Width="748"
        Height="448"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="#E5E5E5"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- Fenetre fixe : sans WindowStyle et sans redimensionnement, Windows
         n'ajoute aucun cadre. La transparence permet les coins arrondis et
         l'ombre ; la marge de 14 px laisse la place a cette ombre. -->

    <!--
      Popup d'état des serveurs, ouvert depuis le Tray (double-clic sur
      l'icône) et depuis la configuration (bouton « État des serveurs »).

      Cette fenêtre vit dans le projet Tray, qui reste un exécutable WinForms
      pour le NotifyIcon. Les ressources ci-dessous reprennent la palette des
      interfaces MCEMonitor : elles ne peuvent pas être héritées de l'App.xaml
      du client de configuration, qui est une autre application.
    -->

    <Window.Resources>
        <SolidColorBrush x:Key="Fond"            Color="#FF1B1B1B" />
        <SolidColorBrush x:Key="Surface"         Color="#FF252526" />
        <SolidColorBrush x:Key="SurfaceSurvol"   Color="#FF2E2E31" />
        <SolidColorBrush x:Key="Bordure"         Color="#FF3C3C3C" />
        <SolidColorBrush x:Key="Texte"           Color="#FFE5E5E5" />
        <SolidColorBrush x:Key="TexteSecondaire" Color="#FFB4B4B4" />
        <SolidColorBrush x:Key="Accent"          Color="#FF4CC2FF" />
        <SolidColorBrush x:Key="Succes"          Color="#FF6CCB5F" />

        <Style x:Key="Bouton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Cadre"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonAccent" TargetType="Button" BasedOn="{StaticResource Bouton}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="TexteCellule" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
        </Style>

        <Style x:Key="Entete" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="Cellule" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ligne" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource Fond}" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource Surface}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceSurvol}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- en-tête -->
                <RowDefinition Height="Auto" />   <!-- astuce -->
                <RowDefinition Height="*" />      <!-- grille -->
                <RowDefinition Height="Auto" />   <!-- pied -->
            </Grid.RowDefinitions>

            <!-- ================= En-tête ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock Text="{loc:Tr 'Serveurs surveillés'}"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" />

                    <Button Content="✕"
                            Style="{StaticResource Bouton}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{StaticResource TexteSecondaire}"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- ================= Astuce ================= -->
            <TextBlock Grid.Row="1"
                       Text="{loc:Tr 'HintDoubleClickOpen'}"
                       Margin="20,10,20,8"
                       FontSize="12"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TexteSecondaire}" />

            <!-- ================= Grille ================= -->
            <DataGrid Grid.Row="2"
                      x:Name="GrilleServeurs"
                      Margin="20,0,20,10"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      AlternationCount="2"
                      RowHeight="28"
                      Background="{StaticResource Fond}"
                      BorderBrush="{StaticResource Bordure}"
                      BorderThickness="1"
                      GridLinesVisibility="None"
                      ColumnHeaderStyle="{StaticResource Entete}"
                      CellStyle="{StaticResource Cellule}"
                      RowStyle="{StaticResource Ligne}"
                      MouseDoubleClick="SurDoubleClic">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr 'Serveur'}"
                                        Binding="{Binding ServerName}"
                                        Width="*"
                                        ElementStyle="{StaticResource TexteCellule}" />
                    <DataGridTextColumn Header="{loc:Tr 'Type'}"
                                        Binding="{Binding ServiceType}"
                                        Width="130"
                                        ElementStyle="{StaticResource TexteCellule}" />
                    <DataGridTemplateColumn Header="{loc:Tr 'État'}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="10" Height="10"
                                         Fill="{Binding CouleurEtat}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="8,0,0,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ================= Pied ================= -->
            <Border Grid.Row="3"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <Grid Margin="20,10,20,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="BoutonActualiser"
                            Content="{loc:Tr 'Actualiser'}"
                            Style="{StaticResource BoutonAccent}"
                            Width="150" Height="30"
                            Click="SurActualiser" />

                    <TextBlock Grid.Column="1"
                               x:Name="TexteStatut"
                               VerticalAlignment="Center"
                               Margin="16,0,16,0"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TexteSecondaire}"
                               Text="" />

                    <Button Grid.Column="2"
                            Content="{loc:Tr 'Fermer'}"
                            Style="{StaticResource Bouton}"
                            Width="120" Height="30"
                            Click="SurFermer" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
