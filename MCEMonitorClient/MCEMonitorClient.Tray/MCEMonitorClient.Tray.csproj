<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationIcon>MCEMonitorClient.ico</ApplicationIcon>
    <AssemblyName>MCEMonitorClient.Tray</AssemblyName>
    <RootNamespace>MCEMonitorClient.Tray</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône de l'exe -->
    <Content Include="MCEMonitorClient.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>

    <!-- Icônes d'état (dans Resources\Icons) -->
    <Content Include="Resources\Icons\*.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>

    <!-- Sons (dans Resources\Sounds) -->
    <Content Include="Resources\Sounds\*.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>