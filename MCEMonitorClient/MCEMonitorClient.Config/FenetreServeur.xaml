<Window x:Class="MCEMonitorClient.Config.FenetreServeur"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Ajouter un serveur'}"
        Width="548"
        Height="428"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- Même gabarit que la fenêtre principale : la zone utile reprend les
         520 x 400 de l'ancien ServerEditForm. -->

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= En-tête ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock x:Name="TexteTitre"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               Text="" />

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="{loc:Tr 'Annuler'}"
                            Click="SurAnnuler" />
                </Grid>
            </Border>

            <!-- ================= Formulaire ================= -->
            <Grid Grid.Row="1" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Nom -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Tr 'Nom'}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="ChampNom"
                         Style="{StaticResource ChampParametre}"
                         Margin="0,0,0,8" />

                <!-- Type : renseigné par la détection -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{loc:Tr 'Type'}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}" />
                <Border Grid.Row="1" Grid.Column="1"
                        Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Bordure}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Height="24"
                        Margin="0,0,0,8"
                        Padding="7,0">
                    <TextBlock x:Name="TexteType"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{StaticResource TexteSecondaire}"
                               Text="—" />
                </Border>

                <!-- URL + Port -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{loc:Tr 'URL'}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="ChampUrl"
                             Style="{StaticResource ChampParametre}"
                             LostFocus="SurUrlPerdue" />
                    <TextBlock Grid.Column="1"
                               Text="{loc:Tr 'Port'}"
                               VerticalAlignment="Center"
                               Margin="10,0,6,0"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <TextBox Grid.Column="2"
                             x:Name="ChampPort"
                             Style="{StaticResource ChampParametre}"
                             Width="70"
                             TextAlignment="Right"
                             LostFocus="SurPortPerdu" />
                </Grid>

                <!-- Login -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{loc:Tr 'Login'}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         x:Name="ChampLogin"
                         Style="{StaticResource ChampParametre}"
                         Margin="0,0,0,8" />

                <!-- Mot de passe : PasswordBox et TextBox superposés, on bascule
                     la visibilité plutôt que de convertir la valeur. -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{loc:Tr 'Mot de passe'}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TexteSecondaire}" />
                <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PasswordBox Grid.Column="0"
                                 x:Name="ChampMotDePasse"
                                 Height="24"
                                 Padding="7,0"
                                 VerticalContentAlignment="Center"
                                 Background="{StaticResource Surface}"
                                 Foreground="{StaticResource Texte}"
                                 BorderBrush="{StaticResource Bordure}"
                                 BorderThickness="1" />

                    <TextBox Grid.Column="0"
                             x:Name="ChampMotDePasseVisible"
                             Style="{StaticResource ChampParametre}"
                             Visibility="Collapsed" />

                    <Button Grid.Column="1"
                            x:Name="BoutonOeil"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="34" Height="24"
                            Margin="8,0,0,0"
                            Padding="0"
                            FontSize="12"
                            ToolTip="{loc:Tr 'Afficher le mot de passe'}"
                            Click="SurAfficherMotDePasse"
                            Content="👁" />
                </Grid>

                <!-- Test de connexion -->
                <StackPanel Grid.Row="5" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,4,0,0">
                    <Button x:Name="BoutonTester"
                            Content="{loc:Tr 'Tester'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="100" Height="28"
                            Click="SurTester" />

                    <TextBlock x:Name="TexteResultat"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TexteSecondaire}"
                               Text="" />
                </StackPanel>
            </Grid>

            <!-- ================= Pied ================= -->
            <Border Grid.Row="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="18,10,18,10">
                    <Button Content="{loc:Tr 'Annuler'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="110" Height="30"
                            Click="SurAnnuler" />
                    <Button Content="{loc:Tr 'Enregistrer'}"
                            Style="{StaticResource BoutonAccent}"
                            Width="110" Height="30"
                            Margin="8,0,0,0"
                            IsDefault="True"
                            Click="SurEnregistrer" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
