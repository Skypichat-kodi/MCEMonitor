<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <!-- Les deux piles coexistent le temps de la migration : WPF pour les
         fenetres, Windows Forms uniquement pour ouvrir le popup du Tray
         (encore WinForms) et pour les icones systeme. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationIcon>MCEMonitorClient.ico</ApplicationIcon>
    <AssemblyName>MCEMonitorClient.Config</AssemblyName>
    <RootNamespace>MCEMonitorClient.Config</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MCEMonitor.Languages\MCEMonitor.Languages.csproj" />
    <ProjectReference Include="..\MCEMonitorClient.Tray\MCEMonitorClient.Tray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Icons\false.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>