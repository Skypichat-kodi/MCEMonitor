<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationIcon>MCEMonitorClient.ico</ApplicationIcon>
    <AssemblyName>MCEMonitorClient.Config</AssemblyName>
    <RootNamespace>MCEMonitorClient.Config</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MCEMonitor.Languages\MCEMonitor.Languages.csproj" />
    <ProjectReference Include="..\MCEMonitorClient.Tray\MCEMonitorClient.Tray.csproj" />
  </ItemGroup>

  <!-- Ressources propres au produit : copiées dans bin\...\Resources\Icons\MCEMonitorClient\ -->
  <ItemGroup>
    <None Update="Resources\Icons\MCEMonitorClient\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>