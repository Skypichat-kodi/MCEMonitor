                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          x:Name="CaseWakeIpPublique"
                                          Content="{loc:Tr 'Inclure IP publique'}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          x:Name="CaseWakeIpLocale"
                                          Content="{loc:Tr 'Inclure IP locale'}"
                                          Margin="0,0,0,8" />

                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          x:Name="CaseWakeMac"
                                          Content="{loc:Tr 'Inclure MAC'}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          x:Name="CaseWakeUsb"
                                          Content="{loc:Tr 'Inclure USB'}"
                                          Margin="0,0,0,8" />

                                <CheckBox Grid.Row="2" Grid.Column="0"
                                          x:Name="CaseWakeCause"
                                          Content="{loc:Tr 'Inclure cause'}" />
                                <CheckBox Grid.Row="2" Grid.Column="1"
                                          x:Name="CaseWakeDuree"
                                          Content="{loc:Tr 'Inclure durée'}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Button x:Name="BoutonAutomatiqueWake"
                                    Content="{loc:Tr 'Automatique OFF'}"
                                    Style="{StaticResource BoutonDanger}"
                                    Width="190" Height="32"
                                    Padding="0"
                                    Click="SurAutomatisationWake" />
                            <Button x:Name="BoutonMailTestWake"
                                    Content="{loc:Tr 'Common.MailTest'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="190" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurMailTestWake" />
                            <Button x:Name="BoutonMacsWake"
                                    Content="{loc:Tr 'Gérer MAC autorisées'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="190" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurGererMacsWake" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="BoutonEnregistrerWake"
                                    Content="{loc:Tr 'Enregistrer configuration'}"
                                    Style="{StaticResource BoutonAccent}"
                                    Width="200" Height="32"
                                    Padding="0"
                                    Click="SurEnregistrerWake" />
                            <TextBlock x:Name="MessageWake"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ StopMonitor ============ -->
                <TabItem x:Name="OngletStop" Header="{loc:Tr 'StopMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'StopMonitor vous permet de savoir pourquoi votre machine a démarré ou redémarré via une tâche planifiée.'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation StopMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BoutonAutomatiqueStop"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationStop" />
                                    <Button x:Name="BoutonMailTestStop"
                                            Content="{loc:Tr 'Common.MailTest'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurMailTestStop" />
                                </StackPanel>

                                <TextBlock Margin="0,12,0,0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Text="{loc:Tr 'Stop.Hint'}" />

                                <TextBlock x:Name="MessageStop"
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ À propos ============ -->
                <TabItem x:Name="OngletAPropos" Header="{loc:Tr 'À propos'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- En-tête -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{loc:Tr 'MCEMonitor'}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="TexteVersion"
                                       FontSize="11"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Margin="0,2,0,10"
                                       Text="Version…" />

                            <TextBlock Text="{loc:Tr 'About.Description'}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Texte}"
                                       Margin="0,0,0,16" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Licence MIT', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <!-- La carte occupe toute la hauteur restante : les boutons
                             se retrouvent ainsi plaqués en bas de l'onglet. -->
                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Copyright (c) 2026 Skypichat-kodi"
                                           FontSize="11"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Margin="0,0,0,8" />

                                <ScrollViewer x:Name="CadreLicence"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="TexteLicence"
                                               FontSize="11"
                                               LineHeight="16"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TexteSecondaire}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Boutons, en bas de l'onglet -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,16,0,0">
                            <Button x:Name="BoutonDossierLogs"
                                    Content="{loc:Tr 'Dossier Logs'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Padding="0"
                                    Click="SurOuvrirLogs" />
                            <Button x:Name="BoutonPurgerLogs"
                                    Content="{loc:Tr 'Purger les logs'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurPurgerLogs" />
                            <!-- Emplacement réservé : la bascule de thème reste à écrire,
                                 la palette sombre étant pour l'instant la seule définie. -->
                            <Button x:Name="BoutonChangerTheme"
                                    Content="{loc:Tr 'Changer de thème'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurChoisirTheme" />
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
