                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="0" Grid.Column="3"
                                         x:Name="ChampSystemDelai"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />

                                <!-- CPU -->
                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          x:Name="CaseSystemCpu"
                                          Content="{loc:Tr 'Alerte si CPU saturé'}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Style="{StaticResource Libelle}"
                                           Margin="10,0,0,12"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Seuil CPU (%) :'}" />
                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="1" Grid.Column="3"
                                         x:Name="ChampSystemCpu"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />

                                <!-- RAM -->
                                <CheckBox Grid.Row="2" Grid.Column="0"
                                          x:Name="CaseSystemRam"
                                          Content="{loc:Tr 'Alerte si RAM saturée'}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Style="{StaticResource Libelle}"
                                           Margin="10,0,0,12"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Seuil RAM (%) :'}" />
                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="2" Grid.Column="3"
                                         x:Name="ChampSystemRam"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />

                                <!-- Température CPU -->
                                <CheckBox Grid.Row="3" Grid.Column="0"
                                          x:Name="CaseSystemTemp"
                                          Content="{loc:Tr 'Alerte si température CPU élevée'}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Style="{StaticResource Libelle}"
                                           Margin="10,0,0,12"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Seuil Temp. CPU (°C) :'}" />
                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="3" Grid.Column="3"
                                         x:Name="ChampSystemTemp"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />

                                <!-- Température GPU -->
                                <CheckBox Grid.Row="4" Grid.Column="0"
                                          x:Name="CaseSystemGpuTemp"
                                          Content="{loc:Tr 'Alerte si température GPU élevée'}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="2"
                                           Style="{StaticResource Libelle}"
                                           Margin="10,0,0,12"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Seuil Temp. GPU (°C) :'}" />
                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="4" Grid.Column="3"
                                         x:Name="ChampSystemGpuTemp"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="BoutonEnregistrerSystem"
                                    Content="{loc:Tr 'Enregistrer les réglages'}"
                                    Style="{StaticResource BoutonAccent}"
                                    Width="200" Height="32"
                                    Padding="0"
                                    Click="SurEnregistrerReglagesSystem" />
                            <TextBlock x:Name="MessageSystem"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ NetMonitor ============ -->
                <TabItem x:Name="OngletNet" Header="{loc:Tr 'NetMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'NetMonitor surveille le trafic réseau et détecte les comportements suspects. Une carte permet de visualiser les équipements connectés. Les données sont collectées par un service Windows.'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation NetMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BasculeServiceNet"
                                                  Content="ON / OFF"
                                                  Style="{StaticResource BoutonBascule}"
                                                  Width="90" Height="28"
                                                  Click="SurBasculeServiceNet" />
                                    <TextBlock x:Name="TexteEtatServiceNet"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Texte}"
                                               Text="{loc:Tr 'Service NetMonitor'}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="BoutonAutomatiqueNet"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationNet" />
                                    <Button x:Name="BoutonOuvrirNet"
                                            Content="{loc:Tr 'Ouvrir NetMonitor'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurOuvrirNetUI" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{loc:Tr 'Blocage automatique', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="4"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <!-- Défilement de secours : sur une fenêtre courte, la ligne
                                 d'aide se retrouvait rognée par le bas du cadre. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Focusable="False">
                                <StackPanel>
                                    <CheckBox x:Name="CaseNetAutoBlock"
                                              Content="{loc:Tr 'Activer le blocage automatique (interrupteur principal)'}"
                                              FontWeight="Bold"
                                              Margin="0,0,0,10" />

                                    <CheckBox x:Name="CaseNetAutoBlockCritical"
                                              Style="{StaticResource CocheColoree}"
                                              Tag="{StaticResource PastilleCritique}"
                                              Content="{loc:Tr 'Bloquer les menaces critiques'}"
                                              Margin="0,0,0,7" />

                                    <CheckBox x:Name="CaseNetAutoBlockWarning"
                                              Style="{StaticResource CocheColoree}"
                                              Tag="{StaticResource PastilleInconnue}"
                                              Content="{loc:Tr 'Bloquer les menaces inconnues'}"
                                              Margin="0,0,0,7" />

                                    <CheckBox x:Name="CaseNetBlockKnownScanners"
                                              Style="{StaticResource CocheColoree}"
                                              Tag="{StaticResource PastilleScanner}"
                                              Content="{loc:Tr 'Bloquer les scanners de recherche'}"
                                              Margin="0,0,0,7" />

                                    <CheckBox x:Name="CaseNetBlockBots"
                                              Style="{StaticResource CocheColoree}"
                                              Tag="{StaticResource PastilleRobot}"
                                              Content="{loc:Tr 'Bloquer les robots officiels (Googlebot, Bingbot...)'}"
                                              Margin="0,0,0,7" />

                                    <CheckBox x:Name="CaseNetBlockCrawlers"
                                              Style="{StaticResource CocheColoree}"
                                              Tag="{StaticResource PastilleCrawler}"
                                              Content="{loc:Tr 'Bloquer les robots génériques (Yandex, Baidu...)'}" />

                                    <TextBlock Style="{StaticResource Aide}"
                                               Margin="0,10,0,0"
                                               Text="{loc:Tr 'Les services de confiance (Microsoft, Google, Windows) restent toujours exclus.'}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="BoutonEnregistrerNet"
                                    Content="{loc:Tr 'Enregistrer les réglages'}"
                                    Style="{StaticResource BoutonAccent}"
                                    Width="200" Height="32"
                                    Padding="0"
                                    Click="SurEnregistrerReglagesNet" />
                            <TextBlock x:Name="MessageNet"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ WakeMonitor ============ -->
                <TabItem x:Name="OngletWake" Header="{loc:Tr 'WakeMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="13"
                                               LineHeight="19"
                                               Text="{loc:Tr 'Wake.Info'}" />

                                    <!-- Rappel du fonctionnement des adresses MAC autorisées :
                                         il figurait dans l ancienne interface WinForms et avait
                                         disparu à la migration. -->
                                    <TextBlock TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="12"
                                               LineHeight="18"
                                               Text="{loc:Tr 'Wake.MacHelp'}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Indications à donner dans le mail', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          x:Name="CaseWakeIpPublique"
                                          Content="{loc:Tr 'Inclure IP publique'}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          x:Name="CaseWakeIpLocale"
                                          Content="{loc:Tr 'Inclure IP locale'}"
                                          Margin="0,0,0,8" />

                                <CheckBox Grid.Row="1" Grid.Column="0"
                                          x:Name="CaseWakeMac"
                                          Content="{loc:Tr 'Inclure MAC'}"
                                          Margin="0,0,0,8" />
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                          x:Name="CaseWakeUsb"
                                          Content="{loc:Tr 'Inclure USB'}"
                                          Margin="0,0,0,8" />

                                <CheckBox Grid.Row="2" Grid.Column="0"
                                          x:Name="CaseWakeCause"
                                          Content="{loc:Tr 'Inclure cause'}" />
                                <CheckBox Grid.Row="2" Grid.Column="1"
                                          x:Name="CaseWakeDuree"
                                          Content="{loc:Tr 'Inclure durée'}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Button x:Name="BoutonAutomatiqueWake"
                                    Content="{loc:Tr 'Automatique OFF'}"
                                    Style="{StaticResource BoutonDanger}"
                                    Width="190" Height="32"
                                    Padding="0"
                                    Click="SurAutomatisationWake" />
                            <Button x:Name="BoutonMailTestWake"
                                    Content="{loc:Tr 'Common.MailTest'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="190" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurMailTestWake" />
                            <Button x:Name="BoutonMacsWake"
                                    Content="{loc:Tr 'Gérer MAC autorisées'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="190" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurGererMacsWake" />
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="BoutonEnregistrerWake"
                                    Content="{loc:Tr 'Enregistrer configuration'}"
                                    Style="{StaticResource BoutonAccent}"
                                    Width="200" Height="32"
                                    Padding="0"
                                    Click="SurEnregistrerWake" />
                            <TextBlock x:Name="MessageWake"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ StopMonitor ============ -->
                <TabItem x:Name="OngletStop" Header="{loc:Tr 'StopMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'StopMonitor vous permet de savoir pourquoi votre machine a démarré ou redémarré via une tâche planifiée.'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation StopMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BoutonAutomatiqueStop"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationStop" />
                                    <Button x:Name="BoutonMailTestStop"
                                            Content="{loc:Tr 'Common.MailTest'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurMailTestStop" />
                                </StackPanel>

                                <TextBlock Margin="0,12,0,0"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Text="{loc:Tr 'Stop.Hint'}" />

                                <TextBlock x:Name="MessageStop"
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ À propos ============ -->
                <TabItem x:Name="OngletAPropos" Header="{loc:Tr 'À propos'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- En-tête -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{loc:Tr 'MCEMonitor'}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="TexteVersion"
                                       FontSize="11"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Margin="0,2,0,10"
                                       Text="Version…" />

                            <TextBlock Text="{loc:Tr 'About.Description'}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Texte}"
                                       Margin="0,0,0,16" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Licence MIT', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <!-- La carte occupe toute la hauteur restante : les boutons
                             se retrouvent ainsi plaqués en bas de l'onglet. -->
                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Copyright (c) 2026 Skypichat-kodi"
                                           FontSize="11"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Margin="0,0,0,8" />

                                <ScrollViewer x:Name="CadreLicence"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock x:Name="TexteLicence"
                                               FontSize="11"
                                               LineHeight="16"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TexteSecondaire}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Boutons, en bas de l'onglet -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,16,0,0">
                            <Button x:Name="BoutonDossierLogs"
                                    Content="{loc:Tr 'Dossier Logs'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Padding="0"
                                    Click="SurOuvrirLogs" />
                            <Button x:Name="BoutonPurgerLogs"
                                    Content="{loc:Tr 'Purger les logs'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurPurgerLogs" />
                            <!-- Emplacement réservé : la bascule de thème reste à écrire,
                                 la palette sombre étant pour l'instant la seule définie. -->
                            <Button x:Name="BoutonChangerTheme"
                                    Content="{loc:Tr 'Changer de thème'}"
                                    Style="{StaticResource BoutonSecondaire}"
                                    Width="150" Height="32"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Click="SurChoisirTheme" />
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
