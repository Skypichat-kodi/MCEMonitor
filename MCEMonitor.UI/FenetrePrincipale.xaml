<Window x:Class="MCEMonitor.UI.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="MCEMonitor"
        Width="860"
        Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Interrupteur ON / OFF, repris du bouton Krypton de la version WinForms -->
        <Style x:Key="BoutonBascule" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource AccentSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
      Fenêtre sans bordure, à la manière de MyAutoDNS.

      La transparence (AllowsTransparency) est employée ici parce que la fenêtre
      n'est pas redimensionnable : on y gagne les coins arrondis et l'ombre
      portée, y compris sous Windows 10. La marge de 14 pixels autour du panneau
      est la place laissée à l'ombre.
    -->
    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <!-- Fond commun aux interfaces des modules. L'image est semi-transparente :
                 la base opaque du Border ci-dessus garantit qu'on ne voit jamais le bureau. -->
            <Border CornerRadius="12">
                <Border.Background>
                    <ImageBrush ImageSource="Resources/Images/UI-background.png" Stretch="Fill" />
                </Border.Background>
            </Border>

            <!-- Voile sombre, comme dans les autres interfaces -->
            <Border CornerRadius="12"
                    Background="{StaticResource Fond}"
                    Opacity="0.86" />

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================= En-tête ================= -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">

                <Grid Margin="20,12,10,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'MCEMonitor'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{loc:Tr 'Supervision Media Center'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource BoutonFantome}"
                                Width="32" Height="28" Padding="0" FontSize="13"
                                ToolTip="{loc:Tr 'Réduire'}"
                                Click="SurReduire" />
                        <Button Content="✕"
                                Style="{StaticResource BoutonFantome}"
                                Width="32" Height="28" Padding="0" FontSize="13"
                                ToolTip="{loc:Tr 'Fermer'}"
                                Click="SurFermer" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Onglets ================= -->
            <!-- ================= Bandeau batterie ================= -->
            <Border x:Name="BandeauBatterie"
                    Grid.Row="1"
                    Background="#CC3300"
                    Visibility="Collapsed">
                <TextBlock Text="{loc:Tr 'BatteryWarningBanner'}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="12,7" />
            </Border>

            <TabControl Grid.Row="2" Margin="18,14,18,18">

                <!-- ============ Email ============ -->
                <TabItem x:Name="OngletEmail" Header="{loc:Tr 'Email'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,0,2,2">

                            <!-- Encart d'information -->
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Top"
                                               Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1"
                                               Margin="0"
                                               FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="13"
                                               LineHeight="19"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Email.Aide'}" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{loc:Tr 'Configuration Email', Upper=True}"
                                       Style="{StaticResource TitreSection}"
                                       Margin="0,0,0,10" />

                            <!-- Formulaire : une seule largeur de champ pour que
                                 tous les bords droits s'alignent. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Serveur SMTP -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Serveur SMTP :'}" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         x:Name="ChampSmtpServer"
                                         Margin="0,0,0,8"
                                         VerticalContentAlignment="Center" />

                                <!-- Port -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Port :'}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         x:Name="ChampSmtpPort"
                                         Width="80"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left"
                                         VerticalContentAlignment="Center" />

                                <!-- Adresse expéditeur -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Adresse expéditeur :'}" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         x:Name="ChampExpediteur"
                                         Margin="0,0,0,8"
                                         VerticalContentAlignment="Center" />

                                <!-- Mot de passe : champ + bouton = 340 px, comme les autres -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Mot de passe :'}" />
                                <StackPanel Grid.Row="3" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <Grid Width="250">
                                        <PasswordBox x:Name="ChampMotDePasse"
                                                     VerticalContentAlignment="Center" />
                                        <TextBox x:Name="ChampMotDePasseVisible"
                                                 Visibility="Collapsed"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                    <Button x:Name="BoutonAfficher"
                                            Content="{loc:Tr 'Afficher'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="82"
                                            Height="30"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurAfficherMotDePasse" />
                                </StackPanel>

                                <!-- Destinataire -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Destinataire :'}" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         x:Name="ChampDestinataire"
                                         Margin="0,0,0,8"
                                         VerticalContentAlignment="Center" />

                                <!-- Sécurité -->
                                <TextBlock Grid.Row="5" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Sécurité :'}" />
                                <ComboBox Grid.Row="5" Grid.Column="1"
                                          x:Name="ChoixSecurite"
                                          Width="140"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="SSL" />
                                    <ComboBoxItem Content="TLS" />
                                    <ComboBoxItem Content="STARTTLS" />
                                    <ComboBoxItem Content="NONE" />
                                </ComboBox>
                            </Grid>

                            <!-- Statut du serveur SMTP -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,2,0,12">
                                <TextBlock Style="{StaticResource Libelle}"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Statut du serveur SMTP :'}" />
                                <Ellipse x:Name="PastilleStatut"
                                         Width="11" Height="11"
                                         Margin="10,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource TexteSecondaire}" />
                                <TextBlock x:Name="TexteStatut"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Text="Vérification…" />
                            </StackPanel>

                            <!-- Boutons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BoutonEnregistrer"
                                        Content="{loc:Tr 'Enregistrer configuration'}"
                                        Style="{StaticResource BoutonAccent}"
                                        Width="200" Height="32"
                                        Padding="0"
                                        Click="SurEnregistrerEmail" />
                                <Button x:Name="BoutonTester"
                                        Content="{loc:Tr 'Tester Email'}"
                                        Style="{StaticResource BoutonSecondaire}"
                                        Width="160" Height="32"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        Click="SurTesterEmail" />
                                <TextBlock x:Name="TexteConfirmation"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource Succes}"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Journal du test SMTP : masqué au repos, révélé par le test
                                 (voir SurTesterEmail, qui le rend visible avant d'écrire). -->
                            <Border x:Name="CadreJournal"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                <TextBox x:Name="ZoneJournal"
                                         Style="{StaticResource ZoneLog}"
                                         Height="76"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" />
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ HTTPS ============ -->
                <!-- Onglet inerte pour l instant : il enregistre sa configuration
                     sans rien lancer. Aucun port n est ouvert, aucun binaire demarre. -->
                <TabItem x:Name="OngletHttps" Header="{loc:Tr 'HTTPS'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,0,2,2">

                            <!-- Encart d information -->
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="&#xE774;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{StaticResource Accent}"
                                               VerticalAlignment="Top" Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1" Margin="0" FontStyle="Italic"
                                               TextWrapping="Wrap" Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="13" LineHeight="19" VerticalAlignment="Center"
                                               Text="{loc:Tr 'Permet de joindre les modules depuis n’importe quel navigateur en HTTPS reconnu, sans certificat à installer. Désactivé, rien ne change : les modules restent servis en HTTP sur leurs ports habituels.'}" />
                                </Grid>
                            </Border>

                            <CheckBox x:Name="chkHttpsActif"
                                      Content="{loc:Tr 'Activer l’accès distant (HTTPS)'}"
                                      Foreground="{StaticResource Texte}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,14"
                                      Checked="ChkHttpsActif_Changed"
                                      Unchecked="ChkHttpsActif_Changed" />

                            <!-- ================= Domaine ================= -->
                            <Border x:Name="GroupeHttpsDomaine"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Domaine'}" Style="{StaticResource TitreSection}" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'Nom de domaine :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsDomaine" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>

                                    <!-- Chaque module publié : son sous-domaine, et où la
                                         passerelle doit le joindre. 127.0.0.1 quand le module
                                         tourne sur la même machine, son adresse LAN sinon. -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="{loc:Tr 'Sous-domaine'}"
                                                   Style="{StaticResource Libelle}" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{loc:Tr 'Cible (hôte:port)'}"
                                                   Style="{StaticResource Libelle}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'NetMonitor :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsSousNet" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" Margin="0,0,10,0" />
                                        <TextBox x:Name="txtHttpsCibleNet" Grid.Column="2"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'RomMonitor :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsSousRom" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" Margin="0,0,10,0" />
                                        <TextBox x:Name="txtHttpsCibleRom" Grid.Column="2"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'SystemMonitor :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsSousSystem" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" Margin="0,0,10,0" />
                                        <TextBox x:Name="txtHttpsCibleSystem" Grid.Column="2"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'MediaMonitor :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsSousMedia" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" Margin="0,0,10,0" />
                                        <TextBox x:Name="txtHttpsCibleMedia" Grid.Column="2"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Aide}" Margin="0,4,0,0"
                                               Text="{loc:Tr 'Laissez un sous-domaine vide pour ne pas publier ce module. Exemple de cible : 127.0.0.1:14003, ou 192.168.1.20:8085 pour une autre machine.'}" />

                                    <CheckBox x:Name="chkHttpsDdns"
                                              Content="{loc:Tr 'Mettre à jour l adresse IP des sous-domaines (toutes les 15 minutes)'}"
                                              Foreground="{StaticResource Texte}"
                                              Margin="0,12,0,0" />

                                    <TextBlock Style="{StaticResource Aide}" Margin="0,4,0,0"
                                               Text="{loc:Tr 'Sans cela, un changement d adresse IP publique coupe l accès jusqu à ce qu on la corrige à la main. Remplace le DDNS d Afraid.org.'}" />
                                </StackPanel>
                            </Border>

                            <!-- ================= Certificat ================= -->
                            <Border x:Name="GroupeHttpsCertificat"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Certificat'}" Style="{StaticResource TitreSection}" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'Fournisseur DNS :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <ComboBox x:Name="cmbHttpsFournisseur" Grid.Column="1" Height="22"
                                                  SelectionChanged="CmbHttpsFournisseur_Changed" />
                                    </Grid>

                                    <!-- Champs propres au fournisseur choisi : construits à
                                         l exécution depuis le catalogue, un par variable
                                         d environnement attendue par lego. -->
                                    <StackPanel x:Name="PanneauChampsDns" />

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'Adresse email :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsEmail" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Aide}" Margin="0,4,0,0"
                                               Text="{loc:Tr 'Le jeton est chiffré sur la machine. Il sert à prouver la propriété du domaine, sans ouvrir de port.'}" />

                                    <TextBlock x:Name="txtHttpsAide" Margin="0,0,0,0"
                                               FontSize="11" Foreground="{StaticResource Accent}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- ================= Passerelle ================= -->
                            <Border x:Name="GroupeHttpsPasserelle"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{loc:Tr 'Passerelle'}" Style="{StaticResource TitreSection}" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Tr 'Port d’écoute HTTPS :'}" Style="{StaticResource Libelle}"
                                                   VerticalAlignment="Center" Margin="0" />
                                        <TextBox x:Name="txtHttpsPort" Grid.Column="1"
                                                 Style="{StaticResource ChampParametre}" Text="443" />
                                    </Grid>

                                    <TextBlock x:Name="txtHttpsEtat"
                                               Text="{loc:Tr 'Passerelle à l’arrêt'}"
                                               Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="12" Margin="0,0,0,10" />
                                </StackPanel>
                            </Border>

                            <!-- ============ Commandes, en pied d'onglet ============ -->
                            <!-- Vert pour démarrer, rouge pour arrêter : la couleur dit
                                 l'action, et l'état décide duquel des deux est proposé. -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Button x:Name="BoutonEnregistrerHttps"
                                        Content="{loc:Tr 'Enregistrer ces réglages'}"
                                        Style="{StaticResource BoutonAccent}"
                                        Width="220"
                                        Click="EnregistrerHttps_Click" />

                                <Button x:Name="BoutonDemarrerPasserelle"
                                        Content="{loc:Tr 'Démarrer la passerelle'}"
                                        Style="{StaticResource BoutonSucces}"
                                        Width="200" Margin="10,0,0,0"
                                        Click="DemarrerPasserelle_Click" />

                                <Button x:Name="BoutonArreterPasserelle"
                                        Content="{loc:Tr 'Arrêter la passerelle'}"
                                        Style="{StaticResource BoutonDanger}"
                                        Width="200" Margin="10,0,0,0"
                                        Click="ArreterPasserelle_Click" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============ On/Off ============ -->

                <!-- ============ On/Off ============ -->
                <TabItem x:Name="OngletOnOff" Header="{loc:Tr 'On/Off'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'OnOff.Info'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Arrêt programmé', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Heure (0–23) :'}" />
<Grid Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" x:Name="ChampHeureArret"
                                                 Width="64"
                                                 VerticalContentAlignment="Center" />

                                        <!-- Flèches empilées, collées à la saisie. -->
                                        <Grid Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Content="▲"
                                                    Style="{StaticResource FlecheReglage}"
                                                    Width="20" Height="15" Padding="0"
                                                    Tag="heure+1"
                                                    Click="SurReglerArret" />
                                            <Button Grid.Row="1" Content="▼"
                                                    Style="{StaticResource FlecheReglage}"
                                                    Width="20" Height="15" Padding="0"
                                                    Tag="heure-1"
                                                    Click="SurReglerArret" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Style="{StaticResource Libelle}"
                                               Margin="10,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Minute (0–59) :'}" />
<Grid Grid.Row="0" Grid.Column="3" Margin="8,0,0,10" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0" x:Name="ChampMinuteArret"
                                                 Width="64"
                                                 VerticalContentAlignment="Center" />

                                        <!-- Flèches empilées, collées à la saisie. -->
                                        <Grid Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button Grid.Row="0" Content="▲"
                                                    Style="{StaticResource FlecheReglage}"
                                                    Width="20" Height="15" Padding="0"
                                                    Tag="minute+1"
                                                    Click="SurReglerArret" />
                                            <Button Grid.Row="1" Content="▼"
                                                    Style="{StaticResource FlecheReglage}"
                                                    Width="20" Height="15" Padding="0"
                                                    Tag="minute-1"
                                                    Click="SurReglerArret" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'OnOff.Type'}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              x:Name="ChoixTypeArret"
                                              Width="160" Margin="8,0,0,10"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Grid.ColumnSpan="2">
                                        <ComboBoxItem Content="{loc:Tr 'Arrêt'}" />
                                        <ComboBoxItem Content="{loc:Tr 'Veille'}" />
                                    </ComboBox>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Button x:Name="BoutonSauvegarderArret"
                                            Content="{loc:Tr 'Sauvegarder'}"
                                            Style="{StaticResource BoutonAccent}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurSauvegarderArret" />
                                    <Button x:Name="BoutonAutomatiqueArret"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurAutomatisationArret" />
                                </StackPanel>

                                <TextBlock x:Name="MessageOnOff"
                                           Margin="0,10,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{loc:Tr 'Démarrage automatique (Wake-on-LAN)', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="4"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <TextBlock FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Text="{loc:Tr 'Pour démarrer votre machine automatiquement, vous devrez utiliser la méthode Wake-on-LAN. Vous devez activer la fonctionnalité dans le BIOS, mais aussi dans le gestionnaire de périphériques de Windows. Si vous ne souhaitez pas utiliser le WOL, vous devrez démarrer votre machine manuellement.'}" />
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============ MediaMonitor ============ -->
                <TabItem x:Name="OngletMedia" Header="{loc:Tr 'MediaMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Encart d'information -->
                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Media.Description'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation MediaMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <!-- Service et automatisation -->
                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <!-- Interrupteur du service -->
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BasculeService"
                                                  Content="ON / OFF"
                                                  Style="{StaticResource BoutonBascule}"
                                                  Width="90" Height="28"
                                                  Click="SurBasculeService" />
                                    <TextBlock x:Name="TexteEtatService"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Texte}"
                                               Text="{loc:Tr 'Service MediaMonitor'}" />
                                </StackPanel>

                                <!-- Rapports -->
                                <TextBlock x:Name="TexteProchainRapport"
                                           Margin="0,14,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Text="" />
                                <TextBlock x:Name="TexteDernierRapport"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           Text="" />

                                <!-- Actions -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Button x:Name="BoutonAutomatique"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationMedia" />
                                    <Button x:Name="BoutonOuvrirMedia"
                                            Content="{loc:Tr 'Ouvrir MediaMonitor'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurOuvrirMediaUI" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Message d'état des actions -->
                        <TextBlock Grid.Row="3"
                                   x:Name="MessageMedia"
                                   Margin="0,14,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Visibility="Collapsed" />
                    </Grid>
                </TabItem>

                <!-- ============ RomMonitor ============ -->
                <TabItem x:Name="OngletRom" Header="{loc:Tr 'RomMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Encart d'information -->
                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Rom.Info'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation RomMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <!-- Service et automatisation -->
                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BasculeServiceRom"
                                                  Content="ON / OFF"
                                                  Style="{StaticResource BoutonBascule}"
                                                  Width="90" Height="28"
                                                  Click="SurBasculeServiceRom" />
                                    <TextBlock x:Name="TexteEtatServiceRom"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Texte}"
                                               Text="{loc:Tr 'Service RomMonitor'}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,14,0,0">
                                    <Button x:Name="BoutonAutomatiqueRom"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationRom" />
                                    <Button x:Name="BoutonOuvrirRom"
                                            Content="{loc:Tr 'Ouvrir RomMonitor'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurOuvrirRomUI" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{loc:Tr 'Réglages', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <!-- Réglages du service -->
                        <Border Grid.Row="4"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <!-- Colonnes de libellés larges : les champs sont poussés
                                         vers la droite pour laisser de la place aux énoncés
                                         des cases à cocher. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Fréquence de contrôle (min) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="0" Grid.Column="1"
                                             x:Name="ChampRomIntervalle"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Style="{StaticResource Libelle}"
                                               Margin="10,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Intervalle des alertes (h) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="0" Grid.Column="3"
                                             x:Name="ChampRomDelai"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Seuil de danger (% libre) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="1" Grid.Column="1"
                                             x:Name="ChampRomSeuilDanger"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Seuil critique (% libre) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="2" Grid.Column="1"
                                             x:Name="ChampRomSeuilCritique"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <!-- Surcharge disque : colonnes 2-3 libres des lignes 1 et 2 -->
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource Libelle}"
                                               Margin="10,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Surcharge disque (% occupé) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="1" Grid.Column="3"
                                             x:Name="ChampRomIoSeuil"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="2" Grid.Column="2"
                                               Style="{StaticResource Libelle}"
                                               Margin="10,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Surcharge critique (%) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="2" Grid.Column="3"
                                             x:Name="ChampRomIoCritique"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                               Style="{StaticResource Libelle}"
                                               Margin="0,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Mesure (s) :'}" />
                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="3" Grid.Column="1"
                                             x:Name="ChampRomIoIntervalle"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Row="3" Grid.Column="2"
                                               Style="{StaticResource Libelle}"
                                               Margin="10,0,0,10"
                                               VerticalAlignment="Center"
                                               Text="{loc:Tr 'Relevés consécutifs :'}" />
                                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                              x:Name="CaseRomSmart"
                                              Content="{loc:Tr 'Alerte email : Défaillance SMART et capacité'}"
                                              Margin="0,6,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="True" />

                                    <CheckBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2"
                                              x:Name="CaseRomIo"
                                              Content="{loc:Tr 'Alerte email : surcharge disque (lecture / écriture)'}"
                                              Margin="10,6,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="True" />

                                    <TextBox Style="{StaticResource ChampParametre}" Grid.Row="3" Grid.Column="3"
                                             x:Name="ChampRomIoReleves"
                                             Margin="0,0,0,10"
                                             HorizontalAlignment="Left"
                                             Width="70"
                                             VerticalContentAlignment="Center" />
                                </Grid>


                            </StackPanel>
                        </Border>

                        <!-- Validation -->
                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button x:Name="BoutonEnregistrerRom"
                                    Content="{loc:Tr 'Enregistrer les réglages'}"
                                    Style="{StaticResource BoutonAccent}"
                                    Width="200" Height="32"
                                    Padding="0"
                                    Click="SurEnregistrerReglagesRom" />
                            <TextBlock x:Name="MessageRom"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ============ SystemMonitor ============ -->
                <TabItem x:Name="OngletSystem" Header="{loc:Tr 'SystemMonitor'}">
                    <Grid Margin="2,0,2,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Top"
                                           Margin="0,0,10,0" />

                                <TextBlock Grid.Column="1"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="13"
                                           LineHeight="19"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Sys.Description'}" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{loc:Tr 'Automatisation SystemMonitor', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="2"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BasculeServiceSystem"
                                                  Content="ON / OFF"
                                                  Style="{StaticResource BoutonBascule}"
                                                  Width="90" Height="28"
                                                  Click="SurBasculeServiceSystem" />
                                    <TextBlock x:Name="TexteEtatServiceSystem"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Texte}"
                                               Text="{loc:Tr 'Service SystemMonitor'}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button x:Name="BoutonAutomatiqueSystem"
                                            Content="{loc:Tr 'Automatique OFF'}"
                                            Style="{StaticResource BoutonDanger}"
                                            Width="190" Height="32"
                                            Padding="0"
                                            Click="SurAutomatisationSystem" />
                                    <Button x:Name="BoutonOuvrirSystem"
                                            Content="{loc:Tr 'Ouvrir SystemMonitor'}"
                                            Style="{StaticResource BoutonSecondaire}"
                                            Width="190" Height="32"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            Click="SurOuvrirSystemUI" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Text="{loc:Tr 'Réglages', Upper=True}"
                                   Style="{StaticResource TitreSection}"
                                   Margin="0,0,0,8" />

                        <Border Grid.Row="4"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,14"
                                VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fréquence et délai des alertes -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource Libelle}"
                                           Margin="0,0,0,8"
                                           VerticalAlignment="Center"
                                           Text="{loc:Tr 'Fréquence de contrôle (s) :'}" />
                                <TextBox Style="{StaticResource ChampParametre}" Grid.Row="0" Grid.Column="1"
                                         x:Name="ChampSystemIntervalle"
                                         Margin="0,0,0,8"
                                         HorizontalAlignment="Left" Width="70"
                                         VerticalContentAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource Libelle}"
                                           Margin="10,0,0,12"
