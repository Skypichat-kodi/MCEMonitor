<Window x:Class="MCEMonitor.UI.FenetreConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="MCEMonitor"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock x:Name="TexteTitre"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Message -->
            <Grid Grid.Row="1" Margin="20,18,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Icone"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           VerticalAlignment="Top"
                           Margin="0,0,14,0"
                           Text="&#xE946;" />

                <TextBlock x:Name="TexteMessage"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Boutons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,20,20,18">
                <Button x:Name="BoutonNon"
                        Style="{StaticResource BoutonSecondaire}"
                        Width="130" Height="32"
                        Padding="0"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="SurNon" />
                <Button x:Name="BoutonOui"
                        Style="{StaticResource BoutonAccent}"
                        Width="130" Height="32"
                        Padding="0"
                        Click="SurOui" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
