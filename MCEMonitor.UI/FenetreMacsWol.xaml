<Window x:Class="MCEMonitor.UI.FenetreMacsWol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="MAC autorisées"
        Width="560"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- Fenêtre secondaire, même habillage que la fenêtre principale -->
    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'MAC autorisées pour le Wake-on-LAN'}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr 'Seules ces adresses peuvent être réveillées à distance.'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Liste -->
            <Grid Grid.Row="1" Margin="18,16,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ListeMacs" Grid.Row="0" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <!-- Le champ porte lui-même son indication : exemple grisé quand il est
                         vide, message d'erreur en rouge si la saisie est refusée. -->
                    <Grid Width="230">
                        <TextBox x:Name="ChampMac"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SurSaisieMac" />
                        <TextBlock x:Name="IndiceMac"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Text="{loc:Tr 'Exemple : AA:BB:CC:DD:EE:FF'}" />
                    </Grid>

                    <Button Content="{loc:Tr 'Ajouter'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="120" Height="30"
                            Margin="8,0,0,0" Padding="0"
                            Click="SurAjouter" />
                    <Button Content="{loc:Tr 'Supprimer'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="120" Height="30"
                            Margin="8,0,0,0" Padding="0"
                            Click="SurSupprimer" />
                </StackPanel>
            </Grid>

            <!-- Pied -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,16,18,18">
                <TextBlock x:Name="TexteNombre"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="11"
                           Foreground="{StaticResource TexteSecondaire}"
                           Text="" />
                <Button Content="{loc:Tr 'Fermer'}"
                        Style="{StaticResource BoutonAccent}"
                        Width="130" Height="32"
                        Padding="0"
                        Click="SurFermer" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
