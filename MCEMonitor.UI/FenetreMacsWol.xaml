<Window x:Class="MCEMonitor.UI.FenetreMacsWol"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Machines à réveiller'}"
        Width="560"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">


    <!-- Fenêtre secondaire, même habillage que la fenêtre principale -->
    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr 'Machines à réveiller (Wake-on-LAN)'}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Tr 'Ces adresses recevront un paquet magique à l’heure programmée ci-dessous.'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Liste -->
            <Grid Grid.Row="1" Margin="18,16,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox x:Name="ListeMacs" Grid.Row="0" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                    <!-- Le champ porte lui-même son indication : exemple grisé quand il est
                         vide, message d'erreur en rouge si la saisie est refusée. -->
                    <Grid Width="230">
                        <TextBox x:Name="ChampMac"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SurSaisieMac" />
                        <TextBlock x:Name="IndiceMac"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Text="{loc:Tr 'Exemple : AA:BB:CC:DD:EE:FF'}" />
                    </Grid>

                    <Button Content="{loc:Tr 'Ajouter'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="120" Height="30"
                            Margin="8,0,0,0" Padding="0"
                            Click="SurAjouter" />
                    <Button Content="{loc:Tr 'Supprimer'}"
                            Style="{StaticResource BoutonSecondaire}"
                            Width="120" Height="30"
                            Margin="8,0,0,0" Padding="0"
                            Click="SurSupprimer" />
                </StackPanel>

                <!-- Réveil programmé : la tâche Windows lance WakeMonitor.exe en mode
                     envoi, à l heure choisie. -->
                <Border Grid.Row="2"
                        Background="{StaticResource Fond}"
                        BorderBrush="{StaticResource Bordure}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="CaseReveilProgramme"
                                      Content="{loc:Tr 'Activer le réveil programmé'}"
                                      Foreground="{StaticResource Texte}"
                                      VerticalAlignment="Center"
                                      Click="SurChangementPlanification" />

                            <TextBlock Text="{loc:Tr 'Heure :'}"
                                       Margin="20,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TexteSecondaire}" />

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="ChampHeure"
                                         Width="64"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SurChangementPlanification" />

                                <!-- Flèches empilées, collées à la saisie : un seul bloc. -->
                                <Grid Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲"
                                            Style="{StaticResource FlecheReglage}"
                                            Width="20" Height="15" Padding="0"
                                            Tag="heure+1"
                                            Click="SurReglerHeure" />
                                    <Button Grid.Row="1" Content="▼"
                                            Style="{StaticResource FlecheReglage}"
                                            Width="20" Height="15" Padding="0"
                                            Tag="heure-1"
                                            Click="SurReglerHeure" />
                                </Grid>
                            </Grid>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" x:Name="ChampMinute"
                                         Width="64"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SurChangementPlanification" />

                                <!-- Flèches empilées, collées à la saisie : un seul bloc. -->
                                <Grid Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Content="▲"
                                            Style="{StaticResource FlecheReglage}"
                                            Width="20" Height="15" Padding="0"
                                            Tag="minute+1"
                                            Click="SurReglerHeure" />
                                    <Button Grid.Row="1" Content="▼"
                                            Style="{StaticResource FlecheReglage}"
                                            Width="20" Height="15" Padding="0"
                                            Tag="minute-1"
                                            Click="SurReglerHeure" />
                                </Grid>
                            </Grid>

                        </StackPanel>

                        <TextBlock x:Name="TextePlanification"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TexteSecondaire}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pied -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,16,18,18">
                <TextBlock x:Name="TexteNombre"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontSize="11"
                           Foreground="{StaticResource TexteSecondaire}"
                           Text="" />
                <Button Content="{loc:Tr 'Appliquer'}"
                        Style="{StaticResource BoutonSecondaire}"
                        Width="130" Height="32"
                        Margin="0,0,8,0"
                        Padding="0"
                        Click="SurAppliquerPlanification" />
                <Button Content="{loc:Tr 'Fermer'}"
                        Style="{StaticResource BoutonAccent}"
                        Width="130" Height="32"
                        Padding="0"
                        Click="SurFermer" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
