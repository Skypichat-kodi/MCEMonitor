<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème sombre, proche de Windows 11, accent bleu profond. -->
    <!-- Remplacer ce dictionnaire par Themes/Clair.xaml suffit à changer tout le thème :
         les styles et les fenêtres ne référencent que les clés définies ici. -->
        <Color x:Key="CouleurFond">#FF1B1B1B</Color>
        <Color x:Key="CouleurSurface">#FF262626</Color>
        <Color x:Key="CouleurSurfaceSurvol">#FF303030</Color>
        <Color x:Key="CouleurSurfaceActive">#FF3A3A3A</Color>
        <Color x:Key="CouleurBordure">#FF3D3D3D</Color>
        <Color x:Key="CouleurTexte">#FFF2F2F2</Color>
        <Color x:Key="CouleurTexteSecondaire">#FFA0A0A0</Color>
        <Color x:Key="CouleurAccent">#FF0078D4</Color>
        <Color x:Key="CouleurAccentSurvol">#FF1B8AE0</Color>
        <Color x:Key="CouleurAccentPresse">#FF0067B8</Color>
        <Color x:Key="CouleurSucces">#FF3FB950</Color>
        <Color x:Key="CouleurSuccesSurvol">#FF4ECD60</Color>
        <Color x:Key="CouleurSuccesPresse">#FF35A045</Color>
        <Color x:Key="CouleurErreur">#FFFF5B5B</Color>
        <Color x:Key="CouleurErreurSurvol">#FFFF7A7A</Color>
        <Color x:Key="CouleurErreurPresse">#FFE04545</Color>

        <SolidColorBrush x:Key="Fond" Color="{StaticResource CouleurFond}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource CouleurSurface}" />
        <SolidColorBrush x:Key="SurfaceSurvol" Color="{StaticResource CouleurSurfaceSurvol}" />
        <SolidColorBrush x:Key="SurfaceActive" Color="{StaticResource CouleurSurfaceActive}" />
        <SolidColorBrush x:Key="Bordure" Color="{StaticResource CouleurBordure}" />
        <SolidColorBrush x:Key="Texte" Color="{StaticResource CouleurTexte}" />
        <SolidColorBrush x:Key="TexteSecondaire" Color="{StaticResource CouleurTexteSecondaire}" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource CouleurAccent}" />
        <SolidColorBrush x:Key="AccentSurvol" Color="{StaticResource CouleurAccentSurvol}" />
        <SolidColorBrush x:Key="AccentPresse" Color="{StaticResource CouleurAccentPresse}" />
        <SolidColorBrush x:Key="Succes" Color="{StaticResource CouleurSucces}" />
        <SolidColorBrush x:Key="SuccesSurvol" Color="{StaticResource CouleurSuccesSurvol}" />
        <SolidColorBrush x:Key="SuccesPresse" Color="{StaticResource CouleurSuccesPresse}" />
        <SolidColorBrush x:Key="Erreur" Color="{StaticResource CouleurErreur}" />
        <SolidColorBrush x:Key="ErreurSurvol" Color="{StaticResource CouleurErreurSurvol}" />
        <SolidColorBrush x:Key="ErreurPresse" Color="{StaticResource CouleurErreurPresse}" />

        <!-- Fond des zones de journal (texte défilant) : volontairement plus sombre
             que la surface, pour détacher le bloc du reste de la fenêtre. -->
        <Color x:Key="CouleurFondZoneLog">#FF141414</Color>
        <SolidColorBrush x:Key="FondZoneLog" Color="{StaticResource CouleurFondZoneLog}" />

        <!-- Pastilles des catégories de blocage automatique (onglet NetMonitor).
             Mêmes valeurs que dans NetMonitor.UI, pour que la coche d'une catégorie
             ait la même couleur dans les deux interfaces. -->
        <SolidColorBrush x:Key="PastilleCritique" Color="#FFFF5B5B" />
        <SolidColorBrush x:Key="PastilleInconnue" Color="#FFFFB900" />
        <SolidColorBrush x:Key="PastilleScanner"  Color="#FF3FB950" />
        <SolidColorBrush x:Key="PastilleRobot"    Color="#FF5BC0EB" />
        <SolidColorBrush x:Key="PastilleCrawler"  Color="#FF1E88E5" />
</ResourceDictionary>
