<Window x:Class="MCEMonitor.UI.FenetreTelechargement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="MCEMonitor"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock Text="{loc:Tr 'Téléchargement de lego'}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- Corps -->
            <StackPanel Grid.Row="1" Margin="20,18,20,0">
                <TextBlock x:Name="TexteExplication"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TexteSecondaire}"
                           FontSize="12"
                           LineHeight="18"
                           Text="{loc:Tr 'L obtention du certificat demande lego, l outil qui dialogue avec les fournisseurs DNS. Il n est pas livré avec MCEMonitor : il est téléchargé depuis la dernière version publiée par ses auteurs, puis installé ici. Cette opération ne se produit qu une fois, et seulement si l accès distant est utilisé.'}" />

                <ProgressBar x:Name="BarreProgression"
                             Height="14"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Margin="0,16,0,8"
                             Background="{StaticResource Surface}"
                             Foreground="{StaticResource Accent}"
                             BorderBrush="{StaticResource Bordure}" />

                <TextBlock x:Name="TexteEtat"
                           Text="{loc:Tr 'En attente…'}"
                           FontSize="12"
                           Foreground="{StaticResource TexteSecondaire}" />
            </StackPanel>

            <!-- Pied -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,18,20,18">
                <Button x:Name="BoutonAnnuler"
                        Content="{loc:Tr 'Annuler'}"
                        Style="{StaticResource BoutonSecondaire}"
                        Width="130"
                        Click="SurAnnuler" />
                <Button x:Name="BoutonFermer"
                        Content="{loc:Tr 'Fermer'}"
                        Style="{StaticResource BoutonAccent}"
                        Width="130"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Click="SurFermer" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
