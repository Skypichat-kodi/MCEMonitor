<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RomMonitor.Tray</AssemblyName>
    <RootNamespace>RomMonitor.Tray</RootNamespace>
    <Platforms>x64</Platforms>
    <ApplicationIcon>RomMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- On retire l'inclusion implicite -->
  <ItemGroup>
    <None Remove="RomMonitor.ico" />
    <None Remove="romok.png" />
    <None Remove="hdd-critical.png" />
  </ItemGroup>

  <!-- On les embarque dans l'assembly -->
  <ItemGroup>
    <EmbeddedResource Include="RomMonitor.ico" LogicalName="RomMonitor.ico" />
    <EmbeddedResource Include="romok.png"        LogicalName="romok.png" />
    <EmbeddedResource Include="hdd-critical.png" LogicalName="hdd-critical.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MCEMonitor.Languages\MCEMonitor.Languages.csproj" />
  </ItemGroup>

</Project>