<Window x:Class="RomMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaMonitor.Core.Language;assembly=MCEMonitor.Languages"
        Title="RomMonitor"
        Height="750"
        Width="1100">

    <Window.Resources>

        <!-- Couleurs Windows 11 Dark -->
        <SolidColorBrush x:Key="Win11Background" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Win11Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Win11Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Win11Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#553A8DFF"/>

        <!-- Style en-têtes de colonnes -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Style des cellules -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style des lignes -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ScrollBars sombres -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#3C3C3C"/>
        </Style>

        <!-- Style des boutons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Style TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5E5"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Barre titre -->
            <RowDefinition Height="Auto"/>   <!-- Serveur Web -->
            <RowDefinition Height="Auto"/>   <!-- Boutons -->
            <RowDefinition Height="3*"/>     <!-- Tableau disques -->
            <RowDefinition Height="Auto"/>   <!-- Titre alertes -->
            <RowDefinition Height="2*"/>     <!-- Tableau alertes -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Fond sombre -->
        <Rectangle Fill="#1E1E1E" Grid.RowSpan="7"/>

        <!-- Overlay background -->
        <Rectangle Grid.RowSpan="7">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Resources/Images/UI-background.png" Stretch="Fill"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============================================================ -->
        <!--  BARRE TITRE                                                  -->
        <!-- ============================================================ -->
        <TextBlock Grid.Row="0"
                   Text="RomMonitor"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#4CC2FF"
                   Margin="15,12,0,8"/>

        <!-- ============================================================ -->
        <!--  SERVEUR WEB                                                  -->
        <!-- ============================================================ -->
        <GroupBox Grid.Row="1"
                  Margin="15,0,15,10"
                  Padding="10"
                  Header="{loc:Tr 'Serveur Web'}"
                  Background="{StaticResource PanelBackground}"
                  BorderBrush="{StaticResource Win11Border}"
                  Foreground="{StaticResource Win11Text}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ZONE 1 : Config (gauche) -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Switch ON/OFF -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{loc:Tr 'Activer le serveur Web'}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ToggleButton x:Name="ToggleWeb"
                                      Width="40"
                                      Height="20"
                                      Checked="ToggleWeb_Checked"
                                      Unchecked="ToggleWeb_Unchecked">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="40" Height="20">
                                                    <Border x:Name="SwitchBackground"
                                                            CornerRadius="10"
                                                            Background="#3C3C3C"/>
                                                    <Ellipse x:Name="SwitchThumb"
                                                             Width="16" Height="16"
                                                             Margin="2"
                                                             Fill="#E5E5E5"
                                                             HorizontalAlignment="Left"/>
                                                </Grid>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="SwitchBackground"
                                                                Property="Background"
                                                                Value="#4CC2FF"/>
                                                        <Setter TargetName="SwitchThumb"
                                                                Property="HorizontalAlignment"
                                                                Value="Right"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr 'Port :'}" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebPort"
                                 Width="200"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <!-- Login -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr 'Login :'}" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtWebLogin"
                                 Width="200"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"/>
                    </StackPanel>

                    <!-- Mot de passe -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="177"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{loc:Tr 'Mot de passe :'}"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"/>

                        <PasswordBox x:Name="txtWebPassword"
                                     Grid.Column="1"
                                     Width="177"
                                     Background="#1E1E1E"
                                     Foreground="#E5E5E5"
                                     BorderBrush="#3C3C3C"
                                     Visibility="Visible"/>

                        <TextBox x:Name="txtWebPasswordVisible"
                                 Grid.Column="1"
                                 Width="177"
                                 Background="#1E1E1E"
                                 Foreground="#E5E5E5"
                                 BorderBrush="#3C3C3C"
                                 Visibility="Collapsed"/>

                        <Button x:Name="btnShowWebPassword"
                                Grid.Column="2"
                                Width="22"
                                Height="22"
                                Margin="6,0,0,0"
                                Padding="0"
                                Click="btnShowWebPassword_Click"
                                Background="#2D2D30"
                                BorderBrush="#3C3C3C"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Image x:Name="imgWebEye"
                                   Width="14"
                                   Height="14"
                                   Source="/Resources/Icons/eye.png"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ZONE 2 : Boutons (droite) -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                    <Button Content="{loc:Tr 'Appliquer'}"
                            Width="150"
                            Height="28"
                            Margin="0,0,0,8"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Click="btnApplyWeb_Click"/>

                    <Button Content="{loc:Tr 'Ouvrir dans le navigateur'}"
                            Width="220"
                            Height="28"
                            Padding="0"
                            VerticalContentAlignment="Center"
                            Click="btnOpenWeb_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ============================================================ -->
        <!--  BOUTONS                                                      -->
        <!-- ============================================================ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15,0,15,10">
            <Button Width="140" Margin="0,0,10,0" Click="Refresh_Click">
                <TextBlock Text="{loc:Tr 'Rafraîchir'}"/>
            </Button>
            <Button Width="140" Margin="0,0,10,0" Click="OpenLogs_Click">
                <TextBlock Text="{loc:Tr 'Dossier Logs'}"/>
            </Button>
            <Button Width="140" Margin="0,0,10,0" Click="OpenHistory_Click">
                <TextBlock Text="{loc:Tr 'Historique'}"/>
            </Button>
        </StackPanel>

        <!-- ============================================================ -->
        <!--  TABLEAU DISQUES                                              -->
        <!-- ============================================================ -->
        <DataGrid x:Name="DisksGrid"
                  Grid.Row="3"
                  Margin="15,0,15,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <!-- Nom disque -->
                <DataGridTextColumn Header="{loc:Tr 'Disque'}"
                                    Binding="{Binding Name}"
                                    Width="55"/>

                <!-- Label -->
                <DataGridTextColumn Header="{loc:Tr 'Nom'}"
                                    Binding="{Binding Label}"
                                    Width="120"/>

                <!-- Type -->
                <DataGridTextColumn Header="{loc:Tr 'Type'}"
                                    Binding="{Binding DriveType}"
                                    Width="90"/>

                <!-- Taille -->
                <DataGridTextColumn Header="{loc:Tr 'Taille'}"
                                    Binding="{Binding TotalGoText}"
                                    Width="90"/>

                <!-- Libre -->
                <DataGridTextColumn Header="{loc:Tr 'Libre'}"
                                    Binding="{Binding FreeGoText}"
                                    Width="90"/>

                <!-- % libre avec barre -->
                <DataGridTemplateColumn Header="{loc:Tr 'Espace'}" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar Grid.Column="0"
                                             Height="16"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding UsedPercent, Mode=OneWay}"
                                             Foreground="{Binding StatusBrush}"
                                             Background="#2D2D30"
                                             BorderBrush="#3C3C3C"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding FreePercentText}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           FontSize="12"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- SMART status -->
                <DataGridTemplateColumn Header="{loc:Tr 'SMART'}" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding SmartBadgeBrush}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    HorizontalAlignment="Center"
                                    Margin="4,0">
                                <TextBlock Text="{Binding SmartStatusText}"
                                           Foreground="Black"
                                           FontWeight="Bold"
                                           FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Modèle -->
                <DataGridTextColumn Header="{loc:Tr 'Modèle'}"
                                    Binding="{Binding SmartModel}"
                                    Width="3*"/>

                <!-- Raison -->
                <DataGridTemplateColumn Header="{loc:Tr 'État'}" Width="4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SmartReasonText}"
                                       Foreground="{Binding SmartBadgeBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Température -->
                <DataGridTemplateColumn Header="{loc:Tr 'Temp.'}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TemperatureText}"
                                       Foreground="{Binding TemperatureBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ============================================================ -->
        <!--  TITRE ALERTES                                                -->
        <!-- ============================================================ -->
        <TextBlock Grid.Row="4"
                   Text="{loc:Tr 'Alertes récentes'}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#4CC2FF"
                   Margin="15,15,0,5"/>

        <!-- ============================================================ -->
        <!--  TABLEAU ALERTES                                              -->
        <!-- ============================================================ -->
        <DataGrid x:Name="AlertsGrid"
                  Grid.Row="5"
                  Margin="15,0,15,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn Header="{loc:Tr 'Heure'}"
                                    Binding="{Binding TimeText}"
                                    Width="140"/>

                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Icône Warning (par défaut) -->
                                <Image x:Name="imgSeverity"
                                       Width="20"
                                       Height="20"
                                       Source="/Resources/Icons/warning.png"/>

                                <!-- Si Critical → on change l'icône -->
                                <Image x:Name="imgSeverityCritical"
                                       Width="20"
                                       Height="20"
                                       Source="/Resources/Icons/critical.png"
                                       Visibility="Collapsed"/>
                            </Grid>

                            <DataTemplate.Triggers>
                                <!-- Si Critical → afficher critical, cacher warning -->
                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                    <Setter TargetName="imgSeverity" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="imgSeverityCritical" Property="Visibility" Value="Visible"/>
                                </DataTrigger>

                                <!-- Si autre chose que Warning/Critical (Info) → cacher warning aussi -->
                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                    <Setter TargetName="imgSeverity" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{loc:Tr 'Cible'}"
                                    Binding="{Binding Target}"
                                    Width="2*"/>

                <DataGridTextColumn Header="{loc:Tr 'Message'}"
                                    Binding="{Binding Message}"
                                    Width="4*"/>

                <DataGridTemplateColumn Header="{loc:Tr 'Email'}" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="16"
                                   Height="16"
                                   Source="/Resources/Icons/email.png"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding EmailSent, Converter={StaticResource BoolToVisibility}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ============================================================ -->
        <!--  STATUS BAR                                                   -->
        <!-- ============================================================ -->
        <Border Grid.Row="6"
                Background="#252526"
                BorderBrush="#3C3C3C"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="15,6">
            <StackPanel Orientation="Horizontal">
                <!-- 🆕 Icône d'état (cachée par défaut) -->
                <Image x:Name="imgStatusIcon"
                       Width="16"
                       Height="16"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

                <TextBlock x:Name="StatusText"
                           Text="..."
                           FontSize="12"
                           Foreground="#B4B4B4"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
    </Grid>
</Window>