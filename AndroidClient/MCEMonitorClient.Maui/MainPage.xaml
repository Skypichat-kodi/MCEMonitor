<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MCEMonitorClient.Maui.Converters"
             x:Class="MCEMonitorClient.Maui.MainPage"
             Title="Serveurs">

    <!-- Fond de page : dégradé sombre bleuté, en harmonie avec la couleur d'accent.
         Le gris uniforme donnait une page plate. -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1A1E" Offset="0.0" />
            <GradientStop Color="#14212B" Offset="0.55" />
            <GradientStop Color="#101820" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="12">

        <!-- Titre + état du service -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Serveurs surveillés"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#4CC2FF" />
            <Label x:Name="lblServiceStatus"
                   Text="Service arrêté"
                   FontSize="12"
                   TextColor="#888888" />
        </VerticalStackLayout>

        <!-- Version de l'application en haut à droite -->
        <Label Grid.Column="1"
               x:Name="lblAppVersion"
               Text="v0.0.0"
               FontSize="11"
               TextColor="#666666"
               VerticalOptions="Start"
               HorizontalOptions="End" />

        <!-- Liste des serveurs -->
        <CollectionView Grid.Row="1"
                        x:Name="serversList"
                        SelectionMode="Single"
                        SelectionChanged="OnServerSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="12" StrokeShape="RoundRectangle 8"
                            BackgroundColor="#252526" Stroke="#3C3C3C" StrokeThickness="1">
                        <!-- La sélection prenait le fond orange par défaut de MAUI. On lui
                             préfère un relief : bordure d'accent et ombre portée, le fond
                             reste celui de la carte. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#3C3C3C" />
                                        <Setter Property="Shadow">
                                            <Setter.Value>
                                                <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.25" />
                                            </Setter.Value>
                                        </Setter>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="Stroke" Value="#4CC2FF" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="Shadow">
                                            <Setter.Value>
                                                <Shadow Brush="#4CC2FF" Offset="0,5" Radius="14" Opacity="0.45" />
                                            </Setter.Value>
                                        </Setter>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnServerTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Grid.Column="0"
                                     WidthRequest="14"
                                     HeightRequest="14"
                                     Fill="{Binding StatusColor}"
                                     VerticalOptions="Center"
                                     Margin="0,0,12,0" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#E5E5E5" />
                                <Label Text="{Binding FullUrl}"
                                       FontSize="12"
                                       TextColor="#B4B4B4" />
                                <Label Text="{Binding ServiceType}"
                                       FontSize="11"
                                       TextColor="#888888" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{Binding EnabledText}"
                                   FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="#B4B4B4" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ligne 2 : Ajouter + Options -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Ajouter"
                    BackgroundColor="#4CC2FF"
                    TextColor="Black"
                    FontAttributes="Bold"
                    Clicked="OnAddClicked" />
            <Button Grid.Column="1"
                    Text="Options"
                    BackgroundColor="#3C3C3C"
                    TextColor="#E5E5E5"
                    Clicked="OnOptionsClicked" />
        </Grid>

        <!-- Ligne 3 : Démarrer/Arrêter -->
        <Button Grid.Row="3"
                x:Name="btnToggleService"
                Text="Démarrer"
                BackgroundColor="#4CAF50"
                TextColor="White"
                FontAttributes="Bold"
                Clicked="OnToggleServiceClicked" />

    </Grid>

</ContentPage>