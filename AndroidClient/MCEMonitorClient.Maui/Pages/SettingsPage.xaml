<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MCEMonitorClient.Maui.Pages.SettingsPage"
             Title="Options"
             BackgroundColor="#1E1E1E">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="Options"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="#4CC2FF" />

        <Label Text="Intervalle de polling (secondes)" TextColor="#B4B4B4" />
        <Entry x:Name="txtInterval"
               Keyboard="Numeric"
               TextColor="#E5E5E5"
               BackgroundColor="#252526" />

        <HorizontalStackLayout Spacing="8">
            <Switch x:Name="swNotify" />
            <Label Text="Notifier les changements d'état"
                   TextColor="#B4B4B4"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="8">
            <Switch x:Name="swSound" />
            <Label Text="Son sur alerte critique"
                   TextColor="#B4B4B4"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,20,0,0">
            <Button Grid.Column="0"
                    Text="Annuler"
                    BackgroundColor="#3C3C3C"
                    TextColor="#E5E5E5"
                    Clicked="OnCancelClicked" />
            <Button Grid.Column="1"
                    Text="Enregistrer"
                    BackgroundColor="#4CC2FF"
                    TextColor="Black"
                    FontAttributes="Bold"
                    Clicked="OnSaveClicked" />
        </Grid>

    </VerticalStackLayout>

</ContentPage>