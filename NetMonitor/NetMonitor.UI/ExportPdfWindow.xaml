<Window x:Class="NetMonitor.UI.ExportPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Exporter un rapport PDF'}"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Styles locaux : NetMonitor.UI ne definit pas de styles de bouton
             partages, chaque fenetre porte les siens (voir FenetreDialogue). -->
        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonAccent" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="{StaticResource Accent}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonFantome" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock Text="{loc:Tr 'Exporter un rapport PDF'}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold" />

                    <Button Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurAnnuler" />
                </Grid>
            </Border>

            <!-- Choix des sections -->
            <StackPanel Grid.Row="1" Margin="20,18,20,0">
                <TextBlock Text="{loc:Tr 'Choisissez les sections à inclure. Le rapport est au format paysage.'}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource TexteSecondaire}"
                           Margin="0,0,0,14" />

                <CheckBox x:Name="CaseStatistiques"  IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Statistiques et graphiques'}" />
                <CheckBox x:Name="CaseCarte"         IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Carte des pays d’origine'}" />
                <CheckBox x:Name="CaseBloquees"     IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'IP et processus bloqués'}" />
                <CheckBox x:Name="CaseInterceptions" IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Tentatives sur IP bloquée'}" />
                <CheckBox x:Name="CaseHistorique"    IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Historique des intrusions'}" />
                <CheckBox x:Name="CaseAudit"         IsChecked="True" Margin="0,0,0,8"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Alertes ignorées (IP de confiance)'}" />
                <CheckBox x:Name="CaseListeBlanche"  IsChecked="True"
                           Foreground="{StaticResource Texte}"
                          Content="{loc:Tr 'Liste blanche des processus'}" />
            </StackPanel>

            <!-- Boutons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,20,20,18">
                <Button Content="{loc:Tr 'Annuler'}"
                        Style="{StaticResource BoutonSecondaire}"
                        Width="130" Height="32"
                        Padding="0"
                        Margin="0,0,8,0"
                        Click="SurAnnuler" />
                <Button Content="{loc:Tr 'Exporter'}"
                        Style="{StaticResource BoutonAccent}"
                        Width="130" Height="32"
                        Padding="0"
                        Click="SurExporter" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
