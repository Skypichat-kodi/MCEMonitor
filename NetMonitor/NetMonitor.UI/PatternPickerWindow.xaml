<Window x:Class="NetMonitor.UI.PatternPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un pattern"
        Width="460" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E5E5E5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ligne 0 : Titre + IP -->
        <TextBlock x:Name="IpText" Grid.Row="0"
                   FontSize="14" FontWeight="Bold" Foreground="#4CC2FF"
                   Margin="0,0,0,15"/>

        <!-- Ligne 1 : Quelle valeur ajouter -->
        <TextBlock Grid.Row="1" Text="Quelle valeur ajouter à la liste ?"
                   FontSize="12" Foreground="#B4B4B4" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <RadioButton x:Name="RbIsp" GroupName="Val" Tag="isp"
                         Margin="0,3" Foreground="#E5E5E5"
                         Checked="ValueRadio_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="ISP (Fournisseur d'accès)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbOrg" GroupName="Val" Tag="org"
                         Margin="0,3" Foreground="#E5E5E5"
                         Checked="ValueRadio_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏢" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Organisation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbReverseDns" GroupName="Val" Tag="reversedns"
                         Margin="0,3" Foreground="#E5E5E5"
                         Checked="ValueRadio_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Reverse DNS" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbIp" GroupName="Val" Tag="ip"
                         Margin="0,3" Foreground="#E5E5E5"
                         Checked="ValueRadio_Checked">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="IP complète (exacte)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Ligne 3 : Aperçu valeur + choix de la liste -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">

            <!-- Aperçu de la valeur -->
            <Border Background="#1A1A1A" BorderBrush="#3C3C3C" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Valeur qui sera ajoutée :" FontSize="11"
                               Foreground="#999" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtSelectedValue" FontSize="13"
                               FontWeight="Bold" Foreground="#E5E5E5"
                               TextWrapping="Wrap" Text="-"/>
                </StackPanel>
            </Border>

            <!-- Choix de la liste -->
            <TextBlock Text="Dans quelle liste ajouter ce pattern ?"
                       FontSize="12" Foreground="#B4B4B4" Margin="0,0,0,8"/>

            <RadioButton x:Name="RbListSafe" GroupName="List" Tag="safe"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#6CCB5F"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Safe" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Légitime connu" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbListCritical" GroupName="List" Tag="critical"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#B71C1C"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Critical" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Malveillant avéré" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbListScanner" GroupName="List" Tag="scanner"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FDD835"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Scanner" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Scanner de recherche" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbListCrawler" GroupName="List" Tag="crawler"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#1E88E5"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Crawler" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Robot d'exploration" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbListWhitelist" GroupName="List" Tag="whitelist"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FFFFFF"
                            CornerRadius="3" Margin="0,0,10,0"
                            BorderBrush="#999" BorderThickness="1"/>
                    <TextBlock Text="Whitelist" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Ma whitelist" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Ligne 4 : Note d'information -->
        <TextBlock Grid.Row="4" Margin="0,10,0,0"
                   Text="ℹ  Le pattern sera ajouté à NetMonitor.config et le service rechargera à chaud. La prochaine fois qu'une IP correspondra à ce pattern, elle recevra l'étiquette choisie."
                   FontSize="11" Foreground="#888" TextWrapping="Wrap"
                   FontStyle="Italic"/>

        <!-- Ligne 5 : Boutons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" Width="100" Height="30"
                    Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Ajouter" Width="100" Height="30"
                    IsDefault="True" Click="OnApply"
                    Background="#007ACC" BorderBrush="#4CC2FF"/>
        </StackPanel>
    </Grid>
</Window>