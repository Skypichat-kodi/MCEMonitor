<Window x:Class="NetMonitor.UI.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetMonitor"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblMessage" Grid.Row="0"
                   Text="Entrez une valeur :"
                   Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox x:Name="TxtValue" Grid.Row="1"
                 Height="28" VerticalContentAlignment="Center"
                 FontSize="13"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annuler" Width="90" Height="28"
                    Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="OK" Width="90" Height="28"
                    IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>