                                <DataGridTextColumn Header="{loc:Tr 'Raison'}"    Binding="{Binding Message}" Width="250" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
