                            <TextBlock Text="📜" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#4CC2FF" VerticalAlignment="Center"/>
                            <TextBlock Text="Historique des intrusions" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="200" Click="ClearHistory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Effacer l'historique" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Sévérité :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbHistorySeverity" Width="120" Margin="0,0,15,0"
                                      SelectionChanged="HistoryFilter_Changed">
                                <ComboBoxItem Content="{loc:Tr 'Toutes'}"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr 'Détecteur :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbHistoryDetector" Width="140" Margin="0,0,15,0"
                                      SelectionChanged="HistoryFilter_Changed"/>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtHistorySearch" Width="200" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="HistoryFilter_Changed"/>

                            <TextBlock x:Name="lblHistoryFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="AlertsHistoryGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Date'}" Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="140"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding RemoteIp}" Width="130"/>
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding RemoteIp}"
                                                    Width="22" Height="22"
                                                    ToolTip="Voir les informations sur cette IP"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Port dst'}" Binding="{Binding RemotePort}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Port loc'}" Binding="{Binding LocalPort}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" SortMemberPath="ProcessName" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" SortMemberPath="Details" Width="*" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelHistoryMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="ToggleHistoryMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="Afficher toutes les lignes">
                                <TextBlock x:Name="txtHistoryMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Tableau 4 : Audit Whitelist -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,8">
                            <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#888" VerticalAlignment="Center"/>
                            <TextBlock Text="Alertes ignorées (IP de confiance)" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#888"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="200" Click="ClearAudit_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vider l'audit" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Détecteur :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbAuditDetector" Width="140" Margin="0,0,15,0"
                                      SelectionChanged="AuditFilter_Changed"/>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtAuditSearch" Width="220" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuditFilter_Changed"/>

                            <TextBlock x:Name="lblAuditFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="AuditGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Background" Value="#1F3A15"/>
                                    <Setter Property="Foreground" Value="#C0E0A8"/>
                                    <Setter Property="BorderBrush" Value="#2E5A1A"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="#141F0D"/>
                                    <Setter Property="BorderBrush" Value="#243A18"/>
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                            <Setter Property="Background" Value="#1A2412"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#243A18"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Date'}" Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="140"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding RemoteIp}" Width="130"/>
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding RemoteIp}"
                                                    Width="22" Height="22"
                                                    ToolTip="Voir les informations sur cette IP"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Port dst'}" Binding="{Binding RemotePort}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Port loc'}" Binding="{Binding LocalPort}" Width="70"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" SortMemberPath="Pid" Width="60"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" SortMemberPath="ProcessName" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Chemin" SortMemberPath="ProcessPath" Width="*" MinWidth="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProcessPathDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessPath}"
                                                           Cursor="Hand"
                                                           Tag="{Binding ProcessPath}"
                                                           MouseLeftButtonUp="OpenFileLocation_TextClick"/>
                                                <Button Grid.Column="1" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                        Cursor="Hand" Focusable="False"
                                                        ToolTip="Ouvrir l'emplacement du fichier"
                                                        Tag="{Binding ProcessPath}"
                                                        Click="OpenFileLocation_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="..." FontWeight="Bold" Foreground="#4CC2FF"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Raison" Binding="{Binding TrustReasonDisplay}" SortMemberPath="TrustReason" Width="250" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding TrustReason}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" SortMemberPath="Details" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelAuditMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,10"
                                    Visibility="Collapsed">
                            <Button Click="ToggleAuditMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="Afficher toutes les lignes">
                                <TextBlock x:Name="txtAuditMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET LISTE BLANCHE (gestion whitelist)              -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Liste blanche'}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0"
                                   Foreground="#6CCB5F" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Processus approuvés'}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#6CCB5F"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWhitelistSummary" FontSize="12" Foreground="#999"
                                   Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="RefreshWhitelist_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="220" Click="RemoveWhitelistEntry_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#CC3300"/>
                                    <Setter Property="BorderBrush" Value="#FF6347"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E64D1A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Retirer de la liste blanche" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#B4B4B4"
                                   Text="ℹ  Retirer un processus le fera réapparaître dans le tableau « Processus en attente » au prochain événement réseau. Décocher « Actif » désactive temporairement la confiance sans supprimer l'entrée."/>
                    </Border>

                    <DataGrid x:Name="WhitelistGrid" Grid.Row="3"
                              RowHeight="32"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr 'Nom'}"
                                                Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="{loc:Tr 'Chemin'}"
                                                Binding="{Binding Path}" Width="*" MinWidth="300">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:Tr 'Actif'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Tag="{Binding}"
                                                  Click="WhitelistEnabled_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr 'Éditeur'}" Binding="{Binding PublisherDisplay}" SortMemberPath="Publisher" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Publisher}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Display}" SortMemberPath="Sha256" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Sha256}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET CONNEXIONS                                     -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Connexions'}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rafraîchir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="txtConnectionCount"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#888" Text=""/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="ConnectionsGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Heure'}"   Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="90"/>
                                <DataGridTextColumn Header="{loc:Tr 'Proto'}"   Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Tr 'Local'}"   Binding="{Binding LocalEndpoint}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Tr 'Distant'}" Binding="{Binding RemoteEndpoint}" Width="220"/>
                                <DataGridTextColumn Header="{loc:Tr 'PID'}"     Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Process'}" Binding="{Binding ProcessName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET RÉGLAGES (Web + Détecteurs)                    -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Réglages'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <StackPanel Margin="0,10,0,0">

                        <GroupBox Margin="0,0,0,15"
                                  Padding="10"
                                  Header="{loc:Tr 'Serveur Web'}"
                                  Background="{StaticResource PanelBackground}"
                                  BorderBrush="{StaticResource Win11Border}"
                                  Foreground="{StaticResource Win11Text}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{loc:Tr 'Activer le serveur Web'}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ToggleButton x:Name="ToggleWeb"
                                                      Width="40" Height="20"
                                                      Checked="ToggleWeb_Checked"
                                                      Unchecked="ToggleWeb_Unchecked">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Grid Width="40" Height="20">
                                                                    <Border x:Name="SwitchBackground"
                                                                            CornerRadius="10" Background="#3C3C3C"/>
                                                                    <Ellipse x:Name="SwitchThumb"
                                                                             Width="16" Height="16"
                                                                             Margin="2" Fill="#E5E5E5"
                                                                             HorizontalAlignment="Left"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="SwitchBackground" Property="Background" Value="#4CC2FF"/>
                                                                        <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{loc:Tr 'Port :'}" Width="120" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtWebPort" Width="200"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{loc:Tr 'Login :'}" Width="120" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtWebLogin" Width="200"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="177"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{loc:Tr 'Mot de passe :'}" Grid.Column="0" VerticalAlignment="Center"/>

                                        <PasswordBox x:Name="txtWebPassword" Grid.Column="1" Width="177"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Visible"/>

                                        <TextBox x:Name="txtWebPasswordVisible" Grid.Column="1" Width="177"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Collapsed"/>

                                        <Button x:Name="btnShowWebPassword" Grid.Column="2"
                                                Width="22" Height="22" Margin="6,0,0,0" Padding="0"
                                                Click="btnShowWebPassword_Click"
                                                Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1"
                                                Cursor="Hand">
                                            <TextBlock x:Name="imgWebEye" Text="👁" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Content="{loc:Tr 'Appliquer'}"
                                            Width="150" Height="28" Margin="0,0,0,8"
                                            Padding="0" VerticalContentAlignment="Center"
                                            Click="btnApplyWeb_Click"/>

                                    <Button Content="{loc:Tr 'Ouvrir dans le navigateur'}"
                                            Width="220" Height="28"
                                            Padding="0" VerticalContentAlignment="Center"
                                            Click="btnOpenWeb_Click"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Scan de ports" FontSize="14"
                                               FontWeight="Bold" Foreground="#4CC2FF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Fenêtre d'analyse (s) :"
                                                   Width="220" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtPortScanWindow"
                                                 Width="100"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Seuil de ports distincts :"
                                                   Width="220" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtPortScanThreshold"
                                                 Width="100"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="📡" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Beaconing (C2)" FontSize="14"
                                               FontWeight="Bold" Foreground="#4CC2FF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Fenêtre d'analyse (s) :"
                                                   Width="220" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtBeaconWindow"
                                                 Width="100"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Hits minimum :"
                                                   Width="220" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtBeaconHits"
                                                 Width="100"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Jitter max (%) :"
                                                   Width="220" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtBeaconJitter"
                                                 Width="100"
                                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Blocage automatique" FontSize="14"
                                               FontWeight="Bold" Foreground="#4CC2FF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="chkAutoBlock"
                                          Content="Bloquer automatiquement les IP en cas d'intrusion de sévérité High et supérieure"
                                          Foreground="#E5E5E5"
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="Les règles sont créées via netsh advfirewall. Les IP bloquées sont visibles dans l'onglet Intrusions (tableau 2)."
                                           FontSize="11"
                                           Foreground="#888"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Filtres et Whitelists" FontSize="14"
                                               FontWeight="Bold" Foreground="#4CC2FF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Réseaux ignorés (CIDR, séparés par virgule) :"
                                               Width="280" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtIgnoredNetworks"
                                             Width="300"
                                             Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="chkDisableFilters"
                                          Content="Mode Debug : Désactiver les filtres et whitelists"
                                          Foreground="#FF6347"
                                          FontWeight="Bold"
                                          Margin="0,10,0,5"
                                          Checked="ChkDisableFilters_Checked"
                                          Unchecked="ChkDisableFilters_Unchecked"/>

                                <TextBlock x:Name="lblDisableFiltersWarning"
                                           Text="⚠ ATTENTION : Cette option désactive toutes les protections. Utilisez-la uniquement pour tester les détecteurs. Le système peut être inondé de faux positifs."
                                           Foreground="#FF6347"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Margin="20,0,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
                                    <TextBlock Text="Niveau Blacklist IPsum (1-6) :" Width="250" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtBlacklistLevel" Width="80"
                                             Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                </StackPanel>

                                <TextBlock x:Name="lblBlacklistLastUpdate"
                                           Foreground="#888" FontSize="11" Text="Dernière MAJ : inconnue" Margin="0,0,0,5"/>

                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Tr 'Enregistrer les réglages'}"
                                Width="220"
                                Height="35"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Click="btnSaveSettings_Click"
                                ToolTip="Enregistrer les réglages dans NetMonitor.config"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET STATISTIQUES                                   -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Statistiques'}">
                <ScrollViewer x:Name="StatsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0"
                              PreviewMouseWheel="StatsScrollViewer_PreviewMouseWheel">
                    <StackPanel Margin="0,10,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="160" Click="RefreshStats_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="txtStatsLastUpdate" VerticalAlignment="Center"
                                       Foreground="#888" Text=""/>
                        </StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Total alertes'}" FontSize="11" Foreground="#999"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtStatsTotalAlerts" FontSize="26" FontWeight="Bold"
                                               Foreground="#4CC2FF" HorizontalAlignment="Center" Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'IPs distinctes'}" FontSize="11" Foreground="#999"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtStatsDistinctIps" FontSize="26" FontWeight="Bold"
                                               Foreground="#4CC2FF" HorizontalAlignment="Center" Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Pays distincts'}" FontSize="11" Foreground="#999"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtStatsDistinctCountries" FontSize="26" FontWeight="Bold"
                                               Foreground="#4CC2FF" HorizontalAlignment="Center" Text="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Tr 'Pire sévérité'}" FontSize="11" Foreground="#999"
                                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="txtStatsWorstSeverity" FontSize="20" FontWeight="Bold"
                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="OK"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Sous-onglets : Carte / Graphiques -->
                        <TabControl Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                            <TabControl.Resources>
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="border"
                                                        Background="#252526"
                                                        BorderBrush="#3C3C3C"
                                                        BorderThickness="0,0,0,2"
                                                        Padding="15,6">
                                                    <ContentPresenter ContentSource="Header"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#4CC2FF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>

                            <TabItem Header="{loc:Tr 'Carte du monde'}">
                                <Border CornerRadius="6" ClipToBounds="True" Height="480"
                                        BorderBrush="#3c3c3c" BorderThickness="1" Margin="0,10,0,0">
                                    <wv2:WebView2 x:Name="MapWebView" />
                                </Border>
                            </TabItem>

                            <TabItem Header="{loc:Tr 'Graphiques'}">
                                <Border CornerRadius="6" ClipToBounds="True" Height="480"
                                        BorderBrush="#3c3c3c" BorderThickness="1" Margin="0,10,0,0">
                                    <wv2:WebView2 x:Name="ChartsWebView" />
                                </Border>
                            </TabItem>
                        </TabControl>

                        <Border BorderBrush="#FF6347" BorderThickness="0,0,0,2" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🔥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Intrusions actives'}" FontSize="14"
                                               FontWeight="Bold" Foreground="#FF8A72" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtActiveSummary" FontSize="12" Foreground="#999"
                                               Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{loc:Tr 'Top IPs (par nombre d\'alertes)'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF8A72" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsActiveIpsGrid" MinHeight="120" MaxHeight="200"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding Ip}" Width="130"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Sévérité'}" Binding="{Binding SeverityDisplay}" Width="100"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="70"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" Width="120"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Détecteurs'}" Binding="{Binding DetectorsDisplay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{loc:Tr 'Répartition par pays'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF8A72" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsActiveCountriesGrid" MinHeight="100" MaxHeight="160"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                        <DataGridTextColumn Header="{loc:Tr 'IPs distinctes'}" Binding="{Binding DistinctIps}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{loc:Tr 'Répartition par détecteur'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FF8A72" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsActiveDetectorsGrid" MinHeight="100" MaxHeight="160"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#6CCB5F" BorderThickness="0,0,0,2" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                               Foreground="#6CCB5F" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'IP bloquées au pare-feu'}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="#6CCB5F"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtBlockedSummary" FontSize="12" Foreground="#999"
                                               Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{loc:Tr 'Top IPs bloquées'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8FDA80" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsBlockedIpsGrid" MinHeight="120" MaxHeight="200"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding Ip}" Width="130"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="{loc:Tr 'FAI'}" Binding="{Binding Isp}" Width="140"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding DetectorsDisplay}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Bloquée le'}" Binding="{Binding LastSeenText}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{loc:Tr 'Répartition par pays'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8FDA80" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsBlockedCountriesGrid" MinHeight="100" MaxHeight="160"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr 'IPs'}" Binding="{Binding Count}" Width="120"/>
                                        <DataGridTextColumn Header="{loc:Tr 'Distinctes'}" Binding="{Binding DistinctIps}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="{loc:Tr 'Répartition par détecteur'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8FDA80" Margin="0,5,0,5"/>
                                <DataGrid x:Name="StatsBlockedDetectorsGrid" MinHeight="100" MaxHeight="160"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Tr 'IPs'}" Binding="{Binding Count}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Border Grid.Row="2"
                Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0"
                         Width="12" Height="12" Fill="Gray"
                         Margin="0,0,8,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Text="..." FontSize="12" Foreground="#B4B4B4"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="txtLastUpdate" Grid.Column="2"
                           Text="" FontSize="11" Foreground="#888"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>