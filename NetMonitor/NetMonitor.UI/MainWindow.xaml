                                <ComboBoxItem Content="{loc:Tr 'Toutes'}"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtPendingSearch" Width="220" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="PendingFilter_Changed"/>

                            <TextBlock x:Name="lblPendingFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="PendingProcessesGrid" ColumnHeaderStyle="{StaticResource EntetesIntrusion}" CellStyle="{StaticResource CellulesIntrusion}" RowStyle="{StaticResource LignesIntrusion}"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="140"/>
                                
                                <!-- COLONNE TENTATIVES DEPLACEE ICI -->
                                <DataGridTemplateColumn Header="{loc:Tr 'Tentatives'}" SortMemberPath="Count" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,0" Height="18" MinWidth="30"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#b71c1c"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                                <Setter Property="Background" Value="#8b0000"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                                <Setter Property="Background" Value="#5a0000"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                                <Setter Property="Background" Value="#2a0000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Count}" Foreground="White" VerticalAlignment="Center"
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="130"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" SortMemberPath="Pid" Width="60"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" SortMemberPath="ProcessName" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupProcess_Click" Tag="{Binding ProcessLookupUrl}"
                                                    Width="22" Height="22"
                                                    ToolTip="{loc:Tr 'Rechercher ce processus sur le web'}"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProcessName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProcessName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr 'Chemin'}" SortMemberPath="ProcessPath" Width="*" MinWidth="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProcessPathDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessPath}"
                                                           Cursor="Hand"
                                                           Tag="{Binding ProcessPath}"
                                                           MouseLeftButtonUp="OpenFileLocation_TextClick"/>
                                                <Button Grid.Column="1" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                        Cursor="Hand" Focusable="False"
                                                        ToolTip="{loc:Tr 'Net.OpenFileLocation'}"
                                                        Tag="{Binding ProcessPath}"
                                                        Click="OpenFileLocation_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="..." FontWeight="Bold" Foreground="#4CC2FF"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Raison'}" Binding="{Binding TrustReasonDisplay}" SortMemberPath="TrustReason" Width="200" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding TrustReason}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'IP distante'}" Binding="{Binding RemoteEndPoint}" SortMemberPath="RemoteIp" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelPendingMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="TogglePendingMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="{loc:Tr 'Afficher toutes les lignes'}">
                                <TextBlock x:Name="txtPendingMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Tableau 2 : IP et Processus bloqués -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,8">
                            <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#FF6347" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'IP et Processus bloqués'}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#FF6347"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="200" Click="UnblockSelected_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔓" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Débloquer'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Click="ChangeSeverity_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙&#xFE0E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Forcer la sévérité'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Width="200" Click="AddPatternFromBlockedIp_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Créer une règle (futur)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="180" Click="ChangeOrigin_Click" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.ForceOrigin'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>                                                        
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Type :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbBlockedType" Width="120" Margin="0,0,15,0"
                                      SelectionChanged="BlockedFilter_Changed">
                                <ComboBoxItem Content="{loc:Tr 'Tous'}"/>
                                <ComboBoxItem Content="IP"/>
                                <ComboBoxItem Content="{loc:Tr 'Processus'}"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtBlockedSearch" Width="220" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="BlockedFilter_Changed"/>

                            <TextBlock x:Name="lblBlockedFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="BlockedIpsGrid" ColumnHeaderStyle="{StaticResource EntetesIntrusion}" CellStyle="{StaticResource CellulesIntrusion}" RowStyle="{StaticResource LignesIntrusion}"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Date'}" Binding="{Binding BlockedAtText}" SortMemberPath="BlockedAt" Width="150"/>
                                <DataGridTextColumn Header="{loc:Tr 'Type'}" Binding="{Binding TypeDisplay}" SortMemberPath="IsProcess" Width="90"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP / Processus'}" Binding="{Binding IpDisplay}" SortMemberPath="Ip" Width="170" MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessPath}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Pays'}"  Binding="{Binding CountryDisplay}" SortMemberPath="Country" Width="150"/>
                                <DataGridTextColumn Header="{loc:Tr 'FAI (ASN)'}" Binding="{Binding IspDisplay}" SortMemberPath="Isp" Width="160"/>
                                <DataGridTextColumn Header="{loc:Tr 'Organisation'}" Binding="{Binding OrgDisplay}" SortMemberPath="Org" Width="160"/>
                                <DataGridTextColumn Header="{loc:Tr 'Reverse DNS'}" Binding="{Binding ReverseDnsDisplay}" SortMemberPath="ReverseDns" Width="190">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ReverseDns}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>                     
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding Ip}"
                                                    Width="22" Height="22"
                                                    ToolTip="{loc:Tr 'Voir les informations sur cette IP (AbuseIPDB)'}"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <!-- Masqué pour les processus (pas d'AbuseIPDB sur un nom de processus) -->
                                                            <DataTrigger Binding="{Binding IsProcess}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>                                
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>                             
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'Raison'}" Binding="{Binding Message}" Width="*" MinWidth="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Message}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelBlockedMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="ToggleBlockedMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="{loc:Tr 'Afficher toutes les lignes'}">
                                <TextBlock x:Name="txtBlockedMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET INTERCEPTIONS (tentatives sur IP bloquée)      -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕵" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Interceptions'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 0 : titre -->
                        <RowDefinition Height="Auto"/>   <!-- 1 : boutons -->
                        <RowDefinition Height="Auto"/>   <!-- 2 : filtres -->
                        <RowDefinition Height="*"/>      <!-- 3 : DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                   Foreground="#4CC2FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Tentatives sur IP bloquée'}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#4CC2FF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBlockedRetriesSummary" FontSize="12" Foreground="#999"
                                   Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="RefreshBlockedRetries_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="200" Click="ClearBlockedRetries_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Vider la liste'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>                        
                        <Button Width="180" Click="ChangeRetrySeverity_Click" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙&#xFE0E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Forcer la sévérité'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="200" Click="AddPatternFromRetry_Click" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Créer une règle (futur)'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="180" Click="ChangeRetryOrigin_Click" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Net.ForceOrigin'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>                                                
                    </StackPanel>

                    <!-- Filtres -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                        <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                        <TextBox x:Name="txtRetriesSearch" Width="280" Margin="0,0,15,0"
                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                 VerticalContentAlignment="Center"
                                 TextChanged="RetriesFilter_Changed"/>

                        <TextBlock x:Name="lblRetriesFilterCount" VerticalAlignment="Center"
                                   Foreground="#888" FontSize="11" Text=""/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="BlockedRetriesGrid" Grid.Row="3"
                              CellStyle="{StaticResource CellulesInterception}"
                              RowHeight="28"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              AlternationCount="2"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="#1A3A5C"/>
                                <Setter Property="Foreground" Value="#B5D7FF"/>
                                <Setter Property="BorderBrush" Value="#2E5A8A"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Background" Value="#0A1520"/>
                                <Setter Property="BorderBrush" Value="#1F3A52"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="#0F1F2E"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#16324F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                            <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding Ip}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding ReverseDns}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Tr 'Détecteur initial'}" Binding="{Binding OriginalDetector}" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" SortMemberPath="Country" Width="*" MinWidth="130"/>
                            <DataGridTextColumn Header="{loc:Tr 'FAI (ASN)'}" Binding="{Binding IspDisplay}" SortMemberPath="Isp" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Organisation'}" Binding="{Binding OrgDisplay}" SortMemberPath="Org" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Reverse DNS'}" Binding="{Binding ReverseDnsDisplay}" SortMemberPath="ReverseDns" Width="*" MinWidth="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding ReverseDns}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>                      
                            <DataGridTextColumn Header="{loc:Tr 'Bloquée le'}" Binding="{Binding BlockedAtText}" SortMemberPath="BlockedAt" Width="150"/>
                            
                            <!-- NOUVELLE COLONNE SÉVÉRITÉ -->
                            <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                            <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>
                            
                            <!-- COLONNE TENTATIVES -->
                            <DataGridTemplateColumn Header="{loc:Tr 'Tentatives'}" SortMemberPath="RetryCount" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="8,0" Height="18" MinWidth="30"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1565c0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                            <Setter Property="Background" Value="#0d47a1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                            <Setter Property="Background" Value="#0a2e6e"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                            <Setter Property="Background" Value="#051a3f"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RetryCount}" Foreground="White" VerticalAlignment="Center"
                                                       FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Tr '1ʳᵉ tentative'}" Binding="{Binding FirstRetryAtText}" SortMemberPath="FirstRetryAt" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Dernière tentative'}" Binding="{Binding LastRetryAtText}" SortMemberPath="LastRetryAt" Width="150"/>

                            <!-- Colonne Info (bouton ℹ par ligne) -->
                            <DataGridTemplateColumn Width="45" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="LookupIp_Click"
                                                Tag="{Binding Ip}"
                                                Width="22" Height="22"
                                                Style="{StaticResource InfoButtonStyle}"
                                                ToolTip="{loc:Tr 'Voir les informations sur cette IP'}"
                                                Content="i"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>                    
            <!-- ====================================================== -->
            <!--  ONGLET HISTORIQUE (intrusions + audit whitelist)      -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🕘" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Historique'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Tableau 3 : historique -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📜" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#4CC2FF" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Historique des intrusions'}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="200" Click="ClearHistory_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.ClearHistory'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Click="HistoryChangeSeverity_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙&#xFE0E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Forcer la sévérité'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Click="HistoryAddPattern_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Créer une règle (futur)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Click="HistoryChangeOrigin_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.ForceOrigin'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Sévérité :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbHistorySeverity" Width="120" Margin="0,0,15,0"
                                      SelectionChanged="HistoryFilter_Changed">
                                <ComboBoxItem Content="{loc:Tr 'Toutes'}"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr 'Détecteur :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbHistoryDetector" Width="140" Margin="0,0,15,0"
                                      SelectionChanged="HistoryFilter_Changed"/>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtHistorySearch" Width="200" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="HistoryFilter_Changed"/>

                            <TextBlock x:Name="lblHistoryFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="AlertsHistoryGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Date'}" Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="140"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding RemoteIp}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ReverseDns}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" SortMemberPath="Country" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="{loc:Tr 'FAI (ASN)'}" Binding="{Binding IspDisplay}" SortMemberPath="Isp" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="{loc:Tr 'Organisation'}" Binding="{Binding OrgDisplay}" SortMemberPath="Org" Width="*" MinWidth="150"/>                             
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding RemoteIp}"
                                                    Width="22" Height="22"
                                                    ToolTip="{loc:Tr 'Voir les informations sur cette IP'}"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Port dst'}" Binding="{Binding RemotePort}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Port loc'}" Binding="{Binding LocalPort}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" SortMemberPath="ProcessName" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" SortMemberPath="Details" Width="*" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelHistoryMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="ToggleHistoryMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="{loc:Tr 'Afficher toutes les lignes'}">
                                <TextBlock x:Name="txtHistoryMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Tableau 4 : Audit Whitelist -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,8">
                            <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#6CCB5F" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Alertes ignorées (IP de confiance)'}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#6CCB5F"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="200" Click="ClearAudit_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.ClearAudit'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Click="HistoryChangeSeverity_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙&#xFE0E;" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Forcer la sévérité'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="200" Click="HistoryAddPattern_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏷️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Créer une règle (futur)'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Click="HistoryChangeOrigin_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.ForceOrigin'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Détecteur :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbAuditDetector" Width="140" Margin="0,0,15,0"
                                      SelectionChanged="AuditFilter_Changed"/>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtAuditSearch" Width="220" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="AuditFilter_Changed"/>

                            <TextBlock x:Name="lblAuditFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="AuditGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Background" Value="#1F3A15"/>
                                    <Setter Property="Foreground" Value="#C0E0A8"/>
                                    <Setter Property="BorderBrush" Value="#2E5A1A"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="Background" Value="#141F0D"/>
                                    <Setter Property="BorderBrush" Value="#243A18"/>
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                            <Setter Property="Background" Value="#252526"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#243A18"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Première'}" Binding="{Binding FirstSeenText}" SortMemberPath="FirstSeen" Width="130"/>
                                <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="130"/>
                                
                                <!-- COLONNE TENTATIVES DEPLACEE ICI -->
                                <DataGridTemplateColumn Header="{loc:Tr 'Tentatives'}" SortMemberPath="Count" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,0" Height="18" MinWidth="30"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#a1d99b"/>          <!-- c1 : vert clair -->
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                                <Setter Property="Background" Value="#74c476"/>   <!-- 2-4 : vert moyen -->
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                                <Setter Property="Background" Value="#31a354"/>   <!-- 5-9 : vert foncé -->
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                                <Setter Property="Background" Value="#005a32"/>   <!-- 10+ : vert très foncé -->
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Count}" Foreground="White" VerticalAlignment="Center"
                                                           FontWeight="Bold" FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Source}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding RemoteIp}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ReverseDns}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" SortMemberPath="Country" Width="130"/>
                                <DataGridTextColumn Header="{loc:Tr 'FAI (ASN)'}" Binding="{Binding IspDisplay}" SortMemberPath="Isp" Width="150"/>
                                <DataGridTextColumn Header="{loc:Tr 'Organisation'}" Binding="{Binding OrgDisplay}" SortMemberPath="Org" Width="150"/>                               
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding RemoteIp}"
                                                    Width="22" Height="22"
                                                    ToolTip="{loc:Tr 'Voir les informations sur cette IP'}"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Port dst'}" Binding="{Binding RemotePort}" Width="65"/>
                                <DataGridTextColumn Header="{loc:Tr 'Port loc'}" Binding="{Binding LocalPort}" Width="65"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" SortMemberPath="Pid" Width="55"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" SortMemberPath="ProcessName" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{loc:Tr 'Chemin'}" SortMemberPath="ProcessPath" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProcessPathDisplay}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProcessPath}"
                                                           Cursor="Hand"
                                                           Tag="{Binding ProcessPath}"
                                                           MouseLeftButtonUp="OpenFileLocation_TextClick"/>
                                                <Button Grid.Column="1" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                                        Cursor="Hand" Focusable="False"
                                                        ToolTip="{loc:Tr 'Net.OpenFileLocation'}"
                                                        Tag="{Binding ProcessPath}"
                                                        Click="OpenFileLocation_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProcessPath}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="..." FontWeight="Bold" Foreground="#4CC2FF"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Raison'}" Binding="{Binding TrustReasonDisplay}" SortMemberPath="TrustReason" Width="180" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding TrustReason}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" SortMemberPath="Details" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>                           
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelAuditMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,10"
                                    Visibility="Collapsed">
                            <Button Click="ToggleAuditMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="{loc:Tr 'Afficher toutes les lignes'}">
                                <TextBlock x:Name="txtAuditMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET LISTE BLANCHE (gestion whitelist)              -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✅" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Liste blanche'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0"
                                   Foreground="#6CCB5F" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Processus approuvés'}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#6CCB5F"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWhitelistSummary" FontSize="12" Foreground="#999"
                                   Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="RefreshWhitelist_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="220" Click="RemoveWhitelistEntry_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#CC3300"/>
                                    <Setter Property="BorderBrush" Value="#FF6347"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E64D1A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Retirer de la liste blanche'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#B4B4B4">
                            <Run Text="ℹ  "/><Run Text="{loc:Tr 'Net.WhitelistHelp'}"/>
                        </TextBlock>
                    </Border>

                    <DataGrid x:Name="WhitelistGrid" Grid.Row="3"
                              RowHeight="32"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr 'Nom'}"
                                                Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="{loc:Tr 'Chemin'}"
                                                Binding="{Binding Path}" Width="*" MinWidth="300">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:Tr 'Actif'}" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Tag="{Binding}"
                                                  Click="WhitelistEnabled_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Tr 'Éditeur'}" Binding="{Binding PublisherDisplay}" SortMemberPath="Publisher" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Publisher}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Display}" SortMemberPath="Sha256" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding Sha256}"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET CONNEXIONS                                     -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔗" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Connexions'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Rafraîchir'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="txtConnectionCount"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#888" Text=""/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                        <DataGrid x:Name="ConnectionsGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Heure'}"   Binding="{Binding TimestampText}" SortMemberPath="Timestamp" Width="90"/>
                                <DataGridTextColumn Header="{loc:Tr 'Proto'}"   Binding="{Binding Protocol}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Tr 'Local'}"   Binding="{Binding LocalEndpoint}" Width="180"/>
                                <DataGridTextColumn Header="{loc:Tr 'Distant'}" Binding="{Binding RemoteEndpoint}" Width="220"/>
                                <DataGridTextColumn Header="{loc:Tr 'PID'}"     Binding="{Binding Pid}" Width="70"/>
                                <DataGridTextColumn Header="{loc:Tr 'Process'}" Binding="{Binding ProcessName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET RÉGLAGES (Web + Détecteurs)                    -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Réglages'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!--  COLONNE GAUCHE : Configuration système               -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        <StackPanel Grid.Column="0">

                            <!-- Bandeau info -->
                            <Border Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Margin="0,0,0,15">
                                <TextBlock Style="{StaticResource DescriptionText}" Margin="0">
                                    ℹ  Ces réglages contrôlent le comportement du service de surveillance réseau.
                                    Ils sont enregistrés dans <Run FontFamily="Consolas" Foreground="#4CC2FF">NetMonitor.config</Run>
                                    et appliqués à chaud après avoir cliqué sur le bouton <Bold>« Enregistrer les réglages »</Bold> en bas de page.
                                </TextBlock>
                            </Border>

                            <!-- Serveur Web -->
                            <GroupBox Margin="0,0,0,15"
                                      Padding="10"
                                      Header="{loc:Tr 'Serveur Web'}"
                                      Background="{StaticResource PanelBackground}"
                                      BorderBrush="{StaticResource Win11Border}"
                                      Foreground="{StaticResource Win11Text}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Net.WebHelp'}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,20,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="{loc:Tr 'Activer le serveur Web'}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <ToggleButton x:Name="ToggleWeb"
                                                              Width="40" Height="20"
                                                              Checked="ToggleWeb_Checked"
                                                              Unchecked="ToggleWeb_Unchecked">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Grid Width="40" Height="20">
                                                                            <Border x:Name="SwitchBackground"
                                                                                    CornerRadius="10" Background="#3C3C3C"/>
                                                                            <Ellipse x:Name="SwitchThumb"
                                                                                     Width="16" Height="16"
                                                                                     Margin="2" Fill="#E5E5E5"
                                                                                     HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="SwitchBackground" Property="Background" Value="#4CC2FF"/>
                                                                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{loc:Tr 'Port :'}" Width="120" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtWebPort" Width="200"
                                                         Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{loc:Tr 'Login :'}" Width="120" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtWebLogin" Width="200"
                                                         Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                            </StackPanel>

                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="177"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{loc:Tr 'Mot de passe :'}" Grid.Column="0" VerticalAlignment="Center"/>

                                                <PasswordBox x:Name="txtWebPassword" Grid.Column="1" Width="177"
                                                             Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Visible"/>

                                                <TextBox x:Name="txtWebPasswordVisible" Grid.Column="1" Width="177"
                                                         Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C" Visibility="Collapsed"/>

                                                <Button x:Name="btnShowWebPassword" Grid.Column="2"
                                                        Width="22" Height="22" Margin="6,0,0,0" Padding="0"
                                                        Click="btnShowWebPassword_Click"
                                                        Background="#2D2D30" BorderBrush="#3C3C3C" BorderThickness="1"
                                                        Cursor="Hand">
                                                    <TextBlock x:Name="imgWebEye" Text="👁" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </Grid>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Content="{loc:Tr 'Appliquer'}"
                                                    Width="150" Height="28" Margin="0,0,0,8"
                                                    Padding="0" VerticalContentAlignment="Center"
                                                    Click="btnApplyWeb_Click"/>

                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{loc:Tr 'OTP par email :'}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <ToggleButton x:Name="ToggleOtp" Grid.Column="1"
                                                              Width="40" Height="20"
                                                              Checked="ToggleOtp_Checked"
                                                              Unchecked="ToggleOtp_Unchecked">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Grid Width="40" Height="20">
                                                                            <Border x:Name="SwitchBackground"
                                                                                    CornerRadius="10" Background="#3C3C3C"/>
                                                                            <Ellipse x:Name="SwitchThumb"
                                                                                     Width="16" Height="16"
                                                                                     Margin="2" Fill="#E5E5E5"
                                                                                     HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="SwitchBackground" Property="Background" Value="#4CC2FF"/>
                                                                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0"
                                                           Text="{loc:Tr 'Code envoyé par email.'}"
                                                           FontSize="11" Foreground="#888" TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Scan de ports -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Scan de ports'}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4CC2FF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Détecte les scans de ports (comme nmap). Un pirate ou un bot teste plusieurs ports en peu de temps pour trouver des services ouverts. Ajustez le seuil selon votre tolérance.'}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{loc:Tr 'Net.AnalysisWindowSeconds'}"
                                                       Width="220" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtPortScanWindow"
                                                     Width="100"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{loc:Tr 'Seuil de ports distincts :'}"
                                                       Width="220" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtPortScanThreshold"
                                                     Width="100"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Beaconing -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="📡" FontSize="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Beaconing (C2)'}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4CC2FF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Net.BeaconingHelp'}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{loc:Tr 'Net.AnalysisWindowSeconds'}"
                                                       Width="220" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtBeaconWindow"
                                                     Width="100"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{loc:Tr 'Hits minimum :'}"
                                                       Width="220" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtBeaconHits"
                                                     Width="100"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{loc:Tr 'Jitter max (%) :'}"
                                                       Width="220" VerticalAlignment="Center"/>
                                            <TextBox x:Name="txtBeaconJitter"
                                                     Width="100"
                                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                                     VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Blocage automatique -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Blocage automatique'}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#4CC2FF"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Choisissez ce que le pare-feu doit bloquer automatiquement. Pour un serveur privé, cochez les 3 cases. Les services de confiance (Microsoft, Google, Windows) sont toujours exclus, pour ne pas casser votre système.'}"/>

                                    <CheckBox x:Name="chkAutoBlock"
                                              Content="{loc:Tr 'Activer le blocage automatique (interrupteur principal)'}"
                                              Foreground="#E5E5E5"
                                              FontWeight="Bold"
                                              Margin="0,0,0,15"/>

                                    <CheckBox x:Name="chkAutoBlockCritical"
                                              Style="{StaticResource ColoredCheckBox}"
                                              Tag="{StaticResource DotCritical}"
                                              Content="{loc:Tr 'Bloquer les menaces critiques'}"/>

                                    <CheckBox x:Name="chkAutoBlockWarning"
                                              Style="{StaticResource ColoredCheckBox}"
                                              Tag="{StaticResource DotWarning}"
                                              Content="{loc:Tr 'Bloquer les menaces inconnues'}"/>

                                    <CheckBox x:Name="chkAutoBlockSubnet"
                                              Style="{StaticResource ColoredCheckBox}"
                                              Tag="{StaticResource DotSubnet}"
                                              Content="{loc:Tr 'Bloquer les scanners de recherche'}"/>

                                    <CheckBox x:Name="chkBlockBots"
                                              Style="{StaticResource ColoredCheckBox}"
                                              Tag="{StaticResource DotBot}"
                                              Content="{loc:Tr 'Bloquer les robots officiels (Googlebot, Bingbot...)'}"
                                              Margin="0,0,0,8"/>

                                    <CheckBox x:Name="chkBlockCrawlers"
                                              Style="{StaticResource ColoredCheckBox}"
                                              Tag="{StaticResource DotCrawler}"
                                              Content="{loc:Tr 'Bloquer les robots génériques (Yandex, Baidu...)'}"
                                              Margin="0,0,0,8"/>

                                    <!-- Listes officielles (Microsoft + Google) -->
                                    <Border Background="#1A1A1A" BorderBrush="#3C3C3C" BorderThickness="1"
                                            CornerRadius="4" Padding="12" Margin="0,10,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Tr 'Listes officielles'}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                                       Margin="0,0,0,8"/>

                                            <!-- Microsoft -->
                                            <CheckBox x:Name="chkMicrosoftIpRange"
                                                      Content="{loc:Tr 'Utiliser la liste officielle Microsoft (services vérifiés)'}"
                                                      Foreground="#E5E5E5" Margin="0,0,0,5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <TextBlock Text="{loc:Tr 'Rafraîchir la liste Microsoft toutes les (h) :'}"
                                                           Width="280" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtMicrosoftIpRangeRefreshHours" Width="80"
                                                         Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                            </StackPanel>

                                            <!-- Google -->
                                            <CheckBox x:Name="chkGoogleIpRange"
                                                      Content="{loc:Tr 'Utiliser la liste officielle Google (crawlers vérifiés)'}"
                                                      Foreground="#E5E5E5" Margin="0,0,0,5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                                <TextBlock Text="{loc:Tr 'Rafraîchir la liste Google toutes les (h) :'}"
                                                           Width="280" VerticalAlignment="Center"/>
                                                <TextBox x:Name="txtGoogleIpRangeRefreshHours" Width="80"
                                                         Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{loc:Tr 'Les IPs des services de confiance (Microsoft, Google, etc.) ne sont jamais bloquées automatiquement, pour garantir le bon fonctionnement de Windows.'}"
                                               FontSize="11"
                                               Foreground="#888"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════ -->
                        <!--  COLONNE DROITE : Filtres et classification            -->
                        <!-- ═══════════════════════════════════════════════════════ -->
                        <StackPanel Grid.Column="2">

                            <!-- Filtres réseau -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Filtres réseau'}" FontSize="14" FontWeight="Bold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Net.IgnoredNetworksHelp'}"/>
                                    <DataGrid x:Name="GridIgnoredNetworks" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="80" MaxHeight="150" Margin="0,0,0,10">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Tr 'Réseau (CIDR)'}" Binding="{Binding Value}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="{loc:Tr '➕ Ajouter un réseau'}" Width="180" HorizontalAlignment="Left" Click="AddIgnoredNetwork_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- Classification des IPs -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="⚖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Classification des IPs'}" FontSize="14" FontWeight="Bold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Net.PatternsHelp'}"/>

                                    <TabControl Background="Transparent" BorderThickness="0">
                                        <TabControl.Resources>
                                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TabItem">
                                                            <Border x:Name="border" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,2" Padding="15,6">
                                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#4CC2FF"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TabControl.Resources>

                                        <TabItem Header="{loc:Tr '✅ Safe'}">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource DescriptionText}"
                                                           Text="{loc:Tr 'Domaines et ISP légitimes (Microsoft, Google, Cloudflare...). Les IPs correspondantes seront marquées Safe (vert).'}"/>
                                                <DataGrid x:Name="GridSafePatterns" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                                          HeadersVisibility="Column" MinHeight="150" MaxHeight="250" Margin="0,0,0,10">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{loc:Tr 'Pattern (ex: microsoft.com)'}" Binding="{Binding Value}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="{loc:Tr '➕ Ajouter un pattern Safe'}" Width="200" HorizontalAlignment="Left" Click="AddSafePattern_Click"/>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="{loc:Tr '🚨 Critical'}">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource DescriptionText}"
                                                           Text="{loc:Tr 'Domaines et ISP connus pour être malveillants (bulletproof hosting, etc.). Les IPs correspondantes seront marquées Critical (rouge).'}"/>
                                                <DataGrid x:Name="GridCriticalPatterns" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                                          HeadersVisibility="Column" MinHeight="150" MaxHeight="250" Margin="0,0,0,10">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{loc:Tr 'Pattern (ex: infrawat.ch)'}" Binding="{Binding Value}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="{loc:Tr '➕ Ajouter un pattern Critical'}" Width="200" HorizontalAlignment="Left" Click="AddCriticalPattern_Click"/>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="{loc:Tr '🔍 Scanner'}">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource DescriptionText}"
                                                           Text="{loc:Tr 'Net.ScannerHelp'}"/>
                                                <DataGrid x:Name="GridScannerPatterns" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                                          HeadersVisibility="Column" MinHeight="150" MaxHeight="250" Margin="0,0,0,10">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{loc:Tr 'Pattern (ex: shodan.io)'}" Binding="{Binding Value}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="{loc:Tr '➕ Ajouter un pattern Scanner'}" Width="200" HorizontalAlignment="Left" Click="AddScannerPattern_Click"/>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="{loc:Tr '🤖 Crawler'}">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource DescriptionText}"
                                                           Text="{loc:Tr 'Net.CrawlerHelp'}"/>
                                                <DataGrid x:Name="GridCrawlerPatterns" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                                          HeadersVisibility="Column" MinHeight="150" MaxHeight="250" Margin="0,0,0,10">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="{loc:Tr 'Pattern (ex: yandex.com)'}" Binding="{Binding Value}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="{loc:Tr '➕ Ajouter un pattern Crawler'}" Width="200" HorizontalAlignment="Left" Click="AddCrawlerPattern_Click"/>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="{loc:Tr '⭐ Whitelist'}">
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Style="{StaticResource DescriptionText}"
                                                           Text="{loc:Tr 'Patterns personnels. Les IPs correspondantes seront marquées Whitelisted (blanc) et ignorées.'}"/>
                                                <DataGrid x:Name="GridWhitelistPatterns" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                                                          HeadersVisibility="Column" MinHeight="150" MaxHeight="250" Margin="0,0,0,10">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Pattern" Binding="{Binding Value}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <Button Content="{loc:Tr '➕ Ajouter un pattern Whitelist'}" Width="200" HorizontalAlignment="Left" Click="AddWhitelistPattern_Click"/>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </StackPanel>
                            </Border>

                            <!-- Threat Intelligence -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Threat Intelligence'}" FontSize="14" FontWeight="Bold" Foreground="#4CC2FF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{loc:Tr 'Niveau Blacklist IPsum (1-6) :'}" Width="250" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtBlacklistLevel" Width="80" Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"/>
                                    </StackPanel>
                                    <TextBlock x:Name="lblBlacklistLastUpdate" Foreground="#888" FontSize="11" Text="{loc:Tr 'Dernière MAJ : inconnue'}" Margin="0,0,0,5"/>
                                </StackPanel>
                            </Border>

                            <!-- Mode Debug -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15" BorderBrush="#FF6347">
                                <StackPanel>
                                    <CheckBox x:Name="chkDisableFilters"
                                              Content="{loc:Tr 'Mode Debug : Désactiver les filtres et whitelists'}"
                                              Foreground="#FF6347"
                                              FontWeight="Bold"
                                              Margin="0,0,0,5"
                                              Checked="ChkDisableFilters_Checked"
                                              Unchecked="ChkDisableFilters_Unchecked"/>
                                    <TextBlock x:Name="lblDisableFiltersWarning"
                                               Text="{loc:Tr '⚠ ATTENTION : Cette option désactive toutes les protections. Utilisez-la uniquement pour tester les détecteurs.'}"
                                               Foreground="#FF6347"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Margin="20,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Zone de danger -->
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15"
                                    BorderBrush="#FF6347" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="#FF6347" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr 'Zone de danger'}" FontSize="14"
                                                   FontWeight="Bold" Foreground="#FF6347"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource DescriptionText}"
                                               Text="{loc:Tr 'Actions irréversibles. À utiliser uniquement en cas de problème majeur ou avant un redémarrage complet de votre configuration réseau.'}"/>

                                    <Button x:Name="btnClearAllBlockedIps"
                                            Width="320" Height="34"
                                            HorizontalAlignment="Left"
                                            Margin="0,5,0,0"
                                            Click="btnClearAllBlockedIps_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#CC3300"/>
                                                <Setter Property="BorderBrush" Value="#FF6347"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E64D1A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔓" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr 'Libérer toutes les IP bloquées'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="btnRestoreDefaultPatterns"
                                            Width="320" Height="34"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            Click="btnRestoreDefaultPatterns_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="#CC3300"/>
                                                <Setter Property="BorderBrush" Value="#FF6347"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E64D1A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr 'Net.RestorePatterns'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>                                    
                                </StackPanel>
                            </Border>

                            <!-- Bouton Enregistrer -->
                            <Button Content="{loc:Tr 'Enregistrer les réglages'}"
                                    Width="220"
                                    Height="35"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="btnSaveSettings_Click"
                                    ToolTip="{loc:Tr 'Enregistrer les réglages dans NetMonitor.config'}"/>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET APPAREILS DE CONFIANCE                         -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Appareils de confiance'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3C3C3C"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B4B4B4">
                            <Run Text="ℹ  "/><Run Text="{loc:Tr 'Net.TrustedDevicesHelp'}"/>
                        </TextBlock>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Width="160" Click="RefreshTrustedDevices_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="240" Click="RevokeAllTrustedDevices_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="#CC3300"/>
                                    <Setter Property="BorderBrush" Value="#FF6347"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E64D1A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Tout révoquer'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="txtTrustedDevicesSummary" Foreground="#888" FontSize="12"
                                   VerticalAlignment="Center" Margin="15,0,0,0" Text=""/>
                    </StackPanel>

                    <DataGrid x:Name="TrustedDevicesGrid" Grid.Row="2"
                              RowHeight="32"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr 'Navigateur / Appareil'}" 
                                                Binding="{Binding UserAgentDisplay}" Width="*" MinWidth="300">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="ToolTip" Value="{Binding UserAgent}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Tr 'Créé le'}" 
                                                Binding="{Binding CreatedAtDisplay}" Width="160"/>
                            <DataGridTextColumn Header="{loc:Tr 'Expire le'}" 
                                                Binding="{Binding ExpiresAtDisplay}" Width="160"/>
                            <DataGridTemplateColumn Header="{loc:Tr 'Action'}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="RevokeTrustedDevice_Click" Tag="{Binding Fingerprint}"
                                                Width="80" Height="24"
                                                ToolTip="{loc:Tr 'Révoquer cet appareil'}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="#CC3300"/>
                                                    <Setter Property="BorderBrush" Value="#FF6347"/>
                                                    <Setter Property="Padding" Value="4,0"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E64D1A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗑" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{loc:Tr 'Révoquer'}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET STATISTIQUES (2 sous-onglets)                 -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Statistiques'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <TabControl x:Name="StatsSubTabControl"
                            Background="Transparent" BorderThickness="0"
                            Margin="0,10,0,0">

                    <TabControl.Resources>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="border" Background="#252526"
                                                BorderBrush="#3C3C3C" BorderThickness="0,0,0,2"
                                                Padding="20,8">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC2FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!--  SOUS-ONGLET 1 : ACTIVITÉ                            -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Activité'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer x:Name="StatsActiveScrollViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,10,5,0"
                                      PreviewMouseWheel="StatsScrollViewer_PreviewMouseWheel">
                            <StackPanel Margin="0,0,0,0">

                                <!-- Barre d'actions (DANS le ScrollViewer) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button Width="160" Click="RefreshStats_Click" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="txtStatsLastUpdateActivity" VerticalAlignment="Center"
                                               Foreground="#888" Text=""/>
                                </StackPanel>

                                <!-- Section 1 (Border ambré) -->
                                <Border Background="#252526" BorderBrush="#8B6914" BorderThickness="1"
                                        CornerRadius="6" Padding="15">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="⏳" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtStatsActiveSectionTitle"
                                                       Text="{loc:Tr 'En attente de traitement'}" FontSize="16"
                                                       FontWeight="Bold" Foreground="#FFB900" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtActiveSummary" FontSize="12" Foreground="#999"
                                                       Margin="15,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- KPI actives -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="txtStatsActiveTotalLabel"
                                                               Text="{loc:Tr 'Alertes actives'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsActiveTotal" FontSize="26" FontWeight="Bold"
                                                               Foreground="#FFB900" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="txtStatsActiveIpsLabel"
                                                               Text="{loc:Tr 'IPs actives'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsActiveIps" FontSize="26" FontWeight="Bold"
                                                               Foreground="#FFB900" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="txtStatsActiveCountriesLabel"
                                                               Text="{loc:Tr 'Pays actives'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsActiveCountries" FontSize="26" FontWeight="Bold"
                                                               Foreground="#FFB900" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="txtStatsActiveWorstLabel"
                                                               Text="{loc:Tr 'Pire sévérité'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsActiveWorst" FontSize="20" FontWeight="Bold"
                                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="OK"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Carte des actives -->
                                        <TextBlock x:Name="txtStatsActiveMapTitle"
                                                   Text="{loc:Tr 'Carte des IPs actives'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#FFB900" Margin="0,5,0,5"/>
                                        <Border CornerRadius="6" ClipToBounds="True" Height="750"
                                                BorderBrush="#8B6914" BorderThickness="1" Margin="0,0,0,15">
                                            <controls:CountriesMapPanel x:Name="MapActivePanel" />
                                        </Border>

                                        <!-- Top FAI par pays -->
                                        <TextBlock x:Name="txtStatsActiveTopIspsTitle"
                                                   Text="{loc:Tr 'Top FAI par pays'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#FFB900" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsActiveIspsGrid" MinHeight="120" MaxHeight="220"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'FAI'}" Binding="{Binding Isp}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="180"/>
                                                <DataGridTextColumn x:Name="txtStatsActiveIspsCountHeader" Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="100"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Pays actives -->
                                        <TextBlock x:Name="txtStatsActiveCountriesTitle"
                                                   Text="{loc:Tr 'Répartition par pays (actives)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#FFB900" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsActiveCountriesGrid" MinHeight="100" MaxHeight="180"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                                <DataGridTextColumn Header="{loc:Tr 'IPs distinctes'}" Binding="{Binding DistinctIps}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Détecteurs actives -->
                                        <TextBlock x:Name="txtStatsActiveDetectorsTitle"
                                                   Text="{loc:Tr 'Répartition par détecteur (actives)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#FFB900" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsActiveDetectorsGrid" MinHeight="100" MaxHeight="180"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ══════════════════════════════════════════════════════ -->
                    <!--  SOUS-ONGLET 2 : GLOBAL                              -->
                    <!-- ══════════════════════════════════════════════════════ -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Global'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer x:Name="StatsGlobalScrollViewer" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,10,5,0"
                                      PreviewMouseWheel="StatsScrollViewer_PreviewMouseWheel">
                            <StackPanel Margin="0,0,0,0">

                                <!-- Barre d'actions (DANS le ScrollViewer) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <Button Width="160" Click="RefreshStats_Click" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="txtStatsLastUpdateGlobal" VerticalAlignment="Center"
                                               Foreground="#888" Text=""/>
                                </StackPanel>

                                <!-- Section 2 (Border vert) -->
                                <Border Background="#252526" BorderBrush="#2E5A1A" BorderThickness="1"
                                        CornerRadius="6" Padding="15">
                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="📈" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Tr 'Historique et blocages'}" FontSize="16"
                                                       FontWeight="Bold" Foreground="#6CCB5F" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtBlockedSummary" FontSize="12" Foreground="#999"
                                                       Margin="15,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- KPI globaux -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'Total alertes'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsTotalAlerts" FontSize="26" FontWeight="Bold"
                                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'IPs distinctes'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsDistinctIps" FontSize="26" FontWeight="Bold"
                                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'Pays distincts'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsDistinctCountries" FontSize="26" FontWeight="Bold"
                                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="0"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Margin="5,0,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr 'Pire sévérité'}" FontSize="11"
                                                               Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock x:Name="txtStatsWorstSeverity" FontSize="20" FontWeight="Bold"
                                                               Foreground="#6CCB5F" HorizontalAlignment="Center" Text="OK"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Carte (bloquées) + Graphiques (historique) en sous-onglets -->
                                        <TabControl Background="Transparent" BorderThickness="0" Margin="0,0,0,15">
                                            <TabControl.Resources>
                                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="TabItem">
                                                                <Border x:Name="border" Background="#252526"
                                                                        BorderBrush="#3C3C3C" BorderThickness="0,0,0,2"
                                                                        Padding="15,6">
                                                                    <ContentPresenter ContentSource="Header"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#6CCB5F"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </TabControl.Resources>

                                            <TabItem>
                                                <TabItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗺" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{loc:Tr 'Carte des IPs bloquées'}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </TabItem.Header>
                                                <Border CornerRadius="6" ClipToBounds="True" Height="750"
                                                        BorderBrush="#2E5A1A" BorderThickness="1" Margin="0,10,0,0">
                                                    <controls:CountriesMapPanel x:Name="MapBlockedPanel" />
                                                </Border>
                                            </TabItem>

                                            <TabItem>
                                                <TabItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="📉" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{loc:Tr 'Graphiques'}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </TabItem.Header>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Padding="0,10,5,0">
                                                    <controls:StatsChartsPanel x:Name="ChartsPanel" Margin="0,0,0,0" />
                                                </ScrollViewer>
                                            </TabItem>
                                            
                                        </TabControl>

                                        <!-- Top FAI par pays (depuis le début) -->
                                        <TextBlock Text="{loc:Tr 'Top FAI par pays (depuis le début)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#8FDA80" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsBlockedIspsGrid" MinHeight="120" MaxHeight="220"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'FAI'}" Binding="{Binding Isp}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="180"/>
                                                <DataGridTextColumn Header="{loc:Tr 'IPs bloquées'}" Binding="{Binding Count}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Pays bloquées -->
                                        <TextBlock Text="{loc:Tr 'Répartition par pays (bloquées)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#8FDA80" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsBlockedCountriesGrid" MinHeight="100" MaxHeight="180"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'IPs'}" Binding="{Binding Count}" Width="120"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Distinctes'}" Binding="{Binding DistinctIps}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Détecteurs bloquées -->
                                        <TextBlock Text="{loc:Tr 'Répartition par détecteur (bloquées)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#8FDA80" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsBlockedDetectorsGrid" MinHeight="100" MaxHeight="180"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'IPs'}" Binding="{Binding Count}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Top processus -->
                                        <TextBlock Text="{loc:Tr 'Top processus (historique complet)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#8FDA80" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsTopProcessesGrid" MinHeight="100" MaxHeight="200"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessName}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Activité par période (multi-granularités) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock x:Name="txtActivityPeriodTitle"
                                                       Text="{loc:Tr 'Activité par période'}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#8FDA80"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtActivityPeriodSummary" FontSize="11" Foreground="#999"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataGrid x:Name="StatsActivityGrid" MinHeight="100" MaxHeight="220"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single" Margin="0,0,0,10">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Période'}" Binding="{Binding Label}" Width="140"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Alertes'}" Binding="{Binding Count}" Width="120"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Dont critiques'}" Binding="{Binding CriticalCount}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Distribution sévérité -->
                                        <TextBlock Text="{loc:Tr 'Distribution par sévérité (historique)'}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="#8FDA80" Margin="0,5,0,5"/>
                                        <DataGrid x:Name="StatsSeverityDistributionGrid" MinHeight="100" MaxHeight="200"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Tr 'Sévérité'}" Binding="{Binding Severity}" Width="*"/>
                                                <DataGridTextColumn Header="{loc:Tr 'Occurrences'}" Binding="{Binding Count}" Width="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,1,0,0"
                Margin="0,10,0,0" Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0"
                         Width="12" Height="12" Fill="Gray"
                         Margin="0,0,8,0" VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Text="..." FontSize="12" Foreground="#B4B4B4"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="txtLastUpdate" Grid.Column="2"
                           Text="" FontSize="11" Foreground="#888"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>