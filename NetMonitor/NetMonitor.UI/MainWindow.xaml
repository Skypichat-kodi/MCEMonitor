<Window x:Class="NetMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NetMonitor"
        Height="850"
        Width="1300"
        MinHeight="550"
        MinWidth="900">

    <Window.Resources>
        <SolidColorBrush x:Key="Win11Background" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Win11Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Win11Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Win11Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#553A8DFF"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5E5"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="#252526"
                                BorderBrush="#3C3C3C"
                                BorderThickness="0,0,0,2"
                                Padding="15,8">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============================================================ -->
        <!--  Badge Sévérité (mêmes couleurs que la page web)             -->
        <!-- ============================================================ -->
        <DataTemplate x:Key="SeverityBadgeTemplate">
            <Border CornerRadius="8"
                    Padding="7,2"
                    MinWidth="58"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#444"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                <Setter Property="Background" Value="#FF6347"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                <Setter Property="Background" Value="#FF6347"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Background" Value="#FFB900"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                <Setter Property="Background" Value="#6CCB5F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Severity}"
                           FontWeight="Bold"
                           FontSize="11"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Black"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="High">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <!-- ============================================================ -->
        <!--  SCROLLBAR STYLÉE (sombre, fine, style VS Code)              -->
        <!-- ============================================================ -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4A4D"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5A5A5E"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#4CC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="0" Width="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Application globale du style de ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style scrollbar horizontale ultra-fine et discrète (pour DataGrid) -->
        <Style x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                        
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fond sombre -->
        <Rectangle Fill="#1E1E1E" Grid.RowSpan="3"/>

        <!-- Overlay background (image) -->
        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Resources/Images/UI-background.png" Stretch="Fill"/>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Voile sombre pour la lisibilité -->
        <Rectangle Fill="#1E1E1E" Grid.RowSpan="3" Opacity="0.83"/>

        <!-- BARRE TITRE -->
        <Grid Grid.Row="0" Margin="15,12,15,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="NetMonitor" FontSize="20" FontWeight="Bold"
                           Foreground="#4CC2FF" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1"
                    x:Name="btnOpenWebTop"
                    Height="30"
                    Padding="15,0"
                    VerticalContentAlignment="Center"
                    Click="btnOpenWeb_Click"
                    ToolTip="{loc:Tr 'Ouvrir la page Web dans le navigateur'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr 'Ouvrir la page Web'}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- TABCONTROL -->
        <TabControl x:Name="MainTabControl" Grid.Row="1"
                    Margin="15,0,15,0" Background="Transparent" BorderThickness="0">

            <!-- ====================================================== -->
            <!--  ONGLET INTRUSIONS (4 tableaux)                        -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Intrusions'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,5,0">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Tableau 1 : intrusions actives -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#FFB900" VerticalAlignment="Center"/>
                            <TextBlock Text="Intrusions détectées" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="160" Margin="0,0,10,0" Click="BlockSelected_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bloquer l'IP" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="160" Click="ClearActive_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vider la liste" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Width="160" Click="OpenLogs_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ouvrir les logs" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="160" Click="ExportPdf_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exporter PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="ActiveIntrusionsGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" Width="140"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detectors}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}"       Binding="{Binding RemoteIp}" Width="130"/>
                                <DataGridTemplateColumn Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click"
                                                    Tag="{Binding RemoteIp}"
                                                    Cursor="Hand"
                                                    ToolTip="Voir les informations sur cette IP"
                                                    Padding="0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="ℹ" Foreground="#4CC2FF" FontWeight="Bold" FontSize="14"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr 'Compteur'}" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" MinWidth="28">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                                <Setter Property="Background" Value="#7a1e0f"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                                <Setter Property="Background" Value="#cc3300"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                                <Setter Property="Background" Value="#ff3300"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Count}" Foreground="White"
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Ports distants'}" Binding="{Binding RemotePortsDisplay}" Width="110"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" Width="*" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- ⚠ Indicateur Voir plus (sous le tableau) -->
                        <StackPanel x:Name="panelActiveMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="ToggleActiveMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="Afficher toutes les lignes">
                                <TextBlock x:Name="txtActiveMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Tableau 1bis : processus en attente d'examen -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,8">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#4CC2FF" VerticalAlignment="Center"/>
                            <TextBlock Text="Processus en attente d'examen" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="220" Margin="0,0,10,0" Click="BlockSelectedProcess_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bloquer le processus" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="240" Click="WhitelistSelectedProcess_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#3A7A33"/>
                                        <Setter Property="BorderBrush" Value="#6CCB5F"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4A9A40"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ajouter à la liste blanche" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <DataGrid x:Name="PendingProcessesGrid"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" Width="140"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" Width="100" CellTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detector}" Width="130"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding PidDisplay}" Width="60"/>
                                <DataGridTextColumn Header="{loc:Tr 'Processus'}" Binding="{Binding ProcessNameDisplay}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding ProcessNameDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupProcess_Click"
                                                    Tag="{Binding ProcessLookupUrl}"
                                                    Cursor="Hand"
                                                    ToolTip="Rechercher ce processus sur le web"
                                                    Padding="0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProcessName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProcessName}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="ℹ" Foreground="#4CC2FF" FontWeight="Bold" FontSize="14"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Chemin" Binding="{Binding ProcessPathDisplay}" Width="*" MinWidth="250">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding ProcessPath}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Raison" Binding="{Binding TrustReasonDisplay}" Width="250" MinWidth="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding TrustReason}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="IP distante" Binding="{Binding RemoteEndPoint}" Width="160"/>
                                <DataGridTemplateColumn Header="{loc:Tr 'Compteur'}" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" MinWidth="28">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                                <Setter Property="Background" Value="#7a1e0f"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                                <Setter Property="Background" Value="#cc3300"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                                <Setter Property="Background" Value="#ff3300"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Count}" Foreground="White"
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelPendingMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
