            <!--  ONGLET INTERCEPTIONS (tentatives sur IP bloquée)      -->
            <!-- ====================================================== -->
            <TabItem Header="{loc:Tr 'Interceptions'}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 0 : titre -->
                        <RowDefinition Height="Auto"/>   <!-- 1 : boutons -->
                        <RowDefinition Height="Auto"/>   <!-- 2 : filtres -->
                        <RowDefinition Height="*"/>      <!-- 3 : DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Titre -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛡" FontSize="16" Margin="0,0,8,0"
                                   Foreground="#4CC2FF" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Tentatives sur IP bloquée'}" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#4CC2FF"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBlockedRetriesSummary" FontSize="12" Foreground="#999"
                                   Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boutons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Width="160" Click="RefreshBlockedRetries_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Width="200" Click="ClearBlockedRetries_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Vider la liste" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Filtres -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                        <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                        <TextBox x:Name="txtRetriesSearch" Width="280" Margin="0,0,15,0"
                                 Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                 VerticalContentAlignment="Center"
                                 TextChanged="RetriesFilter_Changed"/>

                        <TextBlock x:Name="lblRetriesFilterCount" VerticalAlignment="Center"
                                   Foreground="#888" FontSize="11" Text=""/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid x:Name="BlockedRetriesGrid" Grid.Row="3"
                              RowHeight="28"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding Ip}" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Détecteur initial'}" Binding="{Binding OriginalDetector}" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Bloquée le'}" Binding="{Binding BlockedAtText}" SortMemberPath="BlockedAt" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr '1ʳᵉ tentative'}" Binding="{Binding FirstRetryAtText}" SortMemberPath="FirstRetryAt" Width="150"/>
                            <DataGridTextColumn Header="{loc:Tr 'Dernière tentative'}" Binding="{Binding LastRetryAtText}" SortMemberPath="LastRetryAt" Width="150"/>

                            <!-- Colonne Info (bouton ℹ par ligne) -->
                            <DataGridTemplateColumn Width="45" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="LookupIp_Click"
                                                Tag="{Binding Ip}"
                                                Width="22" Height="22"
                                                Style="{StaticResource InfoButtonStyle}"
                                                ToolTip="Voir les informations sur cette IP"
                                                Content="i"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Colonne Tentatives (badge coloré) -->
                            <DataGridTemplateColumn Header="{loc:Tr 'Tentatives'}" SortMemberPath="RetryCount" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" MinWidth="28">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                            <Setter Property="Background" Value="#2a5a8c"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                            <Setter Property="Background" Value="#1a7acc"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                            <Setter Property="Background" Value="#4CC2FF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding RetryCount}" Foreground="White"
                                                       FontWeight="Bold" FontSize="11"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ====================================================== -->
            <!--  ONGLET HISTORIQUE (intrusions + audit whitelist)      -->
            <!-- ====================================================== -->
