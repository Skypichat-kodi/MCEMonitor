<Window x:Class="NetMonitor.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        xmlns:controls="clr-namespace:NetMonitor.UI.Controls"
        Title="NetMonitor"
        Height="850"
        Width="1500"
        MinHeight="550"
        MinWidth="900"
        WindowStyle="None"
        ResizeMode="CanResize">

    <!-- Barre de titre personnalisée : la barre Windows est supprimée, les boutons
         Réduire / Agrandir / Fermer sont recréés dans l'en-tête (voir plus bas).
         Pas d'AllowsTransparency : il empêcherait le redimensionnement. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Couleur systeme de selection : le template par defaut de DataGridRow
             peint les lignes selectionnees avec SystemColors.HighlightBrush, qui
             gagne sur les setters de style. On la ramene a un gris discret. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3A40"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#33333A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F0F0F0"/>

        <!-- En-tetes des tableaux de l'onglet Intrusions : rouge sombre mat,
             texte clair et separateurs discrets (pas de saumon). -->
        <Style x:Key="EntetesIntrusion" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Background" Value="#3A1A1A"/>
            <Setter Property="Foreground" Value="#F0E0E0"/>
            <Setter Property="BorderBrush" Value="#555555"/>   <!-- trait gris des cellules d'en-tete -->
            <Setter Property="BorderThickness" Value="0,1,1,1"/>   <!-- un seul trait par frontiere (pas de doublon) -->
            <Setter Property="Padding" Value="6,6"/>   <!-- bandeau d'en-tete : 29 px au lieu de 17 -->
        </Style>

        <!-- Cellules des tableaux de l'onglet Intrusions. Le style global des
             cellules peint un fond opaque qui masquerait celui de la ligne :
             la teinte doit donc etre portee ici. -->
        <Style x:Key="CellulesIntrusion" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#241717"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3D2424"/>
                </Trigger>
                <!-- Tableau sans focus : la selection ne doit plus se voir -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#241717"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cellules de l'onglet Interceptions : meme principe que CellulesIntrusion,
             la teinte doit etre portee par la cellule car le style global peint
             un fond opaque qui masquerait celui de la ligne. -->
        <Style x:Key="CellulesInterception" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#0E1D2B"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A3A52"/>
                </Trigger>
                <!-- Tableau sans focus : la selection ne doit plus se voir -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#0E1D2B"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lignes des tableaux de l'onglet Intrusions : rouge tres discret,
             juste de quoi rappeler le contexte sans peser sur la lecture. -->
        <Style x:Key="LignesIntrusion" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="#1E1414"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Background" Value="#241818"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E1E1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="Win11Background" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Win11Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Win11Border" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="Win11Text" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="Win11Accent" Color="#4CC2FF"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#553A8DFF"/>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <TextBlock x:Name="SortArrow"
                                               Grid.Column="1"
                                               Text=""
                                               FontSize="9"
                                               Foreground="#4CC2FF"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Grippers pour le resize des colonnes -->
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Width="8"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   Opacity="0"/>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="8"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SortDirection" Value="{x:Null}">
                                <Setter TargetName="SortArrow" Property="Text" Value="⇅"/>
                                <Setter TargetName="SortArrow" Property="Foreground" Value="#555555"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                                <Setter TargetName="SortArrow" Property="Foreground" Value="#4CC2FF"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                                <Setter TargetName="SortArrow" Property="Foreground" Value="#4CC2FF"/>
                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 1 1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>   <!-- pas de contour noir sur la cellule cliquee -->

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <!-- Tableau sans focus : la selection ne doit plus se voir -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#1E1E1E"/>
                    <Setter Property="Foreground" Value="#E5E5E5"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <!-- Template maison : celui du theme peint la selection et le contour de
                 focus avec les couleurs systeme, sans qu on puisse l empecher. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A3D"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Couleurs pour les pastilles des checkboxes -->
        <SolidColorBrush x:Key="DotCritical" Color="#FF6347"/>
        <SolidColorBrush x:Key="DotWarning"  Color="#FFB900"/>
        <SolidColorBrush x:Key="DotSubnet"   Color="#6CCB5F"/>
        <SolidColorBrush x:Key="DotBot"      Color="#5BC0EB"/>
        <SolidColorBrush x:Key="DotCrawler"  Color="#1E88E5"/>

        <!-- Style de CheckBox avec une pastille colorée -->
        <Style x:Key="ColoredCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <!-- Pastille (dot) -->
                            <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="OuterRing" Width="16" Height="16"
                                         StrokeThickness="2"
                                         Stroke="{TemplateBinding Tag}"
                                         Fill="Transparent"/>
                                <Ellipse x:Name="InnerDot" Width="8" Height="8"
                                         Fill="{TemplateBinding Tag}"
                                         Visibility="Collapsed"/>
                            </Grid>
                            <!-- Texte -->
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="#252526"
                                BorderBrush="#3C3C3C"
                                BorderThickness="0,0,0,2"
                                Padding="18,10">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2D30"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <DataTemplate x:Key="SeverityBadgeTemplate">
            <Border CornerRadius="8" Padding="7,2" MinWidth="58"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    ToolTip="{Binding ManualSeverityTooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#555"/>
                        <Style.Triggers>
                            <!-- 9 catégories -->
                            <DataTrigger Binding="{Binding Severity}" Value="Whitelist">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Whitelisted">
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Safe">
                                <Setter Property="Background" Value="#6CCB5F"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Bot">
                                <Setter Property="Background" Value="#5BC0EB"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Crawler">
                                <Setter Property="Background" Value="#1E88E5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Trusted">
                                <Setter Property="Background" Value="#FDD835"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="ToCheck">
                                <Setter Property="Background" Value="#E91E63"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Background" Value="#FFB900"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                                <Setter Property="Background" Value="#FFB900"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="High">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasManualSeverity}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding BadgeText}" FontWeight="Bold" FontSize="11"
                               TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="High">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Whitelisted">
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Whitelist">
                                        <Setter Property="Foreground" Value="Black"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Crawler">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="ToCheck">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OriginBadgeTemplate">
            <Border CornerRadius="8" Padding="7,2" MinWidth="68"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="#3C3C3C"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Origin}" Value="Scanner">
                                <Setter Property="Background" Value="#A855F7"/>
                                <Setter Property="BorderBrush" Value="#A855F7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Origin}" Value="Crawler">
                                <Setter Property="Background" Value="#1E88E5"/>
                                <Setter Property="BorderBrush" Value="#1E88E5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Origin}" Value="Bot">
                                <Setter Property="Background" Value="#5BC0EB"/>
                                <Setter Property="BorderBrush" Value="#5BC0EB"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Origin}" Value="Microsoft">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Origin}" Value="Blacklist">
                                <Setter Property="Background" Value="#8B0000"/>
                                <Setter Property="BorderBrush" Value="#8B0000"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Origin}" Value="Whitelist">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontWeight="Bold" FontSize="11"
                           TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="—"/>
                            <Setter Property="Foreground" Value="#555"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Origin}" Value="Scanner">
                                    <Setter Property="Text" Value="Scanner"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Crawler">
                                    <Setter Property="Text" Value="Crawler"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Bot">
                                    <Setter Property="Text" Value="Bot"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Microsoft">
                                    <Setter Property="Text" Value="Microsoft"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Blacklist">
                                    <Setter Property="Text" Value="Blacklist"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Whitelist">
                                    <Setter Property="Text" Value="Whitelist"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="VerticalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="FontSize" Value="13"/>
            <!-- Rend le fond du DataGrid cliquable (pour PreviewMouseLeftButtonDown) -->
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#4A4A4D"
                                CornerRadius="4"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#5A5A5E"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#4CC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="0" Width="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinHorizontalScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  ComboBox sombre (cohérent avec MediaMonitor UI)              -->
        <!-- ============================================================ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#1E1E1E"
                                                BorderBrush="#3C3C3C"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#E5E5E5"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CC2FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#252526"
                                            BorderBrush="#3C3C3C"
                                            BorderThickness="1"
                                            CornerRadius="4"/>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  ComboBoxItem sombre                                          -->
        <!-- ============================================================ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!--  CheckBox sombre                                              -->
        <!-- ============================================================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ============================================================ -->
        <!--  Bouton "i" rond pour les colonnes Info                       -->
        <!-- ============================================================ -->
        <Style x:Key="InfoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#4CC2FF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4CC2FF"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#4CC2FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TrafficDirectionTemplate">
            <TextBlock FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip="{Binding TrafficDirectionTooltip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- Par défaut : entrant (▼, bleu) -->
                        <Setter Property="Text" Value="▼"/>
                        <Setter Property="Foreground" Value="#4CC2FF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                <!-- Sortant (▲, ambre) -->
                                <Setter Property="Text" Value="▲"/>
                                <Setter Property="Foreground" Value="#FFB900"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Fill="#1E1E1E" Grid.RowSpan="3"/>

        <Rectangle Grid.RowSpan="3">
            <Rectangle.Fill>
                <ImageBrush ImageSource="Resources/Images/UI-background.png" Stretch="Fill"/>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Fill="#1E1E1E" Grid.RowSpan="3" Opacity="0.83"/>

        <!-- Background="Transparent" est indispensable : une grille sans arrière-plan
             n'est pas cliquable dans ses zones vides, donc seul le titre répondrait
             à la souris et la fenêtre ne se déplacerait que par le coin haut-gauche.
             Transparent ne change aucune couleur visible. -->
        <Grid Grid.Row="0" Margin="15,12,15,8" Background="Transparent" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="NetMonitor" FontSize="20" FontWeight="Bold"
                           Foreground="#4CC2FF" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button
                    x:Name="btnOpenWebTop"
                    Style="{StaticResource BoutonTitre}"
                    Height="30"
                    Padding="15,0"
                    VerticalContentAlignment="Center"
                    Click="btnOpenWeb_Click"
                    ToolTip="{loc:Tr 'Ouvrir la page Web dans le navigateur'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Ouvrir la page Web'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Boutons de la barre de titre personnalisée.
                     Ils héritent du style Button implicite de la fenêtre :
                     aucune couleur ni style n'est redéfini ici. -->
                <Button Style="{StaticResource BoutonTitre}" x:Name="btnTitleMinimize" Content="—" Width="34" Height="30" Padding="0"
                        Margin="8,0,0,0" Click="TitleBarMinimize_Click"
                        ToolTip="{loc:Tr 'Réduire'}"/>
                <Button Style="{StaticResource BoutonTitre}" x:Name="btnTitleMaximize" Content="□" Width="34" Height="30" Padding="0"
                        Margin="4,0,0,0" Click="TitleBarMaximize_Click"
                        ToolTip="{loc:Tr 'Agrandir'}"/>
                <Button Style="{StaticResource BoutonTitre}" x:Name="btnTitleClose" Content="✕" Width="34" Height="30" Padding="0"
                        Margin="4,0,0,0" Click="TitleBarClose_Click"
                        ToolTip="{loc:Tr 'Fermer'}"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabControl" Grid.Row="1"
                    Margin="15,8,15,0" Background="Transparent" BorderThickness="0"
                    Padding="0,6,0,0">

            <!-- ====================================================== -->
            <!--  ONGLET INTRUSIONS (3 tableaux)                        -->
            <!-- ====================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr 'Intrusions'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <!-- Barre verticale masquee (Hidden) : le defilement a la molette reste actif
                     via DataGrid_PreviewMouseWheel, mais la barre ne rogne plus ~22 px
                     de largeur sur les trois tableaux. -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <StackPanel Margin="0,10,0,0">

                        <!-- Tableau 1 : intrusions actives -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#FFB900" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Intrusions détectées'}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="160" Margin="0,0,10,0" Click="BlockSelected_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#CC3300"/>
                                        <Setter Property="BorderBrush" Value="#FF6347"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E64D1A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Net.BlockIp'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="160" Click="Refresh_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Actualiser'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="160" Click="ClearActive_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Vider la liste'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="160" Click="OpenLogs_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Ouvrir les logs'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="160" Click="ExportPdf_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Exporter PDF'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Sévérité :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <ComboBox x:Name="cmbActiveSeverity" Width="120" Margin="0,0,15,0"
                                      SelectionChanged="ActiveFilter_Changed">
                                <ComboBoxItem Content="{loc:Tr 'Toutes'}"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>

                            <TextBlock Text="{loc:Tr 'Recherche :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
                            <TextBox x:Name="txtActiveSearch" Width="220" Margin="0,0,15,0"
                                     Background="#1E1E1E" Foreground="#E5E5E5" BorderBrush="#3C3C3C"
                                     VerticalContentAlignment="Center"
                                     TextChanged="ActiveFilter_Changed"/>

                            <TextBlock x:Name="lblActiveFilterCount" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Text=""/>
                        </StackPanel>

                        <DataGrid x:Name="ActiveIntrusionsGrid" ColumnHeaderStyle="{StaticResource EntetesIntrusion}" CellStyle="{StaticResource CellulesIntrusion}" RowStyle="{StaticResource LignesIntrusion}"
                                  RowHeight="28"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                  Margin="0,0,0,0">
                            
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Tr 'Sens'}" SortMemberPath="IsOutbound" Width="60" CanUserResize="False" CellTemplate="{StaticResource TrafficDirectionTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Dernière'}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeen" Width="140"/>
                                
                                <!-- COLONNE TENTATIVES DEPLACEE ICI -->
                                <DataGridTemplateColumn Header="{loc:Tr 'Tentatives'}" SortMemberPath="Count" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="9" Padding="8,0" Height="18" MinWidth="30"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#b71c1c"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c2">
                                                                <Setter Property="Background" Value="#8b0000"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c5">
                                                                <Setter Property="Background" Value="#5a0000"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CountClass}" Value="c10">
                                                                <Setter Property="Background" Value="#2a0000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Count}" Foreground="White" VerticalAlignment="Center"
                                                           FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                
                                <DataGridTemplateColumn Header="{loc:Tr 'Sévérité'}" SortMemberPath="Severity" Width="150">                                
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SeverityBadgeTemplate}"/>
                                                <Button Content="{loc:Tr 'Safe ?'}" Margin="6,0,0,0" Padding="8,3" FontSize="11"
                                                        MinWidth="52" MinHeight="22"
                                                        Click="MarkSafe_Click" Tag="{Binding RemoteIp}"
                                                        ToolTip="{loc:Tr 'Marquer comme Safe (liste Microsoft vérifiée)'}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Background" Value="#3A7A33"/>
                                                            <Setter Property="BorderBrush" Value="#6CCB5F"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="ToCheck">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#4A9A40"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr 'Origine'}" SortMemberPath="Origin" Width="100" CellTemplate="{StaticResource OriginBadgeTemplate}"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détecteur'}" Binding="{Binding Detectors}" Width="120"/>
                                <DataGridTextColumn Header="{loc:Tr 'IP'}" Binding="{Binding RemoteIp}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding ReverseDnsDisplay}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Pays'}" Binding="{Binding CountryDisplay}" SortMemberPath="Country" Width="130"/>
                                <DataGridTextColumn Header="{loc:Tr 'FAI (ASN)'}" Binding="{Binding IspDisplay}" SortMemberPath="Isp" Width="150"/>
                                <DataGridTextColumn Header="{loc:Tr 'Organisation'}" Binding="{Binding OrgDisplay}" SortMemberPath="Org" Width="150"/>
                                <DataGridTemplateColumn Width="45" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="LookupIp_Click" Tag="{Binding RemoteIp}"
                                                    Width="22" Height="22"
                                                    ToolTip="{loc:Tr 'Voir les informations sur cette IP'}"
                                                    Content="i">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource InfoButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RemoteIp}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr 'Ports distants'}" Binding="{Binding RemotePortsDisplay}" SortMemberPath="RemotePortsDisplay" Width="110"/>
                                <DataGridTextColumn Header="{loc:Tr 'Détails'}" Binding="{Binding DetailsDisplay}" SortMemberPath="Details" Width="*" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="panelActiveMore" Orientation="Horizontal"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Visibility="Collapsed">
                            <Button Click="ToggleActiveMore_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="8,2" Cursor="Hand"
                                    ToolTip="{loc:Tr 'Afficher toutes les lignes'}">
                                <TextBlock x:Name="txtActiveMoreLabel" Text="▼ 12 / 0"
                                           Foreground="#4CC2FF" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <!-- Tableau 1bis : processus en attente d'examen -->
                        <StackPanel Orientation="Horizontal" Margin="0,25,0,8">
                            <TextBlock Text="🔍" FontSize="16" Margin="0,0,8,0"
                                       Foreground="#4CC2FF" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Net.PendingProcesses'}" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#4CC2FF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Width="220" Margin="0,0,10,0" Click="BlockSelectedProcess_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#CC3300"/>
                                        <Setter Property="BorderBrush" Value="#FF6347"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E64D1A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚫" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Bloquer le processus'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="240" Click="WhitelistSelectedProcess_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#3A7A33"/>
                                        <Setter Property="BorderBrush" Value="#6CCB5F"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4A9A40"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Ajouter à la liste blanche'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Width="160" Click="DismissPendingProcess_Click" Margin="10,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="#4A4A4D"/>
                                        <Setter Property="BorderBrush" Value="#6A6A6D"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5A5A5E"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✖" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#E5E5E5"/>
                                    <TextBlock Text="{loc:Tr 'Retirer de la liste'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>                            
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{loc:Tr 'Sévérité :'}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#B4B4B4" FontSize="12"/>
