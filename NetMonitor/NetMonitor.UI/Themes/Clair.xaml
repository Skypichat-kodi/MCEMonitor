<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème clair de NetMonitor.UI, dans l'esprit de Windows 11.
         Mêmes clés que Sombre.xaml.

         Les teintes de tableaux deviennent des pastels : rosé pour les intrusions,
         bleuté pour les interceptions, vert pâle pour l'audit. Elles gardent leur
         rôle d'identification sans assombrir la fenêtre. -->
    <SolidColorBrush x:Key="Fond"              Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Surface"           Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceEntete"     Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="SurfaceSurvol"     Color="#FFE9E9E9" />
    <SolidColorBrush x:Key="SurfaceActive"     Color="#FFDEDEDE" />
    <SolidColorBrush x:Key="Bordure"           Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="Texte"             Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="TexteSecondaire"   Color="#FF5F5F5F" />
    <SolidColorBrush x:Key="TexteTernaire"     Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="Accent"            Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="AccentBascule"     Color="#FF7EB6E8" />
    <SolidColorBrush x:Key="PanelBackground"   Color="#333A8DFF" />

    <SolidColorBrush x:Key="TeinteIntrusion"   Color="#FFF7EFEF" />
    <SolidColorBrush x:Key="TeinteInterception" Color="#FFEFF5FB" />
    <SolidColorBrush x:Key="TeinteAudit"       Color="#FFF1F7EC" />

    <!-- Teintes propres à chaque onglet : lignes alternées, en-têtes, sélections -->
    <SolidColorBrush x:Key="EnteteIntrusion" Color="#FFF7E8E8" />
    <SolidColorBrush x:Key="TexteEnteteIntrusion" Color="#FF8A3A3A" />
    <SolidColorBrush x:Key="LigneIntrusionImpaire" Color="#FFFCF7F7" />
    <SolidColorBrush x:Key="LigneIntrusionPaire" Color="#FFF8F0F0" />
    <SolidColorBrush x:Key="SelectionIntrusion" Color="#FFF2DEDE" />
    <SolidColorBrush x:Key="SelectionInterception" Color="#FFDCEBF7" />
    <SolidColorBrush x:Key="LigneAuditImpaire" Color="#FFF7FAF3" />
    <SolidColorBrush x:Key="LigneAuditPaire" Color="#FFF2F7EC" />
    <SolidColorBrush x:Key="EnteteAudit" Color="#FFE6F0DC" />
    <SolidColorBrush x:Key="TexteEnteteAudit" Color="#FF3F6B2E" />
    <SolidColorBrush x:Key="SelectionAudit" Color="#FFDCEBD3" />
    <SolidColorBrush x:Key="BordureAudit" Color="#FFC9DDBB" />
    <SolidColorBrush x:Key="BordureAuditClaire" Color="#FFD5E4C9" />
</ResourceDictionary>
