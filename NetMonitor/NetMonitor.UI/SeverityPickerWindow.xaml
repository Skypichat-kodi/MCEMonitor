<Window x:Class="NetMonitor.UI.SeverityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="{loc:Tr 'Forcer la sévérité (cette IP uniquement)'}"
        Width="420" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E5E5E5"
        WindowStyle="None">

    <!-- Barre de titre personnalisée : ce dialogue n'a pas d'en-tête, on en ajoute
         un (titre + Fermer). ResizeMode reste NoResize : pas de Réduire/Agrandir. -->
    <Window.Resources>
        <!-- Même style de bouton implicite que les MainWindow. Sans lui, les boutons
             de ces dialogues utilisaient le rendu WPF par défaut (gris système),
             ce qui jurait avec le thème sombre de la fenêtre. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E5E5E5"/>
            <Setter Property="Padding" Value="10 5"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3D"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4CC2FF"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Le titre est lié à Window.Title : une seule source de vérité,
             donc rien à traduire deux fois. -->
        <Grid Grid.Row="0" Background="Transparent" Margin="10,6,8,0"
              MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       FontSize="12" Foreground="#B4B4B4" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="1" Content="✕" Width="28" Height="24" Padding="0"
                    Click="TitleBarClose_Click" ToolTip="{loc:Tr 'Fermer'}"/>
        </Grid>

    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0 : IP -->
            <RowDefinition Height="Auto"/> <!-- 1 : Avertissement -->
            <RowDefinition Height="*"/>    <!-- 2 : Choix -->
            <RowDefinition Height="Auto"/> <!-- 3 : Boutons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="IpText" Grid.Row="0"
                   FontSize="14" FontWeight="Bold" Foreground="#4CC2FF"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="{loc:Tr 'Cette action modifie uniquement cette IP...'}"
                   FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,15"/>

        <!-- Les 5 options + auto -->
        <StackPanel Grid.Row="2">
            <RadioButton x:Name="RbCritical" GroupName="Sev" Tag="Critical"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FF6347"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Critical" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — Danger immédiat'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbWarning" GroupName="Sev" Tag="Warning"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FFB900"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Warning" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — À vérifier'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- ToCheck (magenta) -->
            <RadioButton x:Name="RbToCheck" GroupName="Sev" Tag="ToCheck"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#E91E63"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="ToCheck" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — En attente de vérification'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- Crawler (bleu foncé) -->
            <RadioButton x:Name="RbCrawler" GroupName="Sev" Tag="Crawler"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#1E88E5"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Crawler" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr 'Net.RobotExplorationGeneric'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <!-- Bot (bleu clair) -->
            <RadioButton x:Name="RbBot" GroupName="Sev" Tag="Bot"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#5BC0EB"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Bot" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — Robot officiel (Googlebot...)'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbSafe" GroupName="Sev" Tag="Safe"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#6CCB5F"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Safe" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — Légitime connu'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbTrusted" GroupName="Sev" Tag="Trusted"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#4CAF50"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Trusted" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — Scanner de recherche'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbWhitelisted" GroupName="Sev" Tag="Whitelisted"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#2E7D32"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Whitelisted" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr ' — Ma whitelist'}" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <Separator Margin="0,12,0,8" Background="#3C3C3C"/>

            <RadioButton x:Name="RbAuto" GroupName="Sev" Tag="auto"
                         Margin="0,4" Foreground="#4CC2FF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr 'Net.RevertToAuto'}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Tr 'Annuler'}" Width="100" Height="30"
                    Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="{loc:Tr 'Appliquer'}" Width="100" Height="30"
                    IsDefault="True" Click="OnApply"/>
        </StackPanel>
    </Grid>
    </Grid>
</Window>