<Window x:Class="NetMonitor.UI.SeverityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changer la sévérité"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E5E5E5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IP concernée -->
        <TextBlock x:Name="IpText" Grid.Row="0"
                   FontSize="14" FontWeight="Bold" Foreground="#4CC2FF"
                   Margin="0,0,0,20"/>

        <!-- Les 5 options + auto -->
        <StackPanel Grid.Row="1">
            <RadioButton x:Name="RbCritical" GroupName="Sev" Tag="Critical"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FF6347"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Critical" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Danger immédiat" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbWarning" GroupName="Sev" Tag="Warning"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#FFB900"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Warning" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — À vérifier" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbSafe" GroupName="Sev" Tag="Safe"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#6CCB5F"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Safe" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Légitime connu" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbTrusted" GroupName="Sev" Tag="Trusted"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#4CAF50"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Trusted" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Scanner de recherche" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbWhitelisted" GroupName="Sev" Tag="Whitelisted"
                         Margin="0,4" Foreground="#E5E5E5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="16" Height="16" Background="#2E7D32"
                            CornerRadius="3" Margin="0,0,10,0"/>
                    <TextBlock Text="Whitelisted" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" — Ma whitelist" FontSize="11" Opacity="0.7"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>

            <Separator Margin="0,12,0,8" Background="#3C3C3C"/>

            <RadioButton x:Name="RbAuto" GroupName="Sev" Tag="auto"
                         Margin="0,4" Foreground="#4CC2FF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Revenir à l'évaluation automatique"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuler" Width="100" Height="30"
                    Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Appliquer" Width="100" Height="30"
                    IsDefault="True" Click="OnApply"/>
        </StackPanel>
    </Grid>
</Window>