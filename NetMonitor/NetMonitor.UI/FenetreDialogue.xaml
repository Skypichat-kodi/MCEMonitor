<Window x:Class="NetMonitor.UI.FenetreDialogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MCEMonitor.Languages;assembly=MCEMonitor.Languages"
        Title="NetMonitor"
        Width="540"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- Boîte de dialogue du module, copiée depuis celle de MCEMonitor.
         Elle porte ses propres styles de boutons : les modules sont
         indépendants, aucun partage de ressources. -->
    <Window.Resources>
        <Style x:Key="BoutonBoite" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush"
                                        Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonBoiteAccent" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Accent}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BoutonBoiteFermer" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background"
                                        Value="{StaticResource SurfaceSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource Fond}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
                <Grid Margin="20,12,10,12">
                    <TextBlock x:Name="TexteTitre"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />

                    <Button Content="✕"
                            Style="{StaticResource BoutonBoiteFermer}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="{loc:Tr 'Fermer'}"
                            Click="SurFermer" />
                </Grid>
            </Border>

            <!-- Message -->
            <Grid Grid.Row="1" Margin="20,18,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Icone"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="22"
                           VerticalAlignment="Top"
                           Margin="0,0,14,0"
                           Text="&#xE946;" />

                <TextBlock x:Name="TexteMessage"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Boutons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,20,20,18">
                <Button x:Name="BoutonNon"
                        Style="{StaticResource BoutonBoite}"
                        Width="130" Height="32"
                        Padding="0"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="SurNon" />
                <Button x:Name="BoutonOui"
                        Style="{StaticResource BoutonBoiteAccent}"
                        Width="130" Height="32"
                        Padding="0"
                        Click="SurOui" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
