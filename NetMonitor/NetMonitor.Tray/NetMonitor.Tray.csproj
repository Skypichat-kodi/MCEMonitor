<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <AssemblyName>NetMonitor.Tray</AssemblyName>
    <RootNamespace>NetMonitor.Tray</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>NetMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Windows.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!-- On empêche le SDK d'inclure implicitement les ressources -->
  <ItemGroup>
    <None Remove="*.ico" />
    <None Remove="*.png" />
    <None Remove="*.wav" />
  </ItemGroup>

  <!-- On les embarque dans l'assembly -->
  <ItemGroup>
    <EmbeddedResource Include="NetMonitor.ico" LogicalName="NetMonitor.ico" />
    <EmbeddedResource Include="critical.png"   LogicalName="critical.png" />
    <EmbeddedResource Include="warning.png"    LogicalName="warning.png" />
    <EmbeddedResource Include="shield.png"     LogicalName="shield.png" />
    <EmbeddedResource Include="alarm.wav"      LogicalName="alarm.wav" />
    <EmbeddedResource Include="warning.wav"    LogicalName="warning.wav" />
  </ItemGroup>

</Project>